local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Path to the frame to delete repeatedly
local framePath = {"InteractionsApp", "ChoiceSelects"}

local function findInstanceByPath(parent, pathTable, timeout)
    local current = parent
    for _, part in ipairs(pathTable) do
        print("Looking for:", part)
        local success, result = pcall(function()
            return current:WaitForChild(part, timeout)
        end)
        if success and result then
            current = result
            print("Found:", current:GetFullName())
        else
            warn("Could not find: " .. part)
            return nil
        end
    end
    return current
end

local choiceSelectsFrame = findInstanceByPath(PlayerGui, framePath, 15)

-- Function to find all TapButtons in the entire PlayerGui hierarchy
local function findAllTapButtons()
    local tapButtons = {}
    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj.Name == "TapButton" and obj:IsA("GuiObject") then
            table.insert(tapButtons, obj)
        end
    end
    return tapButtons
end

local function clickButtonAlt(button)
    if not (button and button.Parent) then
        print("Button invalid or no parent.")
        return
    end
    print("Clicking:", button:GetFullName())

    if typeof(button) == "Instance" and button:IsA("TextButton") then
        print("Using :Activate()")
        pcall(function()
            button:Activate()
        end)
        return
    elseif typeof(button) == "Instance" and button:FindFirstChild("Activated") then
        print("Firing :Activated")
        pcall(function()
            button.Activated:Fire()
        end)
        return
    end

    -- fallback to firing mouse events
    local success, err = pcall(function()
        for _, conn in pairs(getconnections(button.MouseButton1Down) or {}) do
            conn:Fire()
        end
        wait(0.05)
        for _, conn in pairs(getconnections(button.MouseButton1Click) or {}) do
            conn:Fire()
        end
        wait(0.05)
        for _, conn in pairs(getconnections(button.MouseButton1Up) or {}) do
            conn:Fire()
        end
        print("Fired mouse events")
    end)
    if not success then
        print("Error firing events:", err)
    end
end

while true do
    -- Destroy the frame if it exists
    if choiceSelectsFrame and choiceSelectsFrame.Parent then
        choiceSelectsFrame:Destroy()
        print("Destroyed ChoiceSelects frame.")
        choiceSelectsFrame = nil -- prevent repeated attempts
    end

    -- Find all TapButtons dynamically
    local tapButtons = findAllTapButtons()

    -- Click each one
    for _, btn in ipairs(tapButtons) do
        if btn and btn.Parent then
            clickButtonAlt(btn)
        end
    end

    wait(0.5)
end
