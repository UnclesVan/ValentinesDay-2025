-- Function to load an interior
local function loadInterior(interiorName)
    -- Prevent loading VIP if already visited
    if hasVisitedVIP and interiorName ~= "VIP" then
        print("🚫 Preventing loading of any interiors after VIP has been visited.")
        return
    end

    print("✅ Loading Interior: " .. interiorName)
    deleteModel()

    local args = {"Interiors", interiorName}
    local downloadAPI = replicatedStorage:FindFirstChild("API"):FindFirstChild("DownloadsAPI/Download")

    if downloadAPI then
        local success, errorMessage = pcall(function()
            downloadAPI:InvokeServer(unpack(args))
        end)
        if not success then
            warn("Failed to invoke download API: " .. errorMessage)
            return
        end
    else
        warn("DownloadsAPI/Download not found.")
        return
    end

    wait(1)  -- Delay for the download to complete

    local locationArgs = {interiorName}
    replicatedStorage.API:FindFirstChild("LocationAPI/SetLocation"):FireServer(unpack(locationArgs))
    print("✅ Set location to: " .. interiorName)

    local player = game:GetService("Players").LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()

    local gui = player.PlayerGui:FindFirstChild(interiorName)
    if gui then
        local targetFolder = workspace:FindFirstChild("Interiors")
        if targetFolder then
            local guiClone = gui:Clone()
            guiClone.Parent = targetFolder
            gui:Destroy()
            print("✅ Moved GUI to Interiors folder.")
        else
            warn("Interiors folder not found in workspace.")
        end
    else
        warn(interiorName .. " GUI element not found in PlayerGui.")
    end

    local targetModel = workspace.Interiors:FindFirstChild(interiorName)
    if targetModel then
        -- Check if the interior being loaded is VIP
        if interiorName == "VIP" then
            local hotTubOrigin = workspace.Interiors.VIP:FindFirstChild("HotTubOrigin")  -- Teleportation target

            -- Change the destination_id to "MainMap"
            local configuration = workspace.Interiors.VIP.Doors.MainDoor.WorkingParts.Configuration
            if configuration then
                configuration.destination_id.Value = "MainMap"
                print("✅ Changed destination_id to 'MainMap'.")
            else
                warn("Configuration not found!")
            end
            
            -- Teleport to VIP first
            if hotTubOrigin then
                teleportCharacter(character, hotTubOrigin)
                print("✅ Teleported to VIP at HotTubOrigin.")

                -- Start the timer for VIP
                startTimer(100)  -- Use 100 seconds for VIP timer
                print("⏳ Waiting at VIP for 100 seconds...")
                wait(100)

                -- Now teleport to TouchToEnter
                local touchToEnter = workspace.Interiors.VIP.Doors.MainDoor.WorkingParts:FindFirstChild("TouchToEnter")
                if touchToEnter then
                    teleportCharacter(character, touchToEnter)  -- Teleport to TouchToEnter
                    print("✅ Teleported to TouchToEnter.")

                    -- Track TouchToEnter as visited
                    if not table.find(visitedInteriors, "TouchToEnter") then
                        table.insert(visitedInteriors, "TouchToEnter")  -- Add TouchToEnter to visited list
                        print("✅ Added to visited interiors: TouchToEnter")
                        updateVisitedInteriorsUI()  -- Update UI immediately after adding TouchToEnter
                    end
                    
                    -- Wait at TouchToEnter for an optional duration if necessary
                    print("⏳ Waiting at TouchToEnter...")
                    wait(7)  -- Ensure the player waits at TouchToEnter
                    print("✅ Waiting at TouchToEnter completed. Proceeding to Campsite.")

                    -- Now wait until CampsiteOrigin is available before teleporting to it
                    local campsiteOrigin
                    repeat
                        campsiteOrigin = workspace.StaticMap:FindFirstChild("Campsite") and workspace.StaticMap.Campsite:FindFirstChild("CampsiteOrigin")
                        if not campsiteOrigin then
                            print("⏳ Waiting for Campsite Origin to be available...")
                            wait(1)  -- Wait and check again
                        end
                    until campsiteOrigin

                    -- Now that CampsiteOrigin is found, teleport to it
                    teleportCharacter(character, campsiteOrigin)
                    print("✅ Teleported to Camp.")

                    -- Track the Campsite as visited
                    if not table.find(visitedInteriors, "Campsite") then
                        table.insert(visitedInteriors, "Campsite")  -- Add Campsite to visited list
                        print("✅ Added to visited interiors: Campsite")
                        updateVisitedInteriorsUI()  -- Update the UI immediately after adding Campsite
                    end

                    -- Start timer for Campsite (100 seconds)
                    startTimer(100)
                    print("⏳ Waiting at Campsite for 100 seconds...")
                    wait(100)  -- Now waits for 100 seconds after visiting Campsite
                    print("✅ 100 seconds elapsed at Campsite, proceeding to Park.");

                    -- Teleport to Park
                    teleportCharacter(character, workspace.StaticMap.Park.BoredAilmentTarget)
                    print("✅ Teleported to Park.")

                    -- Track Park as visited
                    if not table.find(visitedInteriors, "Park") then
                        table.insert(visitedInteriors, "Park")  -- Add Park to visited list
                        print("✅ Added to visited interiors: Park")
                        updateVisitedInteriorsUI()  -- Update the UI immediately after adding Park
                    end

                    -- Start timer for Park (100 seconds)
                    startTimer(100)
                    print("⏳ Waiting at Park for 100 seconds...")
                    wait(100)  -- Now waits for 100 seconds after visiting Park
                    print("✅ 100 seconds elapsed at Park, proceeding to Beach Party.");

                    -- Teleport to Beach Party
                    teleportCharacter(character, workspace.StaticMap.Beach.BeachPartyAilmentTarget)
                    print("✅ Teleported to Beach Party.")

                    -- Track Beach Party as visited
                    if not table.find(visitedInteriors, "BeachParty") then
                        table.insert(visitedInteriors, "Beach Party")  -- Add Beach Party to visited list
                        print("✅ Added to visited interiors: Beach Party")
                        updateVisitedInteriorsUI()  -- Update the UI immediately after adding Beach Party
                    end

                    -- Start timer for Beach Party (100 seconds)
                    startTimer(100)
                    print("⏳ Waiting at Beach Party for 100 seconds...")
                    wait(100)  -- Now waits for 100 seconds after visiting Beach Party
                    print("✅ 100 seconds elapsed at Beach Party.")
                else
                    warn("TouchToEnter part not found.")
                end
            else
                warn("HotTubOrigin not found in VIP.")
            end
        else
            local teleportPart = targetModel:FindFirstChild("InteriorOrigin") or targetModel:FindFirstChild("HotTubOrigin")  -- Original behavior for other interiors
            if teleportPart then
                teleportCharacter(character, teleportPart)
                print("✅ Teleported to " .. interiorName .. " at: ", teleportPart.Position)

                -- Track the visited interior
                if not table.find(visitedInteriors, interiorName) then
                    table.insert(visitedInteriors, interiorName)  -- Add name to the visited list
                    print("✅ Added to visited interiors: " .. interiorName)

                    updateVisitedInteriorsUI()  -- Update the UI immediately after adding the interior

                    -- Start timer for the visited area (100 seconds)
                    startTimer(100)
                    print("⏳ Waiting at " .. interiorName .. " for 100 seconds...")
                    wait(100) -- Wait 100 seconds before proceeding to the next interior
                    print("✅ 100 seconds elapsed at " .. interiorName .. ".")
                else
                    print("🚫 " .. interiorName .. " was already visited.")  -- Debug print
                end
            else
                warn("InteriorOrigin or HotTubOrigin not found.")
            end
        end
    else
        warn(interiorName .. " not found in workspace.Interiors.")
    end

    wait(2)  -- Adjust as needed
end

