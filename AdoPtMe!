-- Client-side script (LocalScript in StarterGui or a ScreenGui within PlayerGui)

-- GUI Elements (created dynamically)
local Player = game.Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")
local ba = Instance.new("ScreenGui")
local ca = Instance.new("TextLabel") -- Main Label
local ab = Instance.new("TextLabel") -- Status Label
local afkTimerLabel = Instance.new("TextLabel") -- Timer label

-- Properties
ba.Name = "ba"
ca.Name = "ca"
ab.Name = "ab"
afkTimerLabel.Name = "afkTimerLabel"

-- Parent GUI to PlayerGui instead of CoreGui
ba.Parent = PlayerGui
ba.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Create GUI elements
ca.Parent = ba
ca.Active = true
ca.BackgroundColor3 = Color3.new(0, 0, 0) -- Transparent background
ca.BackgroundTransparency = 1
ca.Position = UDim2.new(0.01, 0, 0.01, 0) -- Top-left position (adjust offset as needed)
ca.Size = UDim2.new(0, 500, 0, 120) -- Larger text size
ca.Font = Enum.Font.SourceSansSemibold
ca.Text = "Anti AFK Script"
ca.TextColor3 = Color3.new(0, 1, 0) -- Green text color
ca.TextSize = 64 -- Larger text size
ca.TextStrokeTransparency = 0
ca.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
ca.TextXAlignment = Enum.TextXAlignment.Left

ab.Parent = ba
ab.BackgroundColor3 = Color3.new(0, 0, 0) -- Transparent background
ab.BackgroundTransparency = 1
ab.Position = UDim2.new(0.01, 0, 0.2, 0) -- Position below the main label
ab.Size = UDim2.new(0, 500, 0, 120) -- Larger size
ab.Font = Enum.Font.ArialBold
ab.Text = "Status: Active"
ab.TextColor3 = Color3.new(0, 1, 0) -- Green text color
ab.TextStrokeTransparency = 0
ab.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
ab.TextSize = 64 -- Increased to 64
ab.TextXAlignment = Enum.TextXAlignment.Left

afkTimerLabel.Parent = ba
afkTimerLabel.BackgroundColor3 = Color3.new(0, 0, 0)
afkTimerLabel.BackgroundTransparency = 1
afkTimerLabel.Position = UDim2.new(0.01, 0, 0.39, 0) -- Below the status label
afkTimerLabel.Size = UDim2.new(0, 500, 0, 120) -- Larger size
afkTimerLabel.Font = Enum.Font.Arial
afkTimerLabel.Text = "Total Time: 0s"
afkTimerLabel.TextColor3 = Color3.new(0, 1, 0) -- Green text color
afkTimerLabel.TextSize = 64 -- All text size now 64
afkTimerLabel.TextStrokeTransparency = 0
afkTimerLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
afkTimerLabel.TextXAlignment = Enum.TextXAlignment.Left

-- Anti-AFK Logic: Uses VirtualUser to simulate input
local VirtualUser = game:GetService("VirtualUser")
local afkTimer = 0

-- Function to update the AFK timer
local function updateAfkTimer()
    while true do
        task.wait(1)
        afkTimer = afkTimer + 1
        afkTimerLabel.Text = "Total Time: " .. afkTimer .. "s"
    end
end

-- Start the timer loop in a separate thread
coroutine.wrap(updateAfkTimer)()

local function onIdled()
    -- Simulate clicking the second mouse button (right-click)
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())

    ab.Text = "Roblox tried to kick you but I kicked him instead"
    task.wait(2)
    ab.Text = "Status: Active"
end

-- Connect the Idled event to the anti-AFK function
Player.Idled:Connect(onIdled)

print("Anti AFK has been enabled.")

-- Create the Fluent UI if it doesn't exist
local ValentinesEvent, ValentinesEventTeleport, TeleportSpeed -- Placeholders

-- Check if the Fluent UI is already loaded
if _G.FluentLoaded then  -- Use a global flag
    local Fluent = _G.Fluent
    local SaveManager = _G.SaveManager
    local InterfaceManager = _G.InterfaceManager
    local Window = _G.FluentWindow
    createFloatingButton() -- Function needs to be defined later
else
    -- Fluent UI doesn't exist, load everything
    local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
    local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
    local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()
    _G.Fluent = Fluent
    _G.SaveManager = SaveManager
    _G.InterfaceManager = InterfaceManager
    
    -- Create Main UI Window
    local Window = Fluent:CreateWindow({
        Title = "Fluent " .. Fluent.Version,
        SubTitle = "by dawid",
        TabWidth = 160,
        Size = UDim2.fromOffset(580, 460),
        Acrylic = true,
        Theme = "Dark",
        MinimizeKey = Enum.KeyCode.LeftControl
    })
    _G.FluentWindow = Window

    -- Create Tabs
    local Tabs = {
        Main = Window:AddTab({ Title = "Main", Icon = "" }),
        Settings = Window:AddTab({ Title = "Settings", Icon = "settings" }),
        ValentinesTeleports = Window:AddTab({ Title = "Teleports", Icon = "map" }), 
    }

    -- Local Variables
    local teleportSpeed = 1 -- Initial teleport speed (seconds between teleports)
    local stopTeleportFlag = { Value = false }  -- Table to hold the flag so it can be modified by reference

    -- Function to teleport to Cupid
    local function teleportToCupid()
        if not ValentinesEvent or not ValentinesEvent.IsToggled then return end

        for _,v in pairs(workspace.StaticMap.Valentines2025.Cupid:GetDescendants()) do
            if v.Name == "CupidClient" or v.Name == "CupidServer" then
                local character = Player.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = v.CFrame
                    task.wait(teleportSpeed)
                end
            end
        end
    end

    -- Function to toggle the teleportation
    local function toggleTeleportation()
        if not ValentinesEvent or not Player.PlayerGui:FindFirstChild("HintApp") then return end

        local LargeTextLabel = Player.PlayerGui.HintApp:FindFirstChild("LargeTextLabel")
        if not LargeTextLabel then return end
        
        if ValentinesEvent.IsToggled then
            LargeTextLabel.Text = "You Are Currently In a Valentines Event."
        else
            LargeTextLabel.Text = "You Are Not in a Valentines Event."
        end
    end

    -- Function to teleport to locations
    local function teleportToLocations(stopFlag)
        while true do
            if stopFlag and stopFlag.Value then break end

            -- Teleport to various locations (e.g., roses, hearts)
            for _, v in pairs(workspace.StaticMap.Valentines2025:GetDescendants()) do
                if v:IsA("BasePart") and v.Name == "Collider" then
                    local character = Player.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        character.HumanoidRootPart.CFrame = v.CFrame
                        task.wait(teleportSpeed)
                    else
                        warn("Character or HumanoidRootPart not found.")
                    end
                end
            end

            teleportToCupid() -- Teleport to Cupid frequently

            task.wait(teleportSpeed)
        end
    end
    
    -- Teleport Toggle
    local ValentinesTeleportToggle = Tabs.ValentinesTeleports:AddToggle("ValentinesTeleportToggle", {
        Title = "Teleport to Valentines Locations",
        Default = false,
        Description = "Teleports to various Valentine-themed locations."
    })

    ValentinesTeleportToggle:OnChanged(function(state)
        if state then
            stopTeleportFlag.Value = false
            task.spawn(teleportToLocations, stopTeleportFlag)
        else
            stopTeleportFlag.Value = true -- Signal to stop
        end
    end)

    -- Teleport Speed Slider
    Tabs.ValentinesTeleports:AddSlider("TeleportSpeedSlider", {
        Title = "Teleport Speed",
        Description = "Adjust the speed of the teleports (lower value = faster).",
        Default = 1,
        Min = 0.1,
        Max = 5,
        Rounding = 0.1,
        Callback = function(value)
            teleportSpeed = value
        end
    })

    -- Remove Background Objects Functionality
    local function removeBackgroundObjects()
        while true do
            task.wait(1)

            local objectsToRemove = {
                "Trampolines", "Seesaw", "SwingSets", "Nursery", "Roundabout"
            }
            for _, objectName in ipairs(objectsToRemove) do
                pcall(function()
                    for _, v in pairs(workspace.StaticMap.Park:GetChildren()) do
                        if v.Name == objectName then
                            v:Destroy()
                        end
                    end
                end)
            end
        end
    end

    -- Start removing background objects
    task.spawn(removeBackgroundObjects)

    -- Floating Button Creation
    local function createFloatingButton()
        local buttonSize = UDim2.new(0, 40, 0, 40)
        local button = Instance.new("ImageButton")
        button.Parent = PlayerGui
        button.Size = buttonSize
        button.Position = UDim2.new(0.5, -20, 0, 50)
        button.AnchorPoint = Vector2.new(0.5, 0)
        button.Image = "rbxasset://textures/ui/LuaIcon.png"
        button.ImageTransparency = 0.2
        button.ImageColor3 = Color3.new(1, 1, 1)
        button.BorderSizePixel = 0

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = button

        -- Handle button click to show/hide the UI
        button.MouseButton1Down:Connect(function()
            Window:SetVisible(not Window:IsVisible())
        end)

        return button
    end

    createFloatingButton()

    -- Function to set up functionality for minimizing
    if Window.Minimized then
        Window.Minimized:Connect(function() floatingButton.Visible = true end)
    end
    if Window.Unminimized then
        Window.Unminimized:Connect(function() floatingButton.Visible = false end)
    end

    -- Hand the library over to managers
    SaveManager:SetLibrary(Fluent)
    InterfaceManager:SetLibrary(Fluent)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})
    InterfaceManager:SetFolder("FluentScriptHub")
    SaveManager:SetFolder("FluentScriptHub/specific-game")
    InterfaceManager:BuildInterfaceSection(Tabs.Settings)
    SaveManager:BuildConfigSection(Tabs.Settings)

    Window:SelectTab(1) -- Select the first tab

    -- Valentines Event Toggle
    local ValentinesEventToggle = Tabs.Main:AddToggle("ValentinesEventToggle", {
        Title = "Valentines Event",
        Default = false,
        Description = "Toggles Valentines Event."
    })

    ValentinesEventToggle:OnChanged(function(state)
        ValentinesEvent = { IsToggled = state }
        toggleTeleportation()
    end)

    -- Notify user
    Fluent:Notify({
        Title = "Fluent",
        Content = "The script has been loaded.",
        Duration = 8
    })

    SaveManager:LoadAutoloadConfig()
    _G.FluentLoaded = true
end
