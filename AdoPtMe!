-- Function to refresh the list of buttons based on the game's Ailment UI
local function refreshIDList()
    -- print("Starting refreshIDList (scanning game UI)...") -- Commented out to reduce spam
    if not idDisplayScroller then
        warn("idDisplayScroller is nil. Cannot refresh list.")
        return
    end

    local currentAilmentImageIds = findAilmentIcons() -- Get active IDs from game UI
    local existingButtonImageIds = {}

    -- 1. Collect Image IDs from our existing buttons
    for _, entry in ipairs(idDisplayScroller:GetChildren()) do
         -- Only process our custom entry frames
        if entry:IsA("Frame") and string.sub(entry.Name, 1, 13) == "AilmentEntry_" then
            local button = entry:FindFirstChildOfClass("TextButton")
            if button then
                local imageId = button.Name -- Get the original Image ID stored in the button's name
                existingButtonImageIds[imageId] = entry -- Store reference to the existing entry
            else
                 -- Remove malformed entries that somehow lost their button
                 print("Removing malformed entry:", entry.Name, " (missing button)")
                 entry:Destroy()
            end
        -- Also destroy any non-Frame children that aren't the UIListLayout
        elseif not entry:IsA("UIListLayout") then
             print("Removing unexpected child from scroller:", entry.Name, " (Class:", entry.ClassName, ")")
             entry:Destroy()
        end
    end
     -- print("Found", table.getn(existingButtonImageIds), "existing buttons.") -- Debug


    -- 2. Identify and remove buttons that no longer correspond to an active ailment
    local removedCount = 0
    for imageId, entry in pairs(existingButtonImageIds) do
        if not currentAilmentImageIds[imageId] then
            -- This button's ailment is no longer active, remove it
            print("Removing button for inactive ailment Image ID:", imageId)
            entry:Destroy()
            existingButtonImageIds[imageId] = nil -- Remove from our tracking table
            removedCount = removedCount + 1
        end
    end
     -- print("Removed", removedCount, "inactive ailment buttons.") -- Debug


    -- 3. Identify and create buttons for new active ailments
    local addedCount = 0
    for imageId, _ in pairs(currentAilmentImageIds) do
        if not existingButtonImageIds[imageId] then
            -- This active ailment doesn't have a button yet, create one
            local newFrame = createIconAndButtonEntry(imageId)
            if newFrame then
                existingButtonImageIds[imageId] = newFrame -- Add to list of existing buttons
                addedCount = addedCount + 1
            end
        end
    end
     print("Created", addedCount, "new ailment buttons.")


    -- 4. Re-sort the remaining/new entries based on their label
    local sortedEntries = {}
    -- Populate the sorted list with the kept and newly created entries
    for imageId, entry in pairs(existingButtonImageIds) do
        table.insert(sortedEntries, entry)
    end
    -- print("Found", table.getn(sortedEntries), "valid entries for sorting.") -- Debug

    table.sort(sortedEntries, function(a, b)
        local buttonA = a:FindFirstChildOfClass("TextButton")
        local buttonB = b:FindFirstChildOfClass("TextButton")
        if buttonA and buttonB then
            -- Use the label from actionMap for sorting
            local labelA = actionMap[buttonA.Name] and actionMap[buttonA.Name].label or buttonA.Name
            local labelB = actionMap[buttonB.Name] and actionMap[buttonB.Name].label or buttonB.Name
             labelA = labelA or ""
             labelB = labelB or ""
            return labelA < labelB -- Alphabetical sort by Label
        else
            return false -- Should not happen with checks above
        end
    })
    -- print("Entries sorted.") -- Debug


    -- 5. Update LayoutOrder and CanvasSize
    local totalHeight = 0
    local uiListLayout = idDisplayScroller:FindFirstChild("AilmentListLayout")
    local padding = uiListLayout and uiListLayout.Padding.Offset or 0

    for _, entry in ipairs(idDisplayScroller:GetChildren()) do
        if entry:IsA("Frame") and string.sub(entry.Name, 1, 13) == "AilmentEntry_" then
            totalHeight = totalHeight + entry.Size.Y.Offset + padding
        end
    end

    -- Adjust total height by subtracting the last padding
    if #sortedEntries > 0 then
         totalHeight = totalHeight - padding
    end

    totalHeight = totalHeight + 5 -- Add a little buffer

    idDisplayScroller.CanvasSize = UDim2.new(0, 0, 0, math.max(0, totalHeight))
    -- print("CanvasSize updated to:", idDisplayScroller.CanvasSize) -- Commented out to reduce spam
    -- print("refreshIDList finished.") -- Commented out to reduce spam
end

