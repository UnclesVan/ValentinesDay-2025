                local trampolines = workspace.StaticMap.Park:FindFirstChild("Trampolines")
                if trampolines then trampolines:Destroy() end
            end)

            pcall(function()
                local seesaw = workspace.StaticMap.Park:FindFirstChild("Seesaw")
                if seesaw then seesaw:Destroy() end
            end)

            pcall(function()
                local swingSets = workspace.StaticMap.Park:FindFirstChild("SwingSets")
                if swingSets then swingSets:Destroy() end
            end)

            pcall(function()
                local nursery = workspace.Interiors["MainMap!Default"].Buildings:FindFirstChild("Nursery")
                if nursery then nursery:Destroy() end
            end)

            pcall(function()
                local roundabout = workspace.StaticMap.Park:FindFirstChild("Roundabout")
                if roundabout then roundabout:Destroy() end
            end)
        end
    end

