        if serverSidedMapSeats then
            serverSidedMapSeats:Destroy()
            print("Removed model: ServerSidedMapSeats")
        end

        -- Remove Trampolines model
        local trampolines = Workspace:FindFirstChild("StaticMap")
        if trampolines and trampolines:FindFirstChild("Park") and trampolines.Park:FindFirstChild("Trampolines") then
            trampolines.Park.Trampolines:Destroy()
            print("Removed model: Trampolines")
        end

        -- Remove SwingSets model
        if trampolines and trampolines.Park:FindFirstChild("SwingSets") then
            trampolines.Park.SwingSets:Destroy()
            print("Removed model: SwingSets")
        end

        -- Remove Seesaw model
        if trampolines and trampolines.Park:FindFirstChild("Seesaw") then
            trampolines.Park.Seesaw:Destroy()
            print("Removed model: Seesaw")
        end

        -- Remove Roundabout model
        if trampolines and trampolines.Park:FindFirstChild("Roundabout") then
            trampolines.Park.Roundabout:Destroy()
            print("Removed model: Roundabout")
        end

        -- Remove Doors model from MainMap!Default
        local interiors = Workspace:FindFirstChild("Interiors")
        if interiors then
            local mainMap = interiors:FindFirstChild("MainMap!Default")
            if mainMap then
                local doors = mainMap:FindFirstChild("Doors")
                if doors then
                    doors:Destroy()
                    print("Removed model: Doors")
                end
            end
        end
        
        task.wait(1) -- Wait before checking again
    end
end

