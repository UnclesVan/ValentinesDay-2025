local function isPositionValid(position)
    local rayOrigin = position + Vector3.new(0, 10, 0)
    local rayDirection = Vector3.new(0, -15, 0)

    local raycastResult = Workspace:Raycast(rayOrigin, rayDirection)
    return raycastResult and raycastResult.Position.Y > 0
end

local function teleportToCollider(collider, humanoidRootPart)
    if humanoidRootPart then
        local colliderCFrame = collider.CFrame
        if isPositionValid(colliderCFrame.Position) then
            humanoidRootPart.CFrame = colliderCFrame
            print("Teleported to Collider at:", collider.Position)
        else
            print("Teleport position is invalid for Collider at:", collider.Position)
        end
    end
end

local function teleportToAllPartsInPath(humanoidRootPart, pathLocation)
    for _, model in pairs(Workspace.StaticMap.Valentines2025:FindFirstChild(pathLocation):GetChildren()) do
        if model:IsA("Model") then
            for _, part in pairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    teleportToCollider(part, humanoidRootPart)
                    task.wait(teleportWaitTime) -- Use the teleport wait time variable
                end
            end
        end
    end
end

local function teleportToColliders(humanoidRootPart, location)
    local targetLocation = Workspace.StaticMap.Valentines2025:FindFirstChild(location)

    if targetLocation then
        for _, v in pairs(targetLocation:GetDescendants()) do
            if v.Name == "Collider" then
                teleportToCollider(v, humanoidRootPart)
                task.wait(teleportWaitTime) -- Use the teleport wait time variable
            end
        end
    else
        warn("Target location not found: " .. location)
    end
end

local function startTeleporting()
    local player = Players.LocalPlayer
    local humanoidRootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if not humanoidRootPart then
        warn("HumanoidRootPart not found. Teleportation will not proceed.")
        return
    end

    while isTeleportingEnabled do
        teleportToColliders(humanoidRootPart, "Hearts")
        teleportToColliders(humanoidRootPart, "Roses")
        teleportToColliders(humanoidRootPart, "Hearts")
        teleportToAllPartsInPath(humanoidRootPart, "Rose_Paths")
        teleportToColliders(humanoidRootPart, "Hearts")
        task.wait(teleportWaitTime) -- Use the teleport wait time variable
    end

    print("Teleportation process has stopped.")
end

