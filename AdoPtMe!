-- Function to update the timer and shard/time displays
local function updateTimerAndLabels()
    while teleportingEnabled and isMinigameActive do
        -- Fetching Timer Value
        local timerLabelFromGame = Workspace:FindFirstChild("Interiors")
            and Workspace.Interiors:FindFirstChild("IceDimension")
            and Workspace.Interiors.IceDimension:FindFirstChild("JoinZones")
            and Workspace.Interiors.IceDimension.JoinZones:FindFirstChild("IceCubeHillMinigame")
            and Workspace.Interiors.IceDimension.JoinZones.IceCubeHillMinigame:FindFirstChild("Billboard")
            and Workspace.Interiors.IceDimension.JoinZones.IceCubeHillMinigame.Billboard:FindFirstChild("BillboardGui")
            and Workspace.Interiors.IceDimension.JoinZones.IceCubeHillMinigame.Billboard.BillboardGui:FindFirstChild("TimerLabel")

        if timerLabelFromGame and timerLabelFromGame:IsA("TextLabel") then
            timerLabel.Text = "Timer: " .. (timerLabelFromGame.Text or "Not Available")

            local timerValue = tonumber(timerLabelFromGame.Text)

            -- Check timer value and reset to first stage if necessary
            if timerValue and (timerValue <= 30 or timerValue <= 20) then
                print("Timer is at", timerValue, "seconds. Resetting to the first stage.")
                resetToFirstStage() -- Call reset function
                hasTeleported = false -- Reset teleportation flag after a reset
            end
        else
            timerLabel.Text = "Timer: Not Found." -- Fallback text
            hasTeleported = false -- Reset if the timer is not found
        end

        -- Update Shard Amount
        local shardLabel = player:FindFirstChild("PlayerGui"):FindFirstChild("MinigameInGameApp").Body.Right.Container.ValueLabel
        if shardLabel and shardLabel:IsA("TextLabel") then
            shardAmountLabel.Text = "Shards Amount: " .. (shardLabel.Text or "Not Available")
        else
            shardAmountLabel.Text = "Shards Amount: Not Available" -- Fallback text if not found
        end

        -- Update Time In Minigame
        local timeLabel = player:FindFirstChild("PlayerGui"):FindFirstChild("MinigameInGameApp").Body.Left.Container.ValueLabel
        if timeLabel and timeLabel:IsA("TextLabel") then
            timeInMinigameLabel.Text = "Time In Minigame: " .. (timeLabel.Text or "Not Available")
        else
            timeInMinigameLabel.Text = "Time In Minigame: Not Available" -- Fallback text if not found
        end

        wait(1) -- Update every second
    end
end

-- New function to continuously remove PlayerProfileApp
local function removePlayerProfileApp()
    while removeProfileEnabled do
        local playerProfileApp = player:FindFirstChild("PlayerProfileApp")
        if playerProfileApp then
            playerProfileApp:Destroy() -- Remove it if it's found
            print("PlayerProfileApp removed.")
        end
        wait(2) -- Wait before checking again
    end
end

-- Function to reset to the first stage
local function resetToFirstStage()
    print("Resetting to the first stage...")

    -- Attempt to find the necessary folders again
    local iceCubeHillMinigameFolder = getIceCubeHillMinigameFolder()
    if not iceCubeHillMinigameFolder then
        print("Join zone not found. Cannot reset minigame.")
        return
    end

    -- Optional: Reset player position
    if character and character:FindFirstChild("HumanoidRootPart") then
        humanoidRootPart.CFrame = CFrame.new(0, 5, 0) -- Reset position
    end

    -- Restart the scanning and timer updates
    coroutine.wrap(continuouslyFindDecalParts)()
    coroutine.wrap(updateTimerAndLabels)() -- Update to use new function
end

