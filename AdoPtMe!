-- Fire all connections of a button's event (Used for simulating clicks)
-- NOTE: getconnections is non-standard and may not work.
local function fireConnections(event)
    if type(getconnections) == "function" then
        local success, connections = pcall(getconnections, event)
        if success then
            for _, connection in pairs(connections) do
                local fireSuccess, result = pcall(connection.Fire)
                if not fireSuccess then
                    warn("Error firing connection:", result)
                end
            end
        else
             warn("Error getting connections:", connections)
        end
    else
         -- Fallback - less likely to work for game's internal events
        if event.Name == "MouseButton1Down" then
            pcall(event.Fire, event)
        elseif event.Name == "MouseButton1Click" then
             pcall(event.Fire, event)
        elseif event.Name == "MouseButton1Up" then
             pcall(event.Fire, event)
        else
             -- warn("getconnections function not available and cannot simulate event firing for:", event.Name) -- Too spammy
        end
    end
end

-- Simulate a click on a button
local function simulateClick(button)
    if button and button:IsA("GuiButton") then
        print("Attempting to simulate click on:", button.Name)
        local success, result = pcall(function()
            fireConnections(button.MouseButton1Down)
            wait(0.05) -- Small delay
            fireConnections(button.MouseButton1Click)
            wait(0.05) -- Small delay
            fireConnections(button.MouseButton1Up)
        end)
        if success then
             print("Simulated click on:", button.Name, "successful.")
        else
             warn("Error simulating click on", button.Name, ":", result)
        end
    else
        warn("Invalid or non-button object provided for simulateClick!")
    end
end


-- Function to find the "Container" holding the ailment icons in the game's UI
local function getAilmentsContainer()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    -- Based on previous attempts and typical Roblox UI structures
    local ailmentsApp = playerGui:FindFirstChild("AilmentsApp")
    local ailmentContainer = ailmentsApp and ailmentsApp:FindFirstChild("Frame")
        and ailmentsApp.Frame:FindFirstChild("AilmentList")
        and ailmentsApp.Frame.AilmentList:FindFirstChild("AilmentContainer")

    -- If the above path doesn't work, try a more general search within PlayerGui
    if not ailmentContainer then
         -- This is a fallback and might find the wrong container
         -- print("Standard AilmentsApp path not found, trying broader search...") -- Optional debug
         for _, gui in ipairs(playerGui:GetChildren()) do
             if gui:IsA("ScreenGui") then
                 local found = gui:FindFirstChild("AilmentContainer", true) -- Search descendants
                 if found and found:IsA("GuiObject") then
                     -- print("Found AilmentContainer using broader search:", found.GetFullName()) -- Optional debug
                     return found
                 end
             end
         end
    end

    return ailmentContainer -- Return the found container (or nil)
end

