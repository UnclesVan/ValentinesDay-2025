    end
end)

-- Add toggle for enabling/disabling teleportation & folder scanning
local ToggleTeleportation = Tabs.IceDimension:AddToggle("TeleportToggle", { Title = "Enable Teleportation", Default = false })
ToggleTeleportation:OnChanged(function()
    teleportingEnabled = ToggleTeleportation.Value
    if teleportingEnabled then
        isMinigameActive = true -- Set minigame active state
        statusLabel.Text = "Teleportation: Enabled" -- Update status label
        hasTeleported = false -- Reset teleportation flag before starting
        coroutine.wrap(teleportToDecalParts)() -- Start teleportation

        -- Start scanning for DecalParts
        if not scanningActive then
            coroutine.wrap(continuouslyFindDecalParts)() -- Start scanning for DecalParts
            scanningActive = true
        end

    else
        isMinigameActive = false -- Reset state when teleportation is disabled
        scanningActive = false -- Stop scanning
        statusLabel.Text = "Teleportation: Disabled" -- Update status label
    end
end)

