-- Control Variables
local clickingEnabled = false -- Set to false to disable clicking by default
local removeProfileEnabled = false -- Set to false to disable profile removal by default
local teleportingEnabled = false -- Set to false to disable teleportation by default
local decalPartName = "DecalPart"
local decalParts = {}  -- Table to store found DecalParts
local uiFrame, statusLabel, timerLabel, shardAmountLabel, timeInMinigameLabel -- UI elements
local isMinigameActive = false -- Tracks if the minigame is active
local scanningActive = false -- Tracks if folder scanning is active
local hasTeleported = false -- Track if a teleportation has occurred

-- Check if the script is running in a LocalScript context
local player = Players.LocalPlayer
if not player then
    warn("This script must be run in a LocalScript.")
    return
end

local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Function to simulate a screen click (center-focused randomization)
local function clickScreen()
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local screenWidth = camera.ViewportSize.X
    local screenHeight = camera.ViewportSize.Y

    local centerX = screenWidth / 2
    local centerY = screenHeight / 2

    local clickX = math.random(centerX - 50, centerX + 50)  -- Randomized click position around the center
    local clickY = math.random(centerY - 50, centerY + 50)

    print("Clicking screen at:", clickX, clickY)

    -- Simulate a mouse press and release
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
    wait(0.02)  -- Reduced delay for faster clicks
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
end

-- Function to find all DecalParts in models
local function findDecalPartsInModel(model)
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("Model") then
            findDecalPartsInModel(child)
        elseif child.Name == decalPartName and child:IsA("MeshPart") then
            table.insert(decalParts, child)
        end
    end
end

-- Function to find all DecalParts
local function findDecalParts(iceCubeHillMinigameFolder)
    decalParts = {} -- Clear existing parts to allow re-finding
    findDecalPartsInModel(iceCubeHillMinigameFolder)
    print("Total DecalParts Found: " .. #decalParts)
end

-- Function to get the IceCubeHillMinigame folder
local function getIceCubeHillMinigameFolder()
    local interiorsFolder = Workspace:FindFirstChild("Interiors")
    if interiorsFolder then
        local iceCubeHillMinigameFolder = interiorsFolder:FindFirstChild("IceCubeHillMinigame")
        if iceCubeHillMinigameFolder then
            return iceCubeHillMinigameFolder
        end
    end
    return nil
end

-- Function to continuously scan for DecalParts
local function continuouslyFindDecalParts()
    scanningActive = true
    while scanningActive do
        local iceCubeHillMinigameFolder = getIceCubeHillMinigameFolder()
        if iceCubeHillMinigameFolder then
            findDecalParts(iceCubeHillMinigameFolder)
        else
            print("IceCubeHillMinigame folder not found. Checking again in 5 seconds...")
        end
        wait(5) -- Check every 5 seconds for updates in the folder
    end
end

-- Coroutine for clicking loop
local function clickingLoop()
    while clickingEnabled do
        clickScreen()
        wait(0.05)  -- Adjust speed for more/less frequent clicks
    end
end

-- Coroutine for teleportation to DecalParts
local function teleportToDecalParts()
    while teleportingEnabled do
        if #decalParts > 0 then  -- Check if there are decal parts
            for i = 1, math.min(4, #decalParts) do
                local decalPart = decalParts[i]
                if decalPart then
                    humanoidRootPart.CFrame = decalPart.CFrame * CFrame.new(0, 5, 0)
                    wait(1) -- Wait before clicking
                    clickScreen() -- Click after teleporting
                    hasTeleported = true  -- Set flag indicating a teleportation has occurred
                    wait(0.5) -- Wait before teleporting again
                end
            end
        end
        wait(2) -- Wait before the next round of teleportation
    end
end

