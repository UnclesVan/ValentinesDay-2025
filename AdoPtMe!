-- Load services
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Function to simulate a screen click
local function clickScreen()
    local screenWidth = workspace.CurrentCamera.ViewportSize.X
    local screenHeight = workspace.CurrentCamera.ViewportSize.Y

    local clickX = screenWidth / 2
    local clickY = screenHeight / 2

    print("Clicking screen at:", clickX, clickY)

    -- Simulate a mouse press and release
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
    wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
end

-- Loop: Clicks the screen every 3 seconds
while true do
    clickScreen()
    wait(3) -- Change this for longer/shorter delays
end


task.wait(3)
local player = game.Players.LocalPlayer

if not player then
    warn("This script must be run in a LocalScript.")
    return
end

local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Path to the IceCubeHillMinigame folder
local iceCubeHillMinigameFolder = workspace:FindFirstChild("Interiors"):FindFirstChild("IceCubeHillMinigame")

-- Specify the name of the MeshPart
local decalPartName = "DecalPart"
local decalParts = {} -- Table to store found DecalParts

-- Function to find DecalParts
local function findDecalParts()
    decalParts = {} -- Reset the decalParts table
    if iceCubeHillMinigameFolder then
        for _, model in ipairs(iceCubeHillMinigameFolder:GetChildren()) do
            local decalPart = model:FindFirstChild(decalPartName)
            if decalPart and decalPart:IsA("MeshPart") then
                table.insert(decalParts, decalPart) -- Collect DecalParts
            end
        end
    else
        print("IceCubeHillMinigame folder not found in Interiors.")
    end
end

-- Keep finding decal parts on initial run
findDecalParts()

-- Main loop for teleportation
while true do
    if #decalParts > 0 then
        for i, decalPart in ipairs(decalParts) do
            humanoidRootPart.CFrame = decalPart.CFrame * CFrame.new(0, 5, 0) -- Adjust the height as necessary
            print("Teleporting to DecalPart " .. i .. ": " .. decalPart.Name)
            wait(1)  -- Pause for 1 second before moving to the next
        end
    else
        print("No DecalParts found. Waiting...")
        wait(2)  -- Wait before rechecking for DecalParts
        findDecalParts()  -- Reattempt to find DecalParts again in the next loop
    end
end
