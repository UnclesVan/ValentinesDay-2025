-- Function to display dehashed message
local function displayDehashedMessage()
    largeTextLabel.Text = "" -- Set the message text
    largeTextLabel.TextColor3 = Color3.fromRGB(0, 255, 0)  -- Set text color to green
    wait(3) -- Wait for 3 seconds
    largeTextLabel.Text = "" -- Clear the message text
    largeTextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)  -- Reset text color to default (white)
end

-- Call the function to display the message
