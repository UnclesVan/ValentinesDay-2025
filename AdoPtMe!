-- **Anti-AFK Logic:** Uses VirtualUser to simulate input.

local bb = game:GetService("VirtualUser")
local afkTimer = 0

-- Function to update the AFK timer
local function updateAfkTimer()
    while wait(1) do
        afkTimer = afkTimer + 1
        afkTimerLabel.Text = "Total Time: " .. afkTimer .. "s"
    end
end

-- Start the timer loop in a separate thread
coroutine.wrap(updateAfkTimer)()

local function onIdled()
    -- This part of the script is now unnecessary, as the timer runs independently
    -- and should not reset.  We leave it in for the anti-afk functionality.

