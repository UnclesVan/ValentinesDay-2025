local Options = Fluent.Options

-- Add toggle for enabling/disabling clicking
local ToggleClicking = Tabs.IceDimension:AddToggle("ClickToggle", { Title = "Enable Clicking", Default = false })
ToggleClicking:OnChanged(function()
    clickingEnabled = ToggleClicking.Value
    print("Clicking Enabled:", clickingEnabled)
end)

-- Add toggle for executing loadstring (Tora)
local ToggleTeleportation = Tabs.IceDimension:AddToggle("TeleportToggle", { Title = "Tora", Default = false }) -- Default set to false
ToggleTeleportation:OnChanged(function()
    teleportingEnabled = ToggleTeleportation.Value
    print("Tora Enabled:", teleportingEnabled)
    
    -- Start or stop teleportation based on toggle state
    if teleportingEnabled then
        print("Starting Tora script execution.")
        while teleportingEnabled do
            -- Execute the loadstring each loop iteration
            executeToraScript()
        end
    else
        print("Tora has been fully disabled.")
    end
end)

