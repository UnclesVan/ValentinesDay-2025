            coroutine.wrap(continuouslyFindDecalParts)() -- Start scanning for DecalParts
            scanningActive = true
        end

        -- Start updating the timer and labels
        coroutine.wrap(updateTimerAndLabels)() -- Start updating the timer
    else
        isMinigameActive = false -- Reset state when teleportation is disabled
        scanningActive = false -- Stop scanning
        statusLabel.Text = "Teleportation: Disabled" -- Update status label
    end
end)

