-- Shared function for equipping/using an item with ToolAPI/Equip
local function attemptEquipItem(uniqueId, displayName)
    if not uniqueId then return end
    
    local args = {
        uniqueId,
        {
            use_sound_delay = false,
            equip_as_last = false
        }
    }
    
    local success, result = pcall(function()
        return game:GetService("ReplicatedStorage"):WaitForChild("API"):WaitForChild("ToolAPI/Equip"):InvokeServer(unpack(args))
    end)
    
    if success and result then
        print(string.format("Equip SUCCESS for %s. ID: %s. Result:", displayName, uniqueId), result)
    else
        local errorMessage = success and "API returned unsuccessful status/nil result." or result
        print(string.format("Equip FAILED for %s. ID: %s. Error:", displayName, uniqueId), errorMessage)
    end
end

