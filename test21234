-- Function to safely traverse a path and find the target object
local function getObjectFromPath(root, path)
    local current = root
    -- Split by the dot separator.
    local parts = string.split(path, ".")

    for _, partName in ipairs(parts) do
        local cleanedName = partName
        
        -- Try to strip common quoted/bracketed parts from bad path formats
        local s, e, innerName = string.find(partName, '^%[?"(.-)"%]?$')
        if innerName then
            cleanedName = innerName
        end

        local child = current:FindFirstChild(cleanedName)
        if not child then
            return nil -- Path broken
        end
        current = child
    end
    return current
end

