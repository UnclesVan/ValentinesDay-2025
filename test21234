end

-- Function to continuously move a specific model far away
local function infiniteModelMover()
    updateStatus("Model Mover (Sandman) thread started.", COLOR_INFO)
    
    while task.wait(MODEL_MOVE_INTERVAL) do
        -- Find the interior model using prefix matching
        local interior = nil
        local interiors = workspace:FindFirstChild("Interiors")
        
        if interiors then
            for _, child in pairs(interiors:GetChildren()) do
                -- Check if the name starts with the TARGET_INTERIOR_NAME prefix
                if child:IsA("Model") and child.Name:sub(1, #TARGET_INTERIOR_NAME) == TARGET_INTERIOR_NAME then
                    interior = child
                    break -- Found the interior model
                end
            end
        end
        
        if interior then
            -- Find all descendants named "Sandman" inside the target interior
            for _, model in ipairs(interior:GetDescendants()) do
                -- Check if it's a Model and has the target name
                if model.Name == TARGET_MODEL_NAME and model:IsA("Model") then
                    -- Set the model's position far away
                    if model.PrimaryPart then
                        model:SetPrimaryPartCFrame(MODEL_MOVE_POSITION)
                    else
                        -- If no PrimaryPart, attempt to move all base parts relative to the model's current center
                        local modelCenter = model:GetBoundingBox().p
                        for _, part in ipairs(model:GetChildren()) do
                            if part:IsA("BasePart") then
                                -- Preserve the relative offset, but set the CFrame to the high position
                                part.CFrame = MODEL_MOVE_POSITION * CFrame.new(part.Position - modelCenter)
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Helper function to find the specific fixed Ring target
local function findRingTarget()
    -- Find the interior model using prefix matching
    local interior = nil
    local interiors = workspace:FindFirstChild("Interiors")
    
    if not interiors then return nil end
    
    for _, child in pairs(interiors:GetChildren()) do
        -- Check if the name starts with the TARGET_INTERIOR_NAME prefix
        if child:IsA("Model") and child.Name:sub(1, #TARGET_INTERIOR_NAME) == TARGET_INTERIOR_NAME then
            interior = child
            break -- Found the interior model
        end
    end
    
    if not interior then return nil end
    
    -- Trace the full path: Visual.TreatDash_V1.CandyBasketMain.CandyZone.Ring
    local target = interior:FindFirstChild("Visual")
    if not target then return nil end
    target = target:FindFirstChild("TreatDash_V1")
    if not target then return nil end
    target = target:FindFirstChild("CandyBasketMain")
    if not target then return nil end
    target = target:FindFirstChild("CandyZone")
    if not target then return nil end
    target = target:FindFirstChild("Ring")
    
    if target and target:IsA("BasePart") then
        return target
    end
    return nil
end

-- Function to find and filter the main DoorDressing targets
local function findAndFilterTargets(rootSearchArea)
    local validTargets = {}

    if not rootSearchArea then
        updateStatus("Error: 'Interiors' folder not found. Waiting for it to appear...", COLOR_ERROR)
        return validTargets
    end
    
    updateStatus(string.format("Found %d Interior Models. Searching for specific DoorDressing paths...", #rootSearchArea:GetChildren()), COLOR_INFO) 
    
    for _, interiorModel in pairs(rootSearchArea:GetChildren()) do
        if interiorModel:IsA("Model") and not EXCLUDED_INTERIOR_NAMES_SET[interiorModel.Name] then
            
            local pHouses = interiorModel:FindFirstChild("PlotHouses")
            
            if pHouses then
                -- Iterate through ALL children that match the "House_X" pattern
                for _, house in pairs(pHouses:GetChildren()) do
                    -- Check if the object is a model and its name starts with "House_"
                    if house:IsA("Model") and house.Name:match("^House_%d+$") then
                        
                        -- Trace the rest of the path: Doors.MainDoor.Door.DoorDressing
                        local doors = house:FindFirstChild("Doors")
                        local mainDoor = doors and doors:FindFirstChild("MainDoor")
                        local door = mainDoor and mainDoor:FindFirstChild("Door")
                        local doorDressing = door and door:FindFirstChild(TARGET_PART_NAME) -- TARGET_PART_NAME is "DoorDressing"
                        
                        if doorDressing and doorDressing:IsA("BasePart") then
                            -- Store the part and the house name for the teleport loop
                            table.insert(validTargets, {
                                part = doorDressing,
                                houseName = house.Name
                            })
                        end
                    end
                end
            end
        end
    end
    
    return validTargets
end

-- Core logic function to be called once per while loop iteration.
local function executeTeleportStep(rootSearchArea, currentHRP)
    
    -- --- TARGET FINDING AND CACHING LOGIC (RE-SEARCH) ---
    if shouldRecacheTargets then
        
        -- If the root search area is missing, force the loop to continue searching for it
        if not rootSearchArea then
            updateStatus("Error: 'Interiors' folder not found. Retrying search in 0.5s.", COLOR_ERROR)
            task.wait(0.5) -- Faster retry for missing root folder
            return
        end
        
        -- Wait robustly for models to load (in case a new interior just loaded)
        local currentInteriorCount = #rootSearchArea:GetChildren()
        
        -- Only wait if the count is zero (meaning no minigame world is loaded yet)
        if currentInteriorCount == 0 then
            updateStatus("Recaching: Waiting for new interior models to load (0.5s retry)...", COLOR_SEARCH)
            task.wait(0.5)
            return -- Skip this iteration, force a check next time
        end

        -- Perform the expensive search
        cachedTargets = findAndFilterTargets(rootSearchArea)
        shouldRecacheTargets = false -- Reset flag after successful recache
    end
    
    local totalTargets = #cachedTargets

    if totalTargets == 0 then
        updateStatus("No targets found in loaded models. Forcing re-search in 0.5s. (Searching for Minigame Houses)", COLOR_ERROR)
        shouldRecacheTargets = true -- Force re-search in the next loop iteration
        task.wait(0.5) -- Faster retry for finding targets in the loaded world
        return 
    end

    updateStatus(string.format("Found %d targets. Starting teleport sequence (10s delay per target).", totalTargets), COLOR_INFO)

    for i, targetInfo in ipairs(cachedTargets) do 
        
        -- Check operational status frequently during the loop
        while not isTeleporting do task.wait(0.1) end
        
        -- Extract the part and the house name
        local target = targetInfo.part
        local houseName = targetInfo.houseName
        
        -- 1. Teleport to the DoorDressing Target
        local targetPosition = target.CFrame.p + Vector3.new(0, 5, 0)

        currentHRP.CFrame = CFrame.new(targetPosition)
        
        -- Safer teleport block
        local humanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = true
            task.wait(0.2) 
            humanoid.PlatformStand = false
        end

        -- Logging and Status Update
        local interiorModelName = "Unknown Interior"
        
        -- Get the Interior Model Name (ancestor whose parent is Interiors)
        local currentAncestor = target.Parent
        while currentAncestor and currentAncestor.Parent ~= workspace.Interiors do
            currentAncestor = currentAncestor.Parent
        end
        
        if currentAncestor and currentAncestor.Parent == workspace.Interiors then
            interiorModelName = currentAncestor.Name
        end
        
        -- UPDATED STATUS MESSAGE to use the dynamic houseName
        local statusMessage = string.format("[%d/%d] Teleporting to %s, Interior: %s", 
            i, totalTargets, houseName, interiorModelName)
            
        updateStatus(statusMessage, COLOR_INFO)

        task.wait(TELEPORT_DELAY) -- Standard wait (10 seconds)

        -- 2. NEW: Teleport to the RING TARGET after every DoorDressing teleport
        
        -- Check operational status before intermittent teleport
        while not isTeleporting do task.wait(0.1) end
        
        local ringTarget = findRingTarget()
        
        if ringTarget then
            local ringPosition = ringTarget.CFrame.p + Vector3.new(0, 5, 0)
            currentHRP.CFrame = CFrame.new(ringPosition)
            
            -- Safer teleport block
            if humanoid then
                humanoid.PlatformStand = true
                task.wait(0.2) 
                humanoid.PlatformStand = false
            end
            
            updateStatus("JUMPED TO CandyZone Ring! Resuming main path.", COLOR_SUCCESS)
            task.wait(0.5) -- Short delay
        end
    end

    -- Finished current batch, wait briefly before re-searching for new targets
    updateStatus(string.format("Batch of %d targets complete. Restarting sequence in 5 seconds.", totalTargets), COLOR_INFO)
    task.wait(5)
end

-- Main teleport loop logic
local function teleportLoop()
    
    -- ** BEGIN INFINITE TELEPORT LOOP **
    while true do
        
        -- 1. DYNAMIC CHARACTER CHECK: Get the current character and HRP (Handles respawns)
        local currentCharacter = player.Character or player.CharacterAdded:Wait()
        local currentHRP = currentCharacter:FindFirstChild("HumanoidRootPart")

        -- Wait if HRP is missing (e.g., character still loading)
        while not currentHRP do
            updateStatus("Waiting for HumanoidRootPart to load...", COLOR_SEARCH)
            task.wait(0.5)
            currentCharacter = player.Character or player.CharacterAdded:Wait()
            currentHRP = currentCharacter:FindFirstChild("HumanoidRootPart")
        end
        
        -- 2. PAUSE BLOCK: Wait here if the operational status is OFF (either manual or timer)
        while not isTeleporting do task.wait(0.1) end 
        
        -- 3. Get the root search area here on every iteration (in case it loads late)
        local rootSearchArea = workspace:FindFirstChild("Interiors")

        -- 4. Execute the core logic block (The function handles the small retry waits)
        executeTeleportStep(rootSearchArea, currentHRP)
    end
    -- ** END INFINITE TELEPORT LOOP **
end

-- Entry point: Sets up UI and starts concurrent tasks
local function startTeleport()
    
    local TeleportToggle, CloseButton = nil, nil
    
    -- *** NEW: Spawn the UI creation to run asynchronously. ***
    local uiThread = task.spawn(function()
        TeleportToggle, CloseButton = createNativeDoorStatusUI() 
        print("[UI_THREAD] UI creation and parenting is complete.")
    end)
    
    -- Wait until the UI thread completes its work and returns the buttons
    task.wait(uiThread) 
    
    -- If UI creation failed (e.g., timed out), we can't proceed with button setup
    if not TeleportToggle or not CloseButton then
        print("[ERROR] UI Creation failed or timed out. Stopping script initialization.")
        return 
    end
    
    updateStatus("Script Initialized. Starting background services...", COLOR_INFO)

    -- UI Button Connections
    CloseButton.MouseButton1Click:Connect(function()
        -- Setting the flag to false allows the spawned threads to detect the stop condition
        isManuallyToggledOn = false -- Disable manual toggle
        isTeleporting = false       -- Ensure operational status is false
        
        if teleportThread then
            task.cancel(teleportThread) -- Stop the main teleport loop
        end
        
        -- Updated Destruction Logic: Destroy the MainFrame, which may be a child of an external UI
        local mainFrame = CloseButton.Parent.Parent
        if mainFrame.Parent and mainFrame.Parent.ClassName == "ScreenGui" then
            -- If it was a fallback ScreenGui, destroy the ScreenGui
            mainFrame.Parent:Destroy()
        else
            -- If it was parented to an existing frame, just destroy the MainFrame itself
            mainFrame:Destroy()
        end
        
        print("[STATUS] Teleporter script STOPPED by user.")
    end)
    
    TeleportToggle.MouseButton1Click:Connect(function()
        -- Only update the manual state. The timerMonitor thread handles the operational state (isTeleporting)
        isManuallyToggledOn = not isManuallyToggledOn
        
        -- If user manually toggles OFF, we immediately force the operational status OFF
        if not isManuallyToggledOn then
            isTeleporting = false
        end
        -- If user manually toggles ON, the timerMonitor will check for safety and resume if appropriate.
    end)

    -- Start concurrent threads (Model Mover, Clicker, and NEW Timer Monitor)
    task.spawn(infiniteModelMover)
    task.spawn(infiniteClicker)
    task.spawn(timerMonitor) -- Start the new timer monitoring thread
    
    -- Start the main teleport loop and save the thread reference
    teleportThread = task.spawn(teleportLoop)
    updateStatus("Starting infinite teleport loop...", COLOR_INFO)
end

-- Run the script
if player.Character then
    startTeleport()
else
    -- Wait for the initial character to load if it hasn't yet.
    player.CharacterAdded:Wait() 
    startTeleport()
end
