    for i, target in ipairs(MINIGAME_MONITOR_TARGETS) do
        -- Store the label reference directly in the table
        visualMonitorLabels[target.Name] = VisualTab:AddParagraph({
            Title = target.Name,
            Content = "Monitor Disabled."
        })
    end
    
    -- *** FIX FOR MISSING SetContent METHOD ***
    -- Wait briefly for Fluent to fully initialize the component objects
    task.wait(0.2) -- Increased wait time slightly for safety

    local AutoMonitorToggle = VisualTab:AddToggle("AutoMonitorVisuals", {
        Title = "Enable Live Data Monitoring",
        Description = "Starts monitoring and updating the timers and currency amounts.",
        Default = false
    })

    -- Function to continuously update the labels
    local function updateMonitorLoop()
        -- Wait a moment on loop start to allow UI components to be fully ready
        task.wait(0.5) 
        
        -- Ensure the loop runs only while the toggle is enabled and the library is loaded
        while Options.AutoMonitorVisuals.Value and not Fluent.Unloaded do
            for _, target in ipairs(MINIGAME_MONITOR_TARGETS) do
                local label = visualMonitorLabels[target.Name] -- Access by name 
                
                -- Determine the root object (PlayerGui or workspace)
                local root = (target.DataRootName == "PlayerGui" and PlayerGui) or (target.DataRootName == "workspace" and workspace)

                local foundObject = getObjectFromPath(root, target.Path)
                
                if label then
                    local value = "N/A (Path Unloaded)"
                    
                    if foundObject then
                        if foundObject:IsA("TextLabel") or foundObject:IsA("TextBox") then
                            if foundObject.Text then
                                value = foundObject.Text
                            else
                                value = "N/A (Object Found but No Text Property)"
                            end
                        else
                            value = "Object Found: " .. foundObject.ClassName .. " | Path: " .. target.Path
                        end
                    else
                        value = "N/A (Object Not Found at Path)"
                        -- No print here to reduce console spam, but error is visible in the UI
                    end

                    -- *** ROBUST SetContent FIX ***
                    local success, err = pcall(function()
                        label:SetContent(tostring(value))
                    end)
                    
                    if not success then
                        -- This logs the error, but the loop continues without breaking
                        warn("Fluent UI Error (Attempt 2): SetContent failed for label:", target.Name, " Error:", err)
                    end
                end
            end
            
            task.wait(REFRESH_RATE)
            if Fluent.Unloaded then break end
        end
        -- Reset labels when loop stops or script unloads
        for _, label in pairs(visualMonitorLabels) do
            if label.SetContent then
                local success, _ = pcall(function()
                    label:SetContent("Monitor Disabled.")
                end)
            end
        end
        visualMonitorTask = nil
    end

    AutoMonitorToggle:OnChanged(function(Value)
        if Value then
            if not visualMonitorTask then
                visualMonitorTask = task.spawn(updateMonitorLoop)
                print("Live Data Monitor Enabled.")
            end
        elseif visualMonitorTask then
            task.cancel(visualMonitorTask)
            visualMonitorTask = nil
            print("Live Data Monitor Disabled.")
        end
    end)
end

