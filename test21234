    -- Cache the necessary properties/layouts to apply when parenting to HauntletUI
    local HAUNTLET_SIZE = UDim2.new(1, 0, 0.35, 0)
    local HAUNTLET_POS = UDim2.new(0, 0, 0, 0)
    local verticalLayout = Instance.new("UIListLayout")
    verticalLayout.FillDirection = Enum.FillDirection.Vertical
    verticalLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    updateStatus("UI Parent Monitor started (Continuous search for HauntletUI).", COLOR_SEARCH)
    
    while true do
        task.wait(0.5) -- Check every half second
        
        -- 1. Try to find the target parent frame inside HauntletFarmUI
        local hauntletUI = player.PlayerGui:FindFirstChild("HauntletFarmUI")
        local targetParentFrame = hauntletUI and hauntletUI:FindFirstChild("MainFrame", true) 
                                and hauntletUI.MainFrame:FindFirstChild("ContentFrame")
        
        if targetParentFrame and targetParentFrame:IsA("Frame") then
            
            -- *** Target Parent FOUND ***
            
            -- Check if our UI is already correctly parented
            if TeleporterMainFrame.Parent ~= targetParentFrame then
                print("[UI_MONITOR] HauntletUI found! Re-parenting custom UI.")
                
                -- Apply Hauntlet-specific sizing/layout
                TeleporterMainFrame.Size = HAUNTLET_SIZE
                TeleporterMainFrame.Position = HAUNTLET_POS
                
                -- Remove any existing layout (to be safe)
                if TeleporterMainFrame:FindFirstChildOfClass("UIListLayout") then
                    TeleporterMainFrame:FindFirstChildOfClass("UIListLayout"):Destroy()
                end
                
                -- Add the required vertical layout for stacking within the ContentFrame
                if not TeleporterMainFrame:FindFirstChild("VerticalLayout") then
                    verticalLayout:Clone().Parent = TeleporterMainFrame
                end
                
                -- Set the new parent
                TeleporterMainFrame.Parent = targetParentFrame
                
                -- Ensure the fallback ScreenGui is disabled
                if FallbackScreenGui.Enabled then FallbackScreenGui.Enabled = false end
            end
            
        else
            
            -- *** Target Parent NOT FOUND (or destroyed) ***
            
            -- Check if our UI is *not* currently parented to the fallback (meaning it was using HauntletUI)
            if TeleporterMainFrame.Parent ~= FallbackScreenGui then
                print("[UI_MONITOR] HauntletUI lost. Re-parenting custom UI to Fallback GUI.")
                
                -- Restore fallback sizing/positioning
                TeleporterMainFrame.Size = UDim2.new(0.3, 0, 0.08, 0)
                TeleporterMainFrame.AnchorPoint = Vector2.new(0, 1)
                TeleporterMainFrame.Position = UDim2.new(0.05, 0, 0.95, 0)
                
                -- Remove the vertical layout used for HauntletUI
                if TeleporterMainFrame:FindFirstChildOfClass("UIListLayout") then
                    TeleporterMainFrame:FindFirstChildOfClass("UIListLayout"):Destroy()
                end

                -- Set the parent back to the fallback ScreenGui
                TeleporterMainFrame.Parent = FallbackScreenGui
                
                -- Ensure the fallback ScreenGui is enabled
                if not FallbackScreenGui.Enabled then FallbackScreenGui.Enabled = true end
            end
        end
    end
end

-- Function to continuously monitor the minigame timer and control isTeleporting state
local function timerMonitor()
    updateStatus("Timer Monitor active.", COLOR_INFO)
    
    local requiredMinSafeSeconds = parseTime(MIN_STOP_TIME_MMSS) + 1

    while task.wait(0.5) do
        
        -- --- DIRECT PATH TO VALUE LABEL ---
        local valueLabel = player.PlayerGui:FindFirstChild("MinigameInGameApp", true)
        valueLabel = valueLabel and valueLabel:FindFirstChild("Body", true)
        valueLabel = valueLabel and valueLabel:FindFirstChild("Left")
        valueLabel = valueLabel and valueLabel:FindFirstChild("Container")
        valueLabel = valueLabel and valueLabel:FindFirstChild("ValueLabel")
        
        -- --- HANDLE UI TOGGLE APPEARANCE ---
        if TeleportToggle and TeleportToggle:IsA("GuiButton") then
            if isManuallyToggledOn then
                TeleportToggle.Text = "TELEPORT: ON"
                TeleportToggle.BackgroundColor3 = COLOR_SUCCESS
            else
                TeleportToggle.Text = "TELEPORT: OFF"
                TeleportToggle.BackgroundColor3 = COLOR_PAUSED
            end
        end
        
        -- If user manually paused, keep operational status paused and skip timer check
        if not isManuallyToggledOn then
            if isTeleporting then isTeleporting = false end
            updateStatus("Teleporting PAUSED by user (Manual).", COLOR_PAUSED)
            continue
        end
        
        -- --- TIMER LOGIC (Only runs if isManuallyToggledOn is true) ---
        if valueLabel and valueLabel.Visible and valueLabel.Text then
            local timeText = valueLabel.Text
            local totalSeconds = parseTime(timeText)
            
            if totalSeconds < requiredMinSafeSeconds and totalSeconds >= 0 then
                -- PAUSE: Timer is low (e.g., 00:30 or less)
                if isTeleporting then
                    isTeleporting = false
                    shouldRecacheTargets = true 
                    updateStatus(string.format("TIMER LOW: %s. Teleports paused (Stop at %s).", timeText, MIN_STOP_TIME_MMSS), COLOR_ERROR)
                end
            elseif totalSeconds >= requiredMinSafeSeconds then
                -- RESUME: Time is safe (e.g., 00:31 or more)
                if not isTeleporting then
                    isTeleporting = true
                    shouldRecacheTargets = true
                    updateStatus(string.format("TIMER SAFE: %s. Teleports resumed. Starting search/teleport.", timeText), COLOR_SUCCESS)
                end
            end
            
        elseif not valueLabel and isManuallyToggledOn then
            -- RESUME: Minigame GUI is gone (meaning minigame is over or hasn't started)
            if not isTeleporting then
                isTeleporting = true
                shouldRecacheTargets = true 
                updateStatus("Minigame ended/unstarted. Teleports resumed. Will search for new interior.", COLOR_SUCCESS)
            end
        end
    end
end

