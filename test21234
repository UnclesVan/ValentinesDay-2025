-- Function to wait for and retrieve player data
local function waitForData()
    local data = ClientDataModule.get_data()
    local playerName = Players.LocalPlayer.Name
    -- Wait until the data table is populated with the local player's key
    while not data or not data[playerName] do
        task.wait(0.5)
        data = ClientDataModule.get_data()
    end
    return data
end

local function calculateAge(timestamp)
    -- This function converts a Unix timestamp into a readable age string (Days, Hours, Minutes)
    if type(timestamp) ~= "number" or timestamp <= 0 then
        return "N/A (Invalid Timestamp)"
    end

    local SECONDS_IN_MINUTE = 60
    local SECONDS_IN_HOUR = 3600
    local SECONDS_IN_DAY = 86400

    local currentTime = os.time()
    local ageSeconds = math.floor(currentTime - timestamp)

    if ageSeconds < 0 then
        return "N/A (Future Timestamp)"
    end

    local days = math.floor(ageSeconds / SECONDS_IN_DAY)
    local remainingSeconds = ageSeconds % SECONDS_IN_DAY

    local hours = math.floor(remainingSeconds / SECONDS_IN_HOUR)
    remainingSeconds = remainingSeconds % SECONDS_IN_HOUR

    local minutes = math.floor(remainingSeconds / SECONDS_IN_MINUTE)

    local ageString = ""
    if days > 0 then
        ageString = ageString .. days .. (days == 1 and " day" or " days")
    end

    if days == 0 or (days > 0 and hours > 0 and days < 10) then
        if ageString ~= "" then ageString = ageString .. ", " end
        ageString = ageString .. hours .. (hours == 1 and " hr" or " hrs")
        if days == 0 then
            ageString = ageString .. ", " .. minutes .. (minutes == 1 and " min" or " mins")
        end
    end

    return ageString
end

-- Helper function to capitalize and replace underscores/hyphens for readability
local function formatItemName(rawName)
    if not rawName or rawName == "" then return "Unknown Item" end
    local formatted = string.gsub(rawName, "[_-]", " ")
    formatted = string.gsub(formatted, "(%a)(%w*)", function(first, rest)
        return string.upper(first) .. string.lower(rest)
    end)
    return formatted
end

-- Function to parse the inventory data and return a list of food items
local function getFoodInventoryList()
    local foodItems = {"No Food Found (Retry Script)"}
    local success, serverData = pcall(waitForData)
    
    foodDisplayToUniqueId = {} -- Clear previous unique ID mapping

    if not success or not serverData then
        warn("Failed to retrieve server data for food:", serverData)
        return foodItems
    end

    local targetPlayerName = Players.LocalPlayer.Name
    local playerData = serverData and serverData[targetPlayerName]
    local TARGET_CATEGORY_PATH = playerData and playerData.inventory and playerData.inventory.food

    if TARGET_CATEGORY_PATH and type(TARGET_CATEGORY_PATH) == "table" then
        local categoryItems = TARGET_CATEGORY_PATH
        local list = {}

        for itemKey, itemData in pairs(categoryItems) do
            local instanceId = itemKey
            local typeId = itemKey
            local itemQuantity = 1

            if type(itemData) == "table" then
                typeId = itemData.kind or itemData.id or itemKey
                itemQuantity = itemData.count or itemData.quantity or itemData.amount or 1
            elseif type(itemData) == "number" then
                typeId = itemKey
                itemQuantity = itemData
            end

            local readableName = formatItemName(typeId)

            if itemQuantity > 0 then
                local shortInstanceId = instanceId:sub(1, 8)
                -- Display format: Formatted Name | Unique ID (xQuantity)
                local displayString = string.format("%s | ID: %s (x%d)", readableName, shortInstanceId, itemQuantity)
                table.insert(list, displayString)
                
                -- Populate the map for the Food Dropdown (using the FULL instance ID as the key)
                foodDisplayToUniqueId[displayString] = instanceId
            end
        end

        if #list > 0 then
            return list
        end
    end

    return foodItems
end

