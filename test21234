-- Helper function to convert MM:SS string to total seconds
local function parseTime(timeString)
    -- Expects format "MM:SS" (e.g., "00:25")
    local minutes, seconds = timeString:match("(%d+):(%d+)")
    if minutes and seconds then
        return tonumber(minutes) * 60 + tonumber(seconds)
    end
    return 0 -- Return 0 if parsing fails
end

-- Function to simulate click events (uses executor function 'getconnections')
local function clickButton(button)
    if not isTeleporting then return end -- Operational guard

    if button and getconnections then
        -- *** FULL MOUSE 1 EVENT FIRING SEQUENCE (Down, Click, Up) ***
        
        -- 1. Down (Press)
        for _, connection in pairs(getconnections(button.MouseButton1Down)) do
            connection:Fire()
        end
        task.wait(0.1) -- Delay (Using task.wait for modern Lua environment)
        
        -- 2. Click (The moment the action is registered)
        for _, connection in pairs(getconnections(button.MouseButton1Click)) do
            connection:Fire()
        end
        task.wait(0.1) -- Delay
        
        -- 3. Up (Release)
        for _, connection in pairs(getconnections(button.MouseButton1Up)) do
            connection:Fire()
        end
        print("Successfully clicked the button:", button.Name)
        
    elseif button then
        -- Fallback for standard LocalScripts (only supports Mouse1 click)
        print("Button found, but getconnections is unavailable. Using standard click:", button.Name)
        button:Click() 
    else
        print("Button not found!")
    end
end

-- --- NATIVE STATUS UI CREATION (Redesigned to parent to existing UI with continuous searching) ---
local function createNativeDoorStatusUI()
    local playerGui = player.PlayerGui
    local parentInstance = nil
    local maxWaitTime = 60 -- Wait up to 60 seconds before giving up on the native parent
    local elapsedTime = 0
    
    -- --- ROBUST CONTINUOUS SEARCH FOR PARENT UI ---
    local targetParentFrame = nil
    
    -- Since this runs in a separate thread, we can update the console immediately
    print("[UI_THREAD] Searching for HauntletFarmUI parent continuously...")

    repeat
        -- Check if the player is still active
        if not player or not player.Parent then break end 
        
        local hauntletUI = playerGui:FindFirstChild("HauntletFarmUI")
        if hauntletUI then
            local mainFrame = hauntletUI:FindFirstChild("MainFrame")
            local contentFrame = mainFrame and mainFrame:FindFirstChild("ContentFrame")
            
            if contentFrame and contentFrame:IsA("Frame") then
                targetParentFrame = contentFrame
                break -- Exit the loop, we found the target
            end
        end
        
        -- Wait briefly and update time
        task.wait(0.5)
        elapsedTime = elapsedTime + 0.5
        
    until targetParentFrame or elapsedTime >= maxWaitTime

    -- --- PARENTING LOGIC ---
    if targetParentFrame then
        print("[UI_THREAD] Found HauntletFarmUI parent. Inserting Teleporter UI inside.")
        parentInstance = targetParentFrame
    else
        print("[UI_THREAD] HauntletFarmUI parent path not found or timed out. Creating local ScreenGui (Fallback).")
        -- Fallback: Create a local ScreenGui if the target is missing or corrupted
        local ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "TeleporterUI"
        ScreenGui.DisplayOrder = 999 
        ScreenGui.Enabled = true
        ScreenGui.Parent = playerGui
        parentInstance = ScreenGui -- The MainFrame will be parented to this ScreenGui
    end

    -- Check for existing MainFrame within the chosen parent
    local existingUi = parentInstance:FindFirstChild("TeleporterMainFrame")
    if existingUi then
        existingUi:Destroy() -- Destroy any old instance to ensure a fresh start
    end
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "TeleporterMainFrame"
    MainFrame.BackgroundColor3 = Color3.new(0.05, 0.05, 0.05) 
    MainFrame.BorderSizePixel = 0
    
    -- Size and Positioning Logic
    if parentInstance.ClassName == "ScreenGui" then
        -- If parented to ScreenGui (Fallback, old behavior - bottom left)
        MainFrame.Size = UDim2.new(0.3, 0, 0.08, 0) -- Original size
        MainFrame.AnchorPoint = Vector2.new(0, 1)   -- Original anchor
        MainFrame.Position = UDim2.new(0.05, 0, 0.95, 0) -- Original position
    else
        -- If parented to existing Frame (New behavior - make it flexible/vertical)
        MainFrame.Size = UDim2.new(1, 0, 0.35, 0) -- Takes 100% width, 35% height of the ContentFrame
        MainFrame.Position = UDim2.new(0, 0, 0, 0) -- Start at top-left of parent frame
        
        -- Add UIListLayout for vertical stacking within the new parent frame
        local verticalLayout = Instance.new("UIListLayout")
        verticalLayout.FillDirection = Enum.FillDirection.Vertical
        verticalLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        verticalLayout.Parent = MainFrame
    end
    
    -- Add UICorner for rounded look
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = MainFrame
    
    -- Top Status Bar (Black)
    local StatusLabel = Instance.new("TextLabel")
