do
    local ShopTab = Tabs.Shop
    local autoBuyTask = nil
    local PurchaseStatusLabel = nil

    local function getItemDetailsByName(itemName)
        for _, item in ipairs(allBuyableItems) do
            if item.name == itemName then
                return item.id, item.category, item.defaultCount
            end
        end
        return nil, nil, 1
    end

    local function queuePurchase(selectedItems)
        local purchasedCount = 0
        local failedCount = 0
        local totalItems = #selectedItems

        if totalItems == 0 then
            return "Idle. No items selected."
        end

        print("--- ATTEMPTING BATCH PURCHASE (" .. totalItems .. " items) ---")

        for _, itemName in ipairs(selectedItems) do
            local itemID, itemCategory, buyCount = getItemDetailsByName(itemName)

            if itemID and itemCategory then
                -- Buy count is fixed at 1 for safety, adjust if needed
                local args = {
                    itemCategory,
                    itemID,
                    {
                        buy_count = 1 
                    }
                }

                local success, result = pcall(function()
                    return game:GetService("ReplicatedStorage"):WaitForChild("API"):WaitForChild("ShopAPI/BuyItem"):InvokeServer(unpack(args))
                end)

                if success and result then
                    purchasedCount = purchasedCount + 1
                    print("SUCCESS (Assumed): Purchased " .. itemName .. " (" .. itemID .. "). API Result:", result)
                else
                    failedCount = failedCount + 1
                    local errorMessage = success and "API returned unsuccessful status/nil result." or result
                    print("FAILED: Purchase of " .. itemName .. " failed. Error:", errorMessage)
                end
            else
                failedCount = failedCount + 1
                print("ERROR: Could not find details for item: " .. itemName)
            end

            task.wait(0.1)
        end

        local summary = string.format("Batch finished. Bought: %d, Failed: %d.", purchasedCount, failedCount)

        if not Options.AutoBuyShop.Value then
            Fluent:Notify({
                Title = "Purchase Complete",
                Content = summary,
                Duration = 5
            })
        end

        return summary
    end

    ShopTab:AddParagraph({
        Title = "Item Purchase Queue Manager",
        Content = "Select items below to queue for batch purchase."
    })

    local allItemNames = {}
    for _, item in ipairs(allBuyableItems) do
        table.insert(allItemNames, item.name)
    end

    local ItemSelector = ShopTab:AddDropdown("ItemSelector", {
        Title = "Select Items to Purchase",
        Description = "You can select multiple items to buy.",
        Values = allItemNames,
        Multi = true,
        Default = {"Island Tarsier", "Halloween Spider Box"},
    })

    ItemSelector:OnChanged(function(Value)
        local selected = {}
        for name, state in pairs(Value) do
            if state then
                table.insert(selected, name)
            end
        end
        print("Selected Items to Buy:", table.concat(selected, ", "))
    end)

    ShopTab:AddButton({
        Title = "Select/Deselect All",
        Description = "Toggles the selection of all items in the list.",
        Callback = function()
            local currentSelections = ItemSelector.Value
            local allSelected = true

            for _, name in ipairs(allItemNames) do
                if not currentSelections[name] then
                    allSelected = false
                    break
                end
            end

            local newSelections = {}
            for _, name in ipairs(allItemNames) do
                newSelections[name] = not allSelected
            end

            ItemSelector:SetValue(newSelections)
            print((allSelected and "Deselected" or "Selected") .. " all items.")
        end
    })

    PurchaseStatusLabel = ShopTab:AddParagraph({
        Title = "Purchase Status (Label)",
        Content = "Idle. Ready for manual or auto purchase."
    })

    ShopTab:AddButton({
        Title = "Purchase Selected Items",
        Description = "Executes the purchase command for all selected items.",
        Callback = function()
            local selected = {}
            for name, state in pairs(ItemSelector.Value) do
                if state then
                    table.insert(selected, name)
                end
            end

            local summary = queuePurchase(selected)
            if PurchaseStatusLabel and PurchaseStatusLabel.SetContent then
                PurchaseStatusLabel:SetContent("Manual: " .. summary)
            end
        end
    })

    local AutoBuyToggle = ShopTab:AddToggle("AutoBuyShop", {
        Title = "Enable Auto-Buy Loop",
        Description = "Continuously attempts to buy selected items every 5 seconds.",
        Default = false
    })

    AutoBuyToggle:OnChanged(function(Value)
        if Value then
            autoBuyTask = task.spawn(function()
                while Options.AutoBuyShop.Value do
                    local selected = {}
                    for name, state in pairs(ItemSelector.Value) do
                        if state then
                            table.insert(selected, name)
                        end
                    end

                    local summary = queuePurchase(selected)
                    if PurchaseStatusLabel and PurchaseStatusLabel.SetContent then
                        PurchaseStatusLabel:SetContent("Auto-Buy: " .. summary .. " | Next check in 5s.")
                    end

                    task.wait(5)

                    if Fluent.Unloaded then break end
                end
                if PurchaseStatusLabel and PurchaseStatusLabel.SetContent then
                    PurchaseStatusLabel:SetContent("Auto-Buy: Disabled. Idle.")
                end
                autoBuyTask = nil
            end)
        elseif autoBuyTask then
            task.cancel(autoBuyTask)
            autoBuyTask = nil
        end
        print("Auto-Buy Loop Status:", Value)
    end)
end

