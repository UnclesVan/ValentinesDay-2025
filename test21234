-- Function to find all unique IDs for a given item kind (Type ID)
local function getItemDisplayStringsByKind(targetKind)
    local displayStrings = {}
    local success, serverData = pcall(waitForData)
    
    if not success or not serverData then
        warn("Failed to retrieve server data for items:", serverData)
        return displayStrings
    end
    
    local targetPlayerName = Players.LocalPlayer.Name
    local playerData = serverData and serverData[targetPlayerName]
    local itemCategory = playerData and playerData.inventory and playerData.inventory.food -- Age potion is usually in 'food'

    if itemCategory and type(itemCategory) == "table" then
        for uniqueId, itemData in pairs(itemCategory) do
            local itemKind = nil
            local itemQuantity = 0

            if type(itemData) == "table" then
                itemKind = itemData.kind or itemData.id
                itemQuantity = itemData.count or itemData.quantity or itemData.amount or 1
            elseif type(itemData) == "number" then
                itemKind = uniqueId
                itemQuantity = itemData
            end

            -- Check if it matches the target kind and quantity is > 0
            if itemKind and string.lower(itemKind) == string.lower(targetKind) and itemQuantity > 0 then
                 -- Get the full display string from the food map
                 local displayString = foodDisplayToUniqueId[formatItemName(itemKind) .. " | ID: " .. uniqueId:sub(1, 8) .. " (x" .. tostring(itemQuantity) .. ")"]
                 if displayString then
                    table.insert(displayStrings, displayString)
                 end
            end
        end
    end
    return displayStrings
end

-- Function to parse the pet data and return a list of pets
local function getPetInventoryList()
    local petItems = {"No Pets Found (Retry Script)"}
    local success, serverData = pcall(waitForData)

    -- Clear previous data
    petDisplayToStatus = {}
    petDisplayToUniqueId = {} 

    if not success or not serverData then
        warn("Failed to retrieve server data for pets:", serverData)
        return petItems
    end

    local targetPlayerName = Players.LocalPlayer.Name
    local playerData = serverData and serverData[targetPlayerName]
    local TARGET_CATEGORY_PATH = playerData and playerData.inventory and playerData.inventory.pets

    if TARGET_CATEGORY_PATH and type(TARGET_CATEGORY_PATH) == "table" then
        local playerPets = TARGET_CATEGORY_PATH
        local list = {}
        local firstPetKey = next(playerPets)

        for uniqueId, petData in pairs(playerPets) do
            local speciesId = petData.id or "unknown_id"
            local readableName = PetNames[speciesId] or string.gsub(speciesId, "_", " ")
            local ageString = "Age Data Not Found"

            local isAgeFound = false

            local rawAgeValue = petData.properties and petData.properties.age
            if type(rawAgeValue) == "number" and rawAgeValue >= 0 and rawAgeValue < 100000 then
                ageString = "**Age Stage:** " .. tostring(rawAgeValue)
                isAgeFound = true
            end

            if not isAgeFound then
                local ageTimestamp = petData.created_timestamp or petData.birth_timestamp or petData.creation_timestamp or petData.created

                if not ageTimestamp and petData.properties and type(petData.properties) == "table" then
                    ageTimestamp = petData.properties.created_timestamp or petData.properties.birth_timestamp or petData.properties.created
                end

                if type(ageTimestamp) == "number" and ageTimestamp > 0 then
                    ageString = "**Time Alive:** " .. calculateAge(ageTimestamp)
                    isAgeFound = true
                end
            end

            local shortUniqueId = uniqueId:sub(1, 8)
            -- Pet Display Format: Name (ID: 2_xxxxxx)
            local displayString = string.format("%s (ID: %s)", readableName, shortUniqueId)

            local fullStatusString = string.format("**Pet:** %s\n**Unique ID:** %s\n%s", readableName, uniqueId, ageString)

            table.insert(list, displayString)
            petDisplayToStatus[displayString] = fullStatusString
            petDisplayToUniqueId[displayString] = uniqueId
        end

        if #list > 0 then
            table.sort(list)
            return list
        end
    end

    return petItems
end

