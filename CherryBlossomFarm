-- Function to recursively find MeshParts named "Petal" in all models under Rings
local function findPetalsInRings(parent)
    local petals = {}
    
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("Model") then
            -- Recursively search within models
            local modelPetals = findPetalsInRings(child)
            for _, petal in ipairs(modelPetals) do
                table.insert(petals, petal)
            end
        elseif child:IsA("MeshPart") and child.Name == "Petal" then
            -- Add the MeshPart if its name is "Petal"
            table.insert(petals, child)
        end
    end
    
    return petals
end

-- Function to teleport to MeshParts named "Petal" within nested models in Rings only
local function teleportToRings()
    local rings = workspace:FindFirstChild("Interiors")
        and workspace.Interiors:FindFirstChild("BlossomShakedownInterior")
        and workspace.Interiors.BlossomShakedownInterior:FindFirstChild("Rings")

    local hasTeleported = false

    if rings then
        local petals = findPetalsInRings(rings)  -- Find all "Petal" MeshParts within the nested structures

        for _, petal in ipairs(petals) do
            if humanoidRootPart then
                humanoidRootPart.CFrame = petal.CFrame
                print("Teleported to Petal in Rings:", petal.Name)
                hasTeleported = true
                wait(1)  -- Delay before allowing the next teleportation
                return  -- Exit after teleporting to the first found "Petal" MeshPart
            end
        end
    else
        print("Rings does not exist.")
    end

    if not hasTeleported then
        print("No Petal MeshParts found in Rings to teleport to.")
    end
end

