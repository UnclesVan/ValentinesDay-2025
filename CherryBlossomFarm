-- Function to get the timer text from the associated path
local function getTimerText()
    local minigameGui = playerGui:FindFirstChild("MinigameInGameApp")

    if minigameGui then
        local timerLabelValue = minigameGui:FindFirstChild("Body")
            and minigameGui.Body:FindFirstChild("Left")
            and minigameGui.Body.Left:FindFirstChild("Container")
            and minigameGui.Body.Left.Container:FindFirstChild("ValueLabel")

        if timerLabelValue then
            return timerLabelValue.Text  -- Return the text from the UI
        end
    end
    return "Timer: 0:00"  -- Default if not found
end

-- Function to get the timer value in seconds for logic checks
local function getTimerValueInSeconds()
    local timerText = getTimerText()

    local minutes, seconds = timerText:match("(%d+):(%d+)")
    if minutes and seconds then
        return tonumber(minutes) * 60 + tonumber(seconds)  -- Convert to total seconds
    end
    return 0  -- Default value if parsing fails
end

-- Function to get player's score
local function getPlayerScore()
    local minigameGui = playerGui:FindFirstChild("MinigameInGameApp")

    if minigameGui then
        local scoreLabel = minigameGui:FindFirstChild("Body")
            and minigameGui.Body:FindFirstChild("Right")
            and minigameGui.Body.Right:FindFirstChild("Container")
            and minigameGui.Body.Right.Container:FindFirstChild("ValueLabel")

        if scoreLabel and tonumber(scoreLabel.Text) then
            return tonumber(scoreLabel.Text)
        end
    end 
    return nil 
end

-- Function to update the ValueDisplayLabel with the player's score
local function updateValueDisplay()
    local scoreLabel = getPlayerScore()
    if scoreLabel then
        valueDisplayLabel.Text = "Score: " .. scoreLabel  -- Update the score display
    else
        valueDisplayLabel.Text = "Score: N/A"  -- If not found, show N/A
        warn("ScoreLabel not found!")
    end
end

