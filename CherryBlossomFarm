    -- Get the timer value in seconds for logic checks
    local timerValue = getTimerValueInSeconds()

    -- Check the timer condition for stopping teleportation
    if timerValue == 20 then
        print("Game time has reached 00:20. Stopping teleportation actions.")
        teleportationStopped = true  -- Set flag to prevent actions
    elseif timerValue > 20 then
        -- Only attempt teleportation if it's not been stopped
        if teleportationStopped then
            print("Timer is above 20 seconds now. Resuming actions.")
            teleportationStopped = false  -- Allow actions again
        end

        -- Get the player's score and handle game logic
        local playerScore = getPlayerScore()

        -- Check if the player's score exceeds 40,000 and display a reminder
        if playerScore and playerScore >= 40000 then
            print("Reminder: Your score has reached 40,000!")
            -- You can also use a UI notification instead of print if desired
            -- Example: player:SendNotification({Title = "Score Reminder", Text = "Your score has reached 40,000!"})
        end
        
        -- Teleport to MeshParts named "Petal" within the nested models in Rings only
        teleportToRings()
    end

    -- Delay before the next iteration
    wait(1)
end
