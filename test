local lastequippedPetID = nil

local function getpet()
    local lastequipped, id, chosen = "", "", nil
    local lastpet = nil
    local plrdata = getupvalue(require(game:service("ReplicatedStorage").ClientModules.Core.ClientData).get_data,1)[game:service("Players").LocalPlayer.Name]

    for i, v in pairs(plrdata.last_equipped_pets) do
        lastpet = v
        lastequipped = v
    end

    for _, pet in next, plrdata.inventory and plrdata.inventory.pets do
        local ohTable2 = {
            ["equip_as_last"] = false,
            ["use_sound_delay"] = true
        }
        game:service("ReplicatedStorage").API["ToolAPI/Unequip"]:InvokeServer(pet.unique, ohTable2)

        if pet.unique == lastequipped then
            id = pet.id
            lastequippedPetID = lastequipped
        end
    end

    local found = false
    local connection
    connection = game:service("Workspace").Pets.ChildAdded:Connect(function(pet)
        repeat wait() until pet and pet:FindFirstChild("HumanoidRootPart")
        if pet:IsA("Model") and id:lower():find(pet.Name:lower()) and
            ((pet:FindFirstChild("HumanoidRootPart")).Position - game:service("Players").LocalPlayer.Character.HumanoidRootPart.Position).Magnitude < 10 then
            chosen = pet
            found = true
        end
    end)

    -- Attempt to equip the pet multiple times until it's detected
    local maxAttempts = 5
    local attempt = 0

    while not found and attempt < maxAttempts do
        attempt = attempt + 1
        print("🔄 Attempting to equip pet... (Attempt " .. attempt .. ")")

        for _, pet in next, plrdata.inventory and plrdata.inventory.pets do
            local ohTable2 = {
                ["equip_as_last"] = false,
                ["use_sound_delay"] = true
            }
            game:service("ReplicatedStorage").API["ToolAPI/Unequip"]:InvokeServer(pet.unique, ohTable2)
    
            if pet.unique == lastequipped then
                id = pet.id
                lastequippedPetID = lastequipped
            end
        end
        
        wait(1)

        local ohString1 = lastequipped
        local ohTable2 = {
            ["equip_as_last"] = false,
            ["use_sound_delay"] = true
        }
        game:service("ReplicatedStorage").API["ToolAPI/Equip"]:InvokeServer(ohString1, ohTable2)

        wait(1)
    end

    if found then
		connection:Disconnect()
        if chosen then
            print("✅ Successfully equipped pet:", chosen:GetFullName())
        else
            print("❌ Failed to equip pet: chosen is nil.")
        end
    else
        print("❌ Failed to equip pet after multiple attempts!")
    end

    return lastequipped, id, chosen
end

local function updateLineBox(lines, player)
	if not boxesEnabled then
		for _, line in pairs(lines) do
			line.Visible = false
		end
		lines[5].Visible = false
		return
	end

	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local head = character:FindFirstChild("Head")
		local rootPart = character:FindFirstChild("HumanoidRootPart")

        if not head or not rootPart then
            for _, line in pairs(lines) do
                line.Visible = false
            end
            lines[5].Visible = false
            return
        end

		local headPos, onScreenHead = getWorldToScreen(head.Position)
		local rootPos, onScreenRoot = getWorldToScreen(rootPart.Position)

		if onScreenHead and onScreenRoot then
			local height = math.abs(headPos.Y - rootPos.Y) * 5.5
			local width = height / 1.8

			local topLeft = Vector2.new(headPos.X - width / 2, headPos.Y - height / 3)
			local topRight = Vector2.new(headPos.X + width / 2, headPos.Y - height / 3)
			local bottomLeft = Vector2.new(headPos.X - width / 2, headPos.Y + height / 1.5)
			local bottomRight = Vector2.new(headPos.X + width / 2, headPos.Y + height / 1.5)

			lines[1].From = topLeft
			lines[1].To = topRight
			lines[2].From = topRight
			lines[2].To = bottomRight
			lines[3].From = bottomRight
			lines[3].To = bottomLeft
			lines[4].From = bottomLeft
			lines[4].To = topLeft

			local outlineColor = player.Team == Players.LocalPlayer.Team and ESP["Team Outline Colour"] or ESP["Outline Colour"]
			for _, line in pairs(lines) do
				line.Color = outlineColor
			end

			local filledSquare = lines[5]
			filledSquare.Size = Vector2.new(width, height)
			filledSquare.Position = topLeft
			filledSquare.Visible = Filled.Enabled

			for _, line in pairs(lines) do
				line.Visible = true
			end
			filledSquare.Visible = Filled.Enabled

		else
			for _, line in pairs(lines) do
				line.Visible = false
			end
			lines[5].Visible = false
		end
	else
		for _, line in pairs(lines) do
			line.Visible = false
		end
		lines[5].Visible = false
	end
end


