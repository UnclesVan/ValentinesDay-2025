local function tp(pos, method)
	local hrp = game:service("Players").LocalPlayer.Character.HumanoidRootPart

	if method == "Instant" then
		hrp.CFrame = pos
	elseif method == "Smooth" then
		local TweenService = game:service("TweenService")

		hrp.Anchored = true
		local tween = TweenService:Create(hrp, TweenInfo.new(1), {CFrame = pos})

		tween.Completed:Once(function()
			hrp.Anchored = false
		end)

		tween:Play()
	end
end

