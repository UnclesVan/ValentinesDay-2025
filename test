RegisterSection:AddButton({
	Name = "Choose Register",
	Callback = function()
		local Players = game:service("Players")
		local Workspace = game:service("Workspace")
		local player = Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local root = character:WaitForChild("HumanoidRootPart")
		local mouse = player:GetMouse()
		
		local furniture = Workspace:WaitForChild("HouseInteriors"):WaitForChild("furniture")
		local highlights = {}
		local selectedModel = nil
		
		if getgenv().lastselected then
			getgenv().lastselected:Destroy()
			getgenv().lastselected = nil
		end
		
		local method = "Click"
		
		for _, v in pairs(furniture:GetDescendants()) do
			if v:IsA("Model") and v.Name == "CashRegister" then
				local id = string.match(v.Parent.Name, "f%-%d+")
				if id then
					local highlight = Instance.new("Highlight")
					highlight.Adornee = v
					highlight.FillColor = Color3.fromRGB(255, 255, 0)
					highlight.OutlineColor = Color3.fromRGB(255, 170, 0)
					highlight.FillTransparency = 0.6
					highlight.OutlineTransparency = 0
					highlight.Parent = v
					highlights[v] = highlight
				end
			end
		end
		
		local function selectregister(model)
			if not highlights[model] then return end

			registers["Chosen Register"] = string.match(model.Parent.Name, "f%-%d+")
			getgenv().lastselected = highlights[model]
		
			for m, h in pairs(highlights) do
				if m == model then
					h.FillColor = Color3.fromRGB(0, 255, 0)
					h.OutlineColor = Color3.fromRGB(0, 200, 0)
					h.FillTransparency = 0.6
				else
					h:Destroy()
					highlights[m] = nil
				end
			end
		
			if clickConnection then
				clickConnection:Disconnect()
				clickConnection = nil
			end
		end
		
		if registers.Method == "Click" then
			chosenregister:Set("• Click on a register.")
			clickConnection = mouse.Button1Down:Connect(function()
				local target = mouse.Target
				if target then
					local model = target:FindFirstAncestorWhichIsA("Model")
					if model and highlights[model] then
						selectregister(model)
						chosenregister:Set("• Register found.")
					end
				end
			end)
		elseif registers.Method == "Find Nearest" then
			chosenregister:Set("• Finding nearest register...")
			local closest = nil
			local shortestDist = 1/0
			for model in pairs(highlights) do
				local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
				if hrp then
					local dist = (root.Position - hrp.Position).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closest = model
					end
				end
			end
		
			if closest then
				selectregister(closest)
				chosenregister:Set("• Nearest register found.")
			else
				chosenregister:Set("• No register found.")
			end
		end
	end
})


