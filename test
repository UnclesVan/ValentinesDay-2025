local function fullyloaded(character)
	print("Waiting!")
	if not character then
		return false, "hi0"
	end
	local parts = {
		"HumanoidRootPart", "Humanoid",
		"LeftHand", "RightHand",
		"LeftFoot", "RightFoot",
		"Head"
	}

	for _, v in pairs(parts) do
		if not character:FindFirstChild(v) then
			return false, "hi1"
		end
	end

	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if humanoid and humanoid.Health <= 0 then return false, "hi2" end

	if not character:FindFirstChildOfClass("BodyColors") then return false, "hi3" end

	local accessories = character:FindFirstChild("Accessories")
	if accessories then
		local loaded = true
		for _, v in pairs(accessories:GetChildren()) do
			if not v:IsA("Accessory") then
				loaded = false
				break
			end
		end
		if not loaded then return false, "hi4" end
	end
	return true
end

