local chamsadding
ChamsSection:AddToggle({
	Name = "Enabled",
	Flag = "ChamsEnabled",
	Value = Chams.Enabled or false,
	Callback = function(enabled)
		if enabled then
			for _, player in next, game:service("Players"):GetPlayers() do
				if player.Character and player ~= game:service("Players").LocalPlayer then
					local highlight = Instance.new("Highlight")
					highlight.Name = "ChamsHighlight"
					highlight.Parent = player.Character
					highlight.FillColor = Chams["Fill Colour"]
					highlight.FillTransparency = Chams["Fill Transparency"]
					highlight.OutlineColor = Chams["Outline Colour"]
					highlight.OutlineTransparency = Chams["Outline Transparency"]
					highlight.DepthMode = Chams.Mode
					player.CharacterAdded:Connect(function(character)
						local newHighlight = Instance.new("Highlight")
						newHighlight.Name = "ChamsHighlight"
						newHighlight.Parent = character
						newHighlight.FillColor = Chams["Fill Colour"]
						newHighlight.FillTransparency = Chams["Fill Transparency"]
						newHighlight.OutlineColor = Chams["Outline Colour"]
						newHighlight.OutlineTransparency = Chams["Outline Transparency"]
						newHighlight.DepthMode = Chams.Mode
					end)
				end
			end
			chamsadding = game:service("Players").PlayerAdded:Connect(function(player)
				player.CharacterAdded:Connect(function(character)
					local highlight = Instance.new("Highlight")
					highlight.Name = "ChamsHighlight"
					highlight.Parent = character
					highlight.FillColor = Chams["Fill Colour"]
					highlight.FillTransparency = Chams["Fill Transparency"]
					highlight.OutlineColor = Chams["Outline Colour"]
					highlight.OutlineTransparency = Chams["Outline Transparency"]
				end)
			end)
		else
			for _, player in next, game:service("Players"):GetPlayers() do
				if player.Character then
					for _, child in next, player.Character:GetChildren() do
						if child:IsA("Highlight") and child.Name == "ChamsHighlight" then
							child:Destroy()
						end
					end
				end
			end
			if chamsadding then chamsadding:Disconnect() end
		end
	end
})

