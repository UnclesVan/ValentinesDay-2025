local base85 = {}

local function encode_chunk(chunk)
	local v, encoded = 0, {}
	for i = 1, 4 do v = v * 256 + (chunk:byte(i) or 0) end
	for i = 5, 1, -1 do
		encoded[i] = string.char((v % 85) + 33)
		v = math.floor(v / 85)
	end
	return table.concat(encoded)
end

local function decode_chunk(chunk)
	local v, decoded = 0, {}
	for i = 1, #chunk do v = v * 85 + (chunk:byte(i) - 33) end
	for i = 4, 1, -1 do
		decoded[i] = string.char(v % 256)
		v = math.floor(v / 256)
	end
	return table.concat(decoded)
end

function base85.encode(data)
	local res, padding = {}, (4 - #data % 4) % 4
	data = data .. string.rep('\0', padding)
	for i = 1, #data, 4 do table.insert(res, encode_chunk(data:sub(i, i + 3))) end
	if padding > 0 then res[#res] = res[#res]:sub(1, 5 - padding) end
	return table.concat(res)
end

function base85.decode(encoded)
	local res, padding = {}, (5 - #encoded % 5) % 5
	encoded = encoded .. string.rep('u', padding)
	for i = 1, #encoded, 5 do table.insert(res, decode_chunk(encoded:sub(i, i + 4))) end
	local decoded = table.concat(res)
	return padding > 0 and decoded:sub(1, -padding - 1) or decoded
end

