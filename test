local function finduser(query)
	query = query:lower()
	local method = Player.Method or "Username"

	for _, plr in pairs(game:service("Players"):GetPlayers()) do
		local target = (method == "DisplayName" and plr.DisplayName or plr.Name):lower()

		if target:sub(1, #query) == query then
			if plr.Name == game:service("Players").LocalPlayer.Name then return end
			if workspace:FindFirstChild("PlayerCharacters") and game:service("Workspace").PlayerCharacters:FindFirstChild(plr.Name)  then
				return "found", plr.Name
			else
				return "not_in_map", plr.Name
			end
		end
	end

	return "not_found", nil
end

