local tracers = {}

local function createTracer(player)
    if not player or player == Players.LocalPlayer then return end
    if tracers[player] then return end

	local character = player.Character or player.CharacterAdded:Wait()
	repeat wait() until character:FindFirstChild("HumanoidRootPart")
    local tracerLine = Drawing.new("Line")
    local circle = Drawing.new("Circle")

    tracerLine.Color = Tracers.Colour
    tracerLine.Thickness = Tracers.Thickness
    tracerLine.Transparency = Tracers.Transparency
    tracerLine.Visible = false

    circle.Color = Tracers.Circle.Colour
    circle.Thickness = Tracers.Circle.Thickness
    circle.NumSides = Tracers.Circle.NumSides
    circle.Radius = Tracers.Circle.Radius
    circle.Filled = Tracers.Circle.Filled
    circle.Visible = false

    tracers[player] = {line = tracerLine, circle = circle}

    local connection; connection = game:service("RunService").Heartbeat:Connect(function()
        if not player or not player.Parent or not player.Character then
            if tracerLine then tracerLine:Remove() end
            if circle then circle:Remove() end
            if connection then connection:Disconnect() end
            tracers[player] = nil
            return
        end

        local character = player.Character
        local rootPart = character:FindFirstChild("HumanoidRootPart")

        if rootPart and Tracers.Enabled then
            local tracerPos, onScreen = getWorldToScreen(rootPart.Position)

            if onScreen then
                local fromPos
                if Tracers.From == "Mouse" then
                    fromPos = game:service("UserInputService"):GetMouseLocation()
                elseif Tracers.From == "Bottom" then
                    local camera = game:service("Workspace").CurrentCamera
                    fromPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                else
                    local localCharacter = Players.LocalPlayer.Character
                    if localCharacter and localCharacter:FindFirstChild(Tracers.From) then
                        fromPos, _ = getWorldToScreen(localCharacter[Tracers.From].Position)
                    else
                        local camera = game:service("Workspace").CurrentCamera
                        fromPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    end
                end

                tracerLine.From = fromPos
                tracerLine.To = tracerPos
                tracerLine.Visible = true

                circle.Position = tracerPos
                circle.Radius = Tracers.Circle.Radius
                circle.Visible = Tracers.Circle.Enabled
            else
                tracerLine.Visible = false
                circle.Visible = false
            end
        else
            tracerLine.Visible = false
            circle.Visible = false
        end
    end)

    tracers[player].connection = connection -- Store connection for later cleanup
end

