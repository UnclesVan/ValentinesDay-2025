local function secureRandom(length)
	local randomBytes = {}
	for i = 1, length do
		randomBytes[i] = char(bit32.bxor(math.random(0, 255), os.time() % 256)) -- Combine time-based entropy
	end
	return table.concat(randomBytes)
end

local function generateIV(length)
	return secureRandom(length)
end

local function prng(seed)
	local state = seed % 4294967296
	return function()
		state = (1664525 * state + 1013904223 + (state % 256)) % 42949672296
		return state % 256 * 1000
	end
end

local function generateKeystream(key, iv, length)
	local seed = 0
	for i = 1, #key do
		seed = bit32.bxor(seed, (key:byte(i) * iv:byte((i - 1) % #iv + 1) + 31)) % 4294967296
	end
	local prngFunc = prng(seed)
	local keystream = {}
	for i = 1, length do
		keystream[i] = char(prngFunc())
	end
	return table.concat(keystream)
end

local function hmac_sha256(key, message)
	local blockSize = 64 
	if #key > blockSize then
		key = sha256(key)
	end

	key = key .. string.rep('\0', blockSize - #key)

	local o_key_pad, i_key_pad = {}, {}
	for i = 1, blockSize do
		local byte = key:byte(i)
		o_key_pad[i] = string.char(bit32.bxor(byte, 0x5C))
		i_key_pad[i] = string.char(bit32.bxor(byte, 0x36))
	end

	local innerHash = sha256(table.concat(i_key_pad) .. message)
	return sha256(table.concat(o_key_pad) .. innerHash)
end

local function encrypt(input, key)
	local iv = generateIV(256)
	local keystream = generateKeystream(key, iv, #input)

	local output = {}
	for i = 1, #input do
		local encodedChar = bit32.bxor(input:byte(i), keystream:byte(i))
		output[i] = char(encodedChar)
	end

	local paddingLength = math.random(32, 64)
	local padding = generateIV(paddingLength)

	local hmacValue = hmac_sha256(key, iv .. table.concat(output) .. padding .. char(paddingLength))

	local result = iv .. table.concat(output) .. padding .. char(paddingLength) .. hmacValue
	local base85Result = base85.encode(result)

	return base85Result
end


local function decrypt(input, key)
	local decoded = base85.decode(input)

	local iv = decoded:sub(1, 256)
	local hmacValue = decoded:sub(-64)
	local paddingLength = decoded:byte(-65)
	local encryptedData = decoded:sub(257, -66 - paddingLength)
	local keystream = generateKeystream(key, iv, #encryptedData)
	local output = {}
	for i = 1, #encryptedData do
		local decodedChar = bit32.bxor(encryptedData:byte(i), keystream:byte(i))
		output[i] = char(decodedChar)
	end

	return table.concat(output)
end
