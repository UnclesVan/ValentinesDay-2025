				wait(.1)
	
				game:service("ReplicatedStorage").API["AdoptAPI/EjectBaby"]:FireServer(ohInstance1)
				-- print("Ejected baby")
                
			end
		end
		local current = task
		repeat
			wait(0.5)
			task = checktask(id)
		until task ~= current
		lasttask = current

		continue
	end
end
else
	getgenv().enabled = false
	getgenv().mainLoopRunning = false
	if getgenv().charAddedConnection then getgenv().charAddedConnection:Disconnect() end
	getgenv().charAddedConnection = nil
	getgenv().loopTask = nil
		end
	end,
})

