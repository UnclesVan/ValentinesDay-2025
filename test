local savedpos
local positionMarkerPart
local highlight

AdditionalSection:AddButton({
	Name = "Save Position",
	Callback = function()
		local player = game:service("Players").LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local rootPart = character:WaitForChild("HumanoidRootPart")

		savedpos = rootPart.Position

		if positionMarkerPart then
			positionMarkerPart:Destroy()
			positionMarkerPart = nil
		end

		positionMarkerPart = Instance.new("Part")
		positionMarkerPart.Size = Vector3.new(1,1,1)
		positionMarkerPart.Anchored = true
		positionMarkerPart.CanCollide = false
		positionMarkerPart.Transparency = 1
		positionMarkerPart.Position = savedpos
		positionMarkerPart.Name = "SavedPositionMarker"
		positionMarkerPart.Parent = workspace

		highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(0, 255, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.25
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = positionMarkerPart
	end
})

AdditionalSection:AddButton({
	Name = "Teleport to Saved Position",
	Callback = function()
		if savedpos then
			local player = game:service("Players").LocalPlayer
			local character = player.Character or player.CharacterAdded:Wait()
			local rootPart = character:WaitForChild("HumanoidRootPart")

			rootPart.CFrame = CFrame.new(savedpos)

			task.spawn(function()
				repeat
					task.wait(0.1)
				until (rootPart.Position - savedpos).Magnitude <= 1

				if positionMarkerPart then
					positionMarkerPart:Destroy()
					positionMarkerPart = nil
					highlight = nil
				end
			end)
		end
	end
})



