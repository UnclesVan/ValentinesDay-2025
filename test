local function adjustSizeBasedOnDistance(object, distance, baseSize, minSize, maxSize)
---@diagnostic disable-next-line: undefined-field
	object.Size = math.clamp(baseSize * math.clamp(100 / distance, 0.5, 1.5), minSize, maxSize)
