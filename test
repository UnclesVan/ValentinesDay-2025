local NameDisplayMode = NameESP.Mode

local studsToFeet = 3.28084
local studsToMeters = 0.28

local function getDistanceText(localPlayer, targetPlayer)
	if not localPlayer.Character or not targetPlayer.Character then
		return "N/A"
	end

	local localPlayerRoot = localPlayer.Character:FindFirstChild("HumanoidRootPart")
	local targetPlayerRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

	if localPlayerRoot and targetPlayerRoot then
		local distance = (localPlayerRoot.Position - targetPlayerRoot.Position).Magnitude or 0
		local unit = NameESP.Distance.Unit or "Studs"

		if unit == "Feet" then
			local formattedDistance = tonumber(string.format("%.2f", (distance or 0) * studsToFeet))
			return formattedDistance and math.floor(formattedDistance) .. "ft" or "N/A"
		elseif unit == "Meters" then
			local meters = tonumber(string.format("%.2f", distance * studsToMeters))
			return meters and math.floor(meters) .. "m" or "N/A"
		else
			local formattedDistance = tonumber(string.format("%.2f", distance))
			return formattedDistance and math.floor(formattedDistance) .. "st" or "N/A"
		end
	else
		return "N/A"
	end
end


local function updateNameTag(nameTag, player)
	if not tracers[player] or not tracers[player].nameTag then return end

	local character = player.Character
	if character and character:FindFirstChild("Head") and character:FindFirstChild("Humanoid") then
		local headPos, onScreen = getWorldToScreen(character.Head.Position)



		if onScreen then
			local humanoid = character:FindFirstChild("Humanoid")
			local currentHealth = humanoid and math.floor(humanoid.Health) or 0
			local maxHealth = humanoid and math.floor(humanoid.MaxHealth) or 0

			local displayText = (NameESP.Mode == "Username") and player.Name or player.DisplayName

			if NameESP["Health"]["Enabled"] then
				displayText = displayText .. " / <" .. currentHealth .. "/" .. maxHealth .. ">"
			end

			if NameESP.Distance.Enabled then
				displayText = displayText .. " / " .. getDistanceText(Players.LocalPlayer, player)
			end

			nameTag.Text = displayText
			nameTag.Position = Vector2.new(headPos.X, headPos.Y - 25)
			nameTag.Visible = true
		else
			nameTag.Visible = false
		end
	else
		nameTag.Visible = false
	end
end

local function createNameTag(player)
	if player == Players.LocalPlayer then return end

	local nameTag = Drawing.new("Text")

	nameTag.Size = NameESP["Base Size"]
	nameTag.Color = NameESP["Text Colour"]
	nameTag.Transparency = NameESP.Transparency
	nameTag.Center = NameESP.Center
	nameTag.Outline = NameESP.Outline
	nameTag.OutlineColor = NameESP["Outline Colour"]
	nameTag.Font = NameESP.Font
	nameTag.Visible = false

	tracers[player] = { nameTag = nameTag }

	updateNameTag(nameTag, player)

	local updateConnection = game:service("RunService").Heartbeat:Connect(function()
		if player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") and NameESP.Enabled then
			updateNameTag(nameTag, player)
		else
			nameTag.Visible = false
		end
	end)

	table.insert(nameESPConnections, updateConnection)

	player.CharacterAdded:Connect(function(character)
		if tracers[player] and tracers[player].nameTag then
			tracers[player].nameTag:Remove()
		end

		createNameTag(player)
	end)
end


local function applyNameTagMode()
	for _, player in pairs(Players:GetPlayers()) do
		if tracers[player] and tracers[player].nameTag then
			updateNameTag(tracers[player].nameTag, player)
		end
	end
end

local function removeAllNameTags()
	for _, connection in pairs(nameESPConnections) do
		connection:Disconnect()
	end
	for _, playerTracers in pairs(tracers) do
		if playerTracers.nameTag then
			playerTracers.nameTag:Remove()
		end
	end
	tracers = {}
	nameESPConnections = {}
end

local function toggleNameESP(enabled)
	if enabled then
		for _, player in pairs(Players:GetPlayers()) do
			createNameTag(player)
		end

		table.insert(nameESPConnections, Players.PlayerAdded:Connect(createNameTag))

		for _, player in pairs(Players:GetPlayers()) do
			player.CharacterAdded:Connect(function()
				createNameTag(player)
			end)
		end
