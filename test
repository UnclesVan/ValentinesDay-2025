	local function createShopSection(tab, sectionName, shopData, shopType, side)
		local itemNames, selectedID = {}, ""
		local section = tab:CreateSection({ Name = sectionName , Side = side or "Left" })
	
		local costLabel = section:AddLabel({ Text = "💰 Cost: $0" })
		local rarityLabel = section:AddLabel({ Text = "❓ Rarity: N/A" })
		local statusLabel = section:AddLabel({ Text = "• Status: N/A" })
	
		for id, item in pairs(shopData) do
			if tonumber(item.cost) then
				table.insert(itemNames, item.name)
			end
		end
	
		section:AddDropdown({
			Name = "Select an item",
			Value = "Please select...",
			Callback = function(selected)
				for id, item in pairs(shopData) do
					if item.name == selected then
						selectedID = id
						costLabel:Set("💰 Cost: $" .. tostring(item.cost):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", ""))
						rarityLabel:Set((rarityemojis[item.rarity] or "❓") .. " Rarity: " .. (item.rarity and (item.rarity:sub(1,1):upper() .. item.rarity:sub(2)) or "N/A"))
						break
					end
				end
			end,
			List = itemNames
		})
	
		section:AddButton({ 
			Name = "Purchase",
			Callback = function()
				if selectedID == "" then
					statusLabel:Set("• Status: No item selected.")
					return
				end
	
				local inventory = getupvalue(require(game:service("ReplicatedStorage").ClientModules.Core.ClientData).get_data, 1)[game:service("Players").LocalPlayer.Name].inventory[shopType] or {}
				local countBefore = 0
				for _, _ in pairs(inventory) do countBefore = countBefore + 1 end
	
				game:service("ReplicatedStorage").API["ShopAPI/BuyItem"]:InvokeServer(shopType, selectedID, {})
				wait(1)
	
				local countAfter = 0
				for _, _ in pairs(inventory) do countAfter = countAfter + 1 end
			end
		})
	
		section:AddLabel({ Text = "Some purchases may not work" })
		section:AddLabel({ Text = "due to being in a different" })
		section:AddLabel({ Text = "map or area." })
	end
	
