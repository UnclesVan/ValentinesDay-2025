            </div>
        else
            warn(string.format("[Utility Debug] Invalid path component type or format: %s (Expected string or {type='index', value=N}).", tostring(component)))
            return nil, "InvalidComponent"
        end

        if foundChild then
            currentParent = foundChild
        else
            warn(string.format("[Utility Debug] Could not find component '%s' under '%s'.",
                (type(component)=="string" and component or tostring(component.value)), currentParentName))
            return nil, "ComponentNotFound"
        end
    end

    if currentParent and currentParent:IsA("BasePart") then
        return currentParent, constructedPathString
    else
        warn(string.format("[Utility Debug] Final target is not a BasePart or not found. Found type: %s, value: %s.",
            typeof(currentParent), tostring(currentParent)))
        return nil, "FinalTargetNotBasePart"
    end
end

-- Function to perform a single float-teleport
local function performFloatTeleport(targetEntry)
    local currentCharacter, currentHrp, currentHumanoid = getCharacterAndHRP()
    if not currentHrp or not currentHumanoid then
        log("[Utility] Teleport: HRP or Humanoid not found. Cannot perform teleport.")
        return
    end

    local targetPart = targetEntry.part
    local debugPath = targetEntry.debugPath

    if targetPart and targetPart:IsA("BasePart") then
        -- Check if the target is one of the "Boat" RopeStart locations
        if debugPath:find("Boat.RopeStart") or debugPath:find(":GetChildren%[2%].RopeStart") then
            log("finding bonk minigame interior boat....", '["TIME"]')
        end

        log("[Utility] Teleport: Calculating CFrame for " .. targetPart.Name .. " (Path: " .. debugPath .. ")")
        local targetPosition = targetPart.CFrame.Position
        local newCFrame = CFrame.new(targetPosition + Vector3.new(0, currentHrp.Size.Y / 2 + 0.1, 0))

        currentHrp.CFrame = newCFrame
        log("Teleported to " .. targetPart.Name .. " at " .. tostring(targetPosition))

        -- Set hover height if not already set, or update it if we just teleported
        if not HoverHeight then
            HoverHeight = targetPosition.Y + currentHrp.Size.Y / 2 + 0.1
            log("[Utility] Floating: Initial HoverHeight set to " .. string.format("%.2f", HoverHeight) .. " after teleport.")
        end

        -- Reapply the BodyPosition to keep floating in place
        if not isFloating then
            toggleFloating() -- Activate floating if not already active
        else
            local bodyPosition = currentHrp:FindFirstChild("WRDBodyPosition")
            if not bodyPosition then
                bodyPosition = Instance.new("BodyPosition")
                bodyPosition.Name = "WRDBodyPosition"
                bodyPosition.Parent = currentHrp
                log("[Utility] Teleport: Re-created BodyPosition during teleport.")
            end
            bodyPosition.Position = Vector3.new(targetPosition.X, HoverHeight, targetPosition.Z)
            bodyPosition.MaxForce = FloatMaxForce
            bodyPosition.P = FloatP
            bodyPosition.D = FloatD
            currentHumanoid.WalkSpeed = 0
            currentHumanoid.Sit = false
        end
    else
        warn("Invalid target part for teleport. TargetEntry: " .. tostring(targetEntry) .. ", Part: " .. tostring(targetPart))
        log("Invalid target part for teleport. Path: " .. debugPath)
    end
end

-- Helper function to format path components for printing
local function formatPathComponentsForPrint(componentsTable)
    local formatted = {}
    for _, comp in ipairs(componentsTable) do
        if type(comp) == "string" then
            table.insert(formatted, comp)
        elseif type(comp) == "table" and comp.type == "index" then
            table.insert(formatted, "GetChildren()[" .. comp.value .. "]")
        else
            table.insert(formatted, tostring(comp)) -- Fallback for unexpected types
        end
    end
    return table.concat(formatted, ".")
end

