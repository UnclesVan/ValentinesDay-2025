-- Function to toggle Floating (using BodyPosition)
local function toggleFloating()
    isFloating = not isFloating -- Flip the state

    local currentCharacter, currentHrp, currentHumanoid = getCharacterAndHRP()
    if not currentHrp or not currentHumanoid then
        log("[Utility] Floating: HRP or Humanoid not found. Cannot toggle floating.")
        isFloating = false -- Reset state if dependencies are missing
        return
    end

    if isFloating then
        log("[Utility] Floating: Attempting to turn ON (Stable in-place floating).")
        local bodyPosition = currentHrp:FindFirstChild("WRDBodyPosition")
        if not bodyPosition then
            bodyPosition = Instance.new("BodyPosition")
            bodyPosition.Name = "WRDBodyPosition"
            bodyPosition.Parent = currentHrp
            log("[Utility] Floating: Created new BodyPosition.")
        end
        -- Set hover height to current height if not set yet
        if not HoverHeight then
            HoverHeight = currentHrp.CFrame.Position.Y
            log("[Utility] Floating: Initial HoverHeight set to " .. string.format("%.2f", HoverHeight))
        end
        -- Set target position (X,Z stay same, Y fixed)
        local currentPos = currentHrp.CFrame.Position
        bodyPosition.Position = Vector3.new(currentPos.X, HoverHeight, currentPos.Z)
        bodyPosition.MaxForce = FloatMaxForce
        bodyPosition.P = FloatP
        bodyPosition.D = FloatD
        currentHumanoid.WalkSpeed = 0 -- Stop horizontal movement while truly floating
        currentHumanoid.Sit = false -- Ensure not sitting
        log("[Utility] Floating: ON at height " .. string.format("%.2f", HoverHeight))
    else
        log("[Utility] Floating: Attempting to turn OFF.")
        local bodyPosition = currentHrp:FindFirstChild("WRDBodyPosition")
        if bodyPosition then
            bodyPosition:Destroy()
            log("[Utility] Floating: Destroyed BodyPosition.")
        end
        if originalWalkSpeed then
            currentHumanoid.WalkSpeed = originalWalkSpeed -- Restore original walkspeed
        end
        log("[Utility] Floating: OFF.")
    end
end

