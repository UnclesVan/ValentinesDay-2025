-- Handles teleportation to "raider" models near the GoldPile
local function handleTeleportToModels()
    if not scriptEnabled then
        log("Teleportation: Script is disabled.")
        return
    end
    if not teleportToRaidersActive then
        log("Teleportation: Feature is disabled.")
        return
    end

    local petsContainer = findPetsContainer()
    if not petsContainer then
        log("Teleportation: Pets container not found.")
        return
    end

    local character, hrp = getCharacterAndHRP()
    if not character or not hrp then
        log("Teleportation: Character or HumanoidRootPart not found.")
        return
    end

    local bonkInterior = findCoconutBonkInterior()
    if not bonkInterior then
        log("Teleportation: CoconutBonkInterior not found.")
        return
    end

    local gameFolder = bonkInterior:FindFirstChild("Game")
    local goldPileRoot = gameFolder and gameFolder:FindFirstChild("GoldPile") and gameFolder.GoldPile:FindFirstChild("Root")
    if not goldPileRoot or not goldPileRoot:IsA("BasePart") then
        log("Teleportation: No valid GoldPile Root for raider detection.")
        return
    end
    local goldPos = goldPileRoot.Position
    log("Teleportation: GoldPile Root found at " .. tostring(goldPos))

    local raiderFound = false
    for _, model in ipairs(petsContainer:GetChildren()) do
        if model:IsA("Model") then
            local nameLower = model.Name:lower()
            local shouldExclude = false
            for _, keyword in ipairs(EXCLUDED_MODEL_KEYWORDS) do
                if nameLower:find(keyword) then
                    shouldExclude = true
                    break
                end
            end

            if not shouldExclude then
                local targetPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
                if targetPart and targetPart:IsA("BasePart") then
                    local dist = (targetPart.Position - goldPos).magnitude
                    log(string.format("Teleportation: Checking model '%s', distance to GoldPile: %.2f studs.", model.Name, dist))
                    if dist <= GOLD_PILE_GUARD_RADIUS then
                        raiderFound = true
                        log("Threat: " .. model.Name .. " within guard radius (" .. math.floor(dist) .. " studs). Attempting teleport.")
                        local teleportPos = targetPart.Position + Vector3.new(0, 5, 0) -- Teleport slightly above
                        local lookAtPos = targetPart.Position -- Look at the raider's position
                        if hrp and hrp.Parent == character then
                            local success, err = pcall(function()
                                hrp.CFrame = CFrame.lookAt(teleportPos, lookAtPos)
                            end)
                            if not success then
                                warn("Teleport failed for " .. model.Name .. ": " .. tostring(err))
                                log("Teleportation: Failed to teleport to " .. model.Name .. ": " .. tostring(err))
                            else
                                log("Teleportation: Successfully teleported to " .. model.Name .. ".")
                                wait(0.005) -- Small wait after teleport
                            end
                        else
                            log("Teleportation: HRP not valid for teleport (parent issue).")
                        end
                        -- We teleport to the first detected raider and then return to let the loop continue
                        -- This ensures we only teleport to one raider per call, then re-evaluate.
                        return
                    end
                else
                    log("Teleportation: Model '" .. model.Name .. "' has no valid PrimaryPart or HumanoidRootPart for teleport.")
                end
            else
                log("Teleportation: Excluding model '" .. model.Name .. "' due to keyword match.")
            end
        else
            log("Teleportation: Skipping non-model instance in Pets container: " .. model.Name)
        end
    end
    if not raiderFound then
        log("Teleportation: No raiders found within guard radius after checking all pets.")
    end
end

-- Checks the current score and adjusts actions (pauses/resumes hotbar abilities)
local function checkScoreAndAdjustActions()
    local success, valueLabel = pcall(function()
        return playerGui:WaitForChild("MinigameInGameApp", 5)
            :WaitForChild("Body", 5)
            :WaitForChild("Right", 5)
            :WaitForChild("Container", 5)
            :WaitForChild("ValueLabel", 5)
    end)

    if not success or not valueLabel or not valueLabel:IsA("TextLabel") then
        log("❌ ValueLabel not found or not TextLabel after waiting.")
        return
    end
    logFinding("score_label", "Score ValueLabel", true)

    local currentScore = tonumber(valueLabel.Text)
    if not currentScore then
        log("Could not parse score: " .. tostring(valueLabel.Text))
        return
    end

    local upperThreshold = TARGET_SCORE + SCORE_UPPER_TOLERANCE
    local lowerThreshold = TARGET_SCORE - SCORE_LOWER_TOLERANCE
    if currentScore > upperThreshold and scoreIncreasingActionsAllowed then
        scoreIncreasingActionsAllowed = false
        log(string.format("Score %d > upper threshold. Pausing actions.", currentScore))
    elseif currentScore < lowerThreshold and not scoreIncreasingActionsAllowed then
        scoreIncreasingActionsAllowed = true
        log(string.format("Score %d < lower threshold. Resuming actions.", currentScore))
    end
    log("Score: " .. currentScore)
end

