local Players = game:GetService("Players")
local workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- Function to clear the Interiors folder before setting new maps
local function clearInteriorsFolder()
    local interiorsFolder = workspace:FindFirstChild("Interiors")
    if not interiorsFolder then
        -- Create the folder if it doesn't exist
        interiorsFolder = Instance.new("Folder")
        interiorsFolder.Name = "Interiors"
        interiorsFolder.Parent = workspace
        print("Created Interiors folder")
    else
        -- Clear all children
        for _, child in ipairs(interiorsFolder:GetChildren()) do
            child:Destroy()
        end
        print("Cleared Interiors folder")
    end
    return interiorsFolder
end

-- Function to apply transparency to all "CoffeeShop", "Beach", and "Campsite" models
local function applyTransparencyToModels()
    local interiorsFolder = workspace:FindFirstChild("Interiors")
    if not interiorsFolder then 
        print("Interiors folder not found")
        return 
    end

    local function setTransparency(model)
        if not model then return end
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Transparency = 0
                descendant.CanCollide = false
            end
        end
    end

    local function findAllModelsByName(parentFolder, modelName)
        local modelsFound = {}
        if not parentFolder then return modelsFound end
        for _, child in ipairs(parentFolder:GetChildren()) do
            if child.Name == modelName then
                table.insert(modelsFound, child)
            end
            -- Search nested folders
            if child:IsA("Folder") then
                for _, nested in ipairs(child:GetChildren()) do
                    if nested.Name == modelName then
                        table.insert(modelsFound, nested)
                    end
                end
            end
        end
        return modelsFound
    end

    -- Search in MainMap!Default
    local mainMap = interiorsFolder:FindFirstChild("MainMap!Default")
    if mainMap then
        local buildingsFolder = mainMap:FindFirstChild("Buildings")
        if buildingsFolder then
            local coffeeShops = findAllModelsByName(buildingsFolder, "CoffeeShop")
            print("Found " .. #coffeeShops .. " CoffeeShop models")
            for _, shop in ipairs(coffeeShops) do
                setTransparency(shop)
            end
        end
    end

    -- Search in MainMap!Summerfest
    local summerMap = interiorsFolder:FindFirstChild("MainMap!Summerfest")
    if summerMap then
        local buildingsFolder = summerMap:FindFirstChild("Buildings")
        if buildingsFolder then
            local coffeeShops = findAllModelsByName(buildingsFolder, "CoffeeShop")
            print("Found " .. #coffeeShops .. " CoffeeShop models")
            for _, shop in ipairs(coffeeShops) do
                setTransparency(shop)
            end
        end
    end
end

-- Call this once at start
local function initialize()
    clearInteriorsFolder()
    applyTransparencyToModels()
end
initialize()

-- UI setup
local function createStatusUI()
    local gui = Players.LocalPlayer:FindFirstChild("ScreenGui") or Instance.new("ScreenGui", Players.LocalPlayer:WaitForChild("PlayerGui"))
    gui.Name = "TeleportStatusGUI"
    local label = gui:FindFirstChild("StatusLabel")
    if not label then
        label = Instance.new("TextLabel", gui)
        label.Name = "StatusLabel"
        label.Size = UDim2.new(0, 300, 0, 50)
        label.Position = UDim2.new(0.5, -150, 0, 10)
        label.BackgroundColor3 = Color3.new(0, 0, 0)
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextSize = 20
        label.Text = "Idle"
    end
    return label
end
local statusLabel = createStatusUI()

local function updateStatus(text)
    if statusLabel then statusLabel.Text = text end
end

local function countdown(seconds)
    for i=seconds,1,-1 do
        updateStatus("Teleporting in " .. i .. " seconds")
        wait(1)
    end
end

-- Function to create a large platform below the player
local function createPlatformBelowPlayer()
    local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local platformSize = Vector3.new(100, 1, 100)
    local platform = Instance.new("Part")
    platform.Size = platformSize
    platform.Position = Vector3.new(hrp.Position.X, hrp.Position.Y - 2, hrp.Position.Z)
    platform.Anchored = true
    platform.BrickColor = BrickColor.new("Bright green")
    platform.Name = "GeneratedPlatform"
    platform.Parent = workspace
end

-- Wait for TouchToEnter part to exist
local function waitForTouchToEnter()
    local touchPart
    repeat
        touchPart = workspace:FindFirstChild("Interiors")
            and workspace.Interiors:FindFirstChild("MainMap!Default")
            and workspace.Interiors["MainMap!Default"].Doors
            and workspace.Interiors["MainMap!Default"].Doors["CoffeeShop/MainDoor"]
            and workspace.Interiors["MainMap!Default"].Doors["CoffeeShop/MainDoor"].WorkingParts
            and workspace.Interiors["MainMap!Default"].Doors["CoffeeShop/MainDoor"].WorkingParts.TouchToEnter
        if not touchPart then
            wait(0.5)
        end
    until touchPart and touchPart:IsA("BasePart")
    return touchPart
end

-- Download and setup map
local function downloadAndSetupMap(mapToDownload, guiToCloneName, locationToSet)
    updateStatus("Downloading " .. mapToDownload .. "...")
    task.wait(0.1)
    local apiFolder = ReplicatedStorage:WaitForChild("API")
    local downloadFunc = apiFolder:FindFirstChild("DownloadsAPI/Download")
    if downloadFunc and downloadFunc:IsA("RemoteFunction") then
        local success, result = pcall(function()
            return downloadFunc:InvokeServer("Interiors", mapToDownload)
        end)
        if not success then warn("Download error:", result) end
        wait(1)
    end

    updateStatus("Setting " .. mapToDownload .. " location...")
    local setLoc = apiFolder:FindFirstChild("LocationAPI/SetLocation")
    if setLoc then
        local argsSetLoc = {locationToSet}
        if mapToDownload == "MainMap!Default" then
            argsSetLoc = {locationToSet, [3] = locationToSet}
        end
        if setLoc:IsA("RemoteFunction") then
            pcall(function() setLoc:InvokeServer(unpack(argsSetLoc)) end)
        elseif setLoc:IsA("RemoteEvent") then
            pcall(function() setLoc:FireServer(unpack(argsSetLoc)) end)
        end
        wait(1)
    end
    local clone = nil
    if guiToCloneName then
        local player = Players.LocalPlayer
        local gui = player:WaitForChild("PlayerGui"):FindFirstChild(guiToCloneName)
        if gui then
            clone = gui:Clone()
            local interiorsFolder = workspace:FindFirstChild("Interiors") or Instance.new("Folder", workspace)
            if interiorsFolder.Name ~= "Interiors" then interiorsFolder.Name = "Interiors" end
            clone.Name = guiToCloneName
            clone.Parent = interiorsFolder
            gui:Destroy()
        end
    end
    return clone
end

-- Set destination_id to "MainMap" in Interiors
local function setDestinationToMainMap()
    local interiorsFolder = workspace:FindFirstChild("Interiors")
    if not interiorsFolder then
        print("Interiors folder not found")
        return
    end
    local defaultMap = interiorsFolder:FindFirstChild("MainMap!Default")
    if not defaultMap then
        print("MainMap!Default not found")
        return
    end
    local doorsFolder = defaultMap:FindFirstChild("Doors")
    if not doorsFolder then
        print("Doors folder not found in MainMap!Default")
        return
    end
    local mainDoor = doorsFolder:FindFirstChild("CoffeeShop/MainDoor")
    if not mainDoor then
        print("CoffeeShop/MainDoor not found")
        return
    end
    local workingParts = mainDoor:FindFirstChild("WorkingParts")
    if not workingParts then
        print("WorkingParts not found in MainMap!Default.CoffeeShop/MainDoor")
        return
    end
    local config = workingParts:FindFirstChild("Configuration")
    if not config then
        print("Configuration not found in WorkingParts")
        return
    end
    local destinationId = config:FindFirstChild("destination_id")
    if destinationId and destinationId:IsA("StringValue") then
        print("Setting destination_id to 'MainMap'")
        destinationId.Value = "MainMap"
    end
end

-- The main teleport & setup function
local function handleTest(mapName, locationTag, testType)
    spawn(function()
        -- 1. Clear previous interiors
        local interiorsFolder = clearInteriorsFolder()
        -- 2. Download map
        local clonedMapInstance = downloadAndSetupMap(mapName, mapName, locationTag)
        -- 3. Set destination ID *only* for Beach and Camp
        if testType ~= "MainDoor" then
            setDestinationToMainMap()
        end
        -- 4. Wait for TouchToEnter
        local touchPart = waitForTouchToEnter()
        if touchPart then
            local hrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(touchPart.Position + Vector3.new(0, 2, 0))
            end
        end
        -- 5. Countdown
        for i=10,1,-1 do
            updateStatus("Teleporting in " .. i .. " seconds")
            wait(1)
        end
        -- 6. Teleport to target location
        local targetPart
        if testType == "MainDoor" then
            targetPart = workspace.StaticMap and workspace.StaticMap.Park and workspace.StaticMap.Park.AilmentTarget
        elseif testType == "BeachParty" then
            targetPart = workspace.StaticMap and workspace.StaticMap.Beach and workspace.StaticMap.Beach.BeachPartyAilmentTarget
        elseif testType == "Camp" then
            targetPart = workspace.StaticMap and workspace.StaticMap.Campsite and workspace.StaticMap.Campsite.CampsiteOrigin
        end
        if targetPart and targetPart:IsA("BasePart") then
            local hrp = Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 2, 0))
            end
        end
        -- 7. Create platform below player
        createPlatformBelowPlayer()
        print(Players.LocalPlayer.Name .. " has been Teleported to " .. testType)
        updateStatus("Finished")
    end)
end

-- Create buttons
local function createButton(name, yOffset, mapName, locationTag, testType, changeDestID)
    local function callback()
        handleTest(mapName, locationTag, testType)
        if changeDestID then
            setDestinationToMainMap()
        end
    end

    local gui = Players.LocalPlayer:WaitForChild("PlayerGui")
    if not gui:FindFirstChild("UIDebug") then
        local newGui = Instance.new("ScreenGui", gui)
        newGui.Name = "UIDebug"
        newGui.DisplayOrder = 999
    end
    local btn = Instance.new("TextButton", gui:FindFirstChild("UIDebug"))
    btn.Size = UDim2.new(0, 150, 0, 30)
    btn.Position = UDim2.new(0.01, 0, 0.01 + yOffset, 0)
    btn.Text = name
    btn.MouseButton1Click:Connect(function()
        callback()
    end)
end

