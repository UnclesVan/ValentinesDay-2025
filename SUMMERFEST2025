local function getQuestTeleportButton()
    local btn
    local attempts = 0
    local MAX_BUTTON_ATTEMPTS = 100 -- Max 50 seconds (100 * 0.5s)
    log("Starting search for Quest Teleport Button (direct path)...")
    repeat
        -- Use FindFirstChild for each step to ensure nil checks
        local questApp = player.PlayerGui:FindFirstChild("QuestApp")
        local board = questApp and questApp:FindFirstChild("Board")
        local body = board and board:FindFirstChild("Body")
        local contents = body and body:FindFirstChild("Contents")
        local scrollingFrame = contents and contents:FindFirstChild("ScrollingFrame")
        -- Uses direct named child, not index, based on your provided path
        local teleportTemplate = scrollingFrame and scrollingFrame:FindFirstChild("TeleportTemplate")
        local teleportBody = teleportTemplate and teleportTemplate:FindFirstChild("Body")
        local buttonFrame = teleportBody and teleportBody:FindFirstChild("ButtonFrame")
        btn = buttonFrame and buttonFrame:FindFirstChild("Button")

        if not btn then
            log(string.format("Finding Quest Teleport Button (Attempt %d/%d). Path status: QuestApp: %s, Board: %s, Body: %s, Contents: %s, ScrollingFrame: %s, TeleportTemplate: %s, TeleportBody: %s, ButtonFrame: %s, Button: %s",
                attempts + 1, MAX_BUTTON_ATTEMPTS,
                tostring(questApp ~= nil), tostring(board ~= nil), tostring(body ~= nil), tostring(contents ~= nil),
                tostring(scrollingFrame ~= nil), tostring(teleportTemplate ~= nil), tostring(teleportBody ~= nil),
                tostring(buttonFrame ~= nil), tostring(btn ~= nil)))
            wait(0.5)
            attempts = attempts + 1
        end
    until btn or attempts > MAX_BUTTON_ATTEMPTS
    return btn
end

-- Uses the precise path for the teleport ring (lobby entrance)
local function getTeleportRingInstance()
    local ring
    local attempts = 0
    local MAX_RING_ATTEMPTS = 60 -- 30 seconds (60 * 0.5s)
    log("Starting search for Teleport Ring (using MainMap!Summerfest path)...")
    repeat
        local interiors = workspace:FindFirstChild("Interiors")
        local summerfest = interiors and interiors:FindFirstChild("MainMap!Summerfest")
        local joinZone = summerfest and summerfest:FindFirstChild("CoconutBonkJoinZone")

        -- ADDED DIAGNOSTIC LOGGING FOR PRE-CALL CHECKS
        if joinZone then
            log("DEBUG: joinZone found. Typeof(joinZone): " .. typeof(joinZone))
            if typeof(joinZone) ~= "Instance" then
                 log("CRITICAL DEBUG: joinZone is not an Instance! Typeof: " .. typeof(joinZone) .. ". This is highly suspicious. Forcing joinZone to nil.")
                 joinZone = nil -- Force it to nil so the 'and' chain breaks safely
            else
                log("DEBUG: Type of joinZone.FindFirstChild: " .. type(joinZone.FindFirstChild))
                if type(joinZone.FindFirstChild) ~= "function" then
                    log("CRITICAL DEBUG: joinZone.FindFirstChild is NOT a function! Type: " .. type(joinZone.FindFirstChild) .. ". This indicates environment tampering. Forcing joinZone to nil.")
                    joinZone = nil -- If FindFirstChild is not a function, setting joinZone to nil will prevent the call
                end
            end
        else
            log("DEBUG: joinZone is nil. Skipping direct FindFirstChild access.")
        end

        -- Wrap the actual problematic call in pcall to catch errors from it directly
        local success, result = pcall(function()
            return joinZone and joinZone:FindFirstChild("Ring")
        end)

        if not success then
            log("CRITICAL ERROR caught in getTeleportRingInstance for FindFirstChild('Ring'): " .. tostring(result) ..
                ". Debug Info: joinZone was: " .. tostring(joinZone) ..
                ", typeof(joinZone): " .. typeof(joinZone) ..
                ", type(joinZone.FindFirstChild): " .. (joinZone and type(joinZone.FindFirstChild) or "N/A (joinZone nil)"))
            ring = nil -- Ensure ring is nil if the pcall fails
        else
            ring = result
        end

        if not ring then
            log(string.format("Finding Teleport Ring (Attempt %d/%d). Path status: Interiors: %s, Summerfest: %s, JoinZone: %s, Ring: %s",
                attempts + 1, MAX_RING_ATTEMPTS,
                tostring(interiors ~= nil), tostring(summerfest ~= nil), tostring(joinZone ~= nil), tostring(ring ~= nil)))
            wait(0.5)
            attempts = attempts + 1
        end
    until ring or attempts > MAX_RING_ATTEMPTS
    return ring
end

