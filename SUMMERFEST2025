-- Finds the CoconutBonkInterior instance
local function findCoconutBonkInterior()
    -- Check in workspace.Interiors first
    if workspace:FindFirstChild("Interiors") then
        for _, interior in ipairs(workspace.Interiors:GetChildren()) do
            if interior.Name:find(COCONUT_BONK_INTERIOR_BASE_NAME, 1, true) then
                logFinding("bonk_interior", "CoconutBonkInterior (in Interiors)", true)
                return interior
            end
        end
    else
        logFinding("bonk_interior_base", "workspace.Interiors", false)
    end

    -- If not found in Interiors, check in workspace.Housing
    if workspace:FindFirstChild("Housing") then
        for _, interior in ipairs(workspace.Housing:GetChildren()) do
            if interior.Name:find(COCONUT_BONK_INTERIOR_BASE_NAME, 1, true) then
                logFinding("bonk_interior", "CoconutBonkInterior (in Housing)", true)
                return interior
            end
        end
    end

    logFinding("bonk_interior", "CoconutBonkInterior (overall)", false)
    return nil
end

-- Finds the Pets container within the minigame interior
local function findPetsContainer()
    local interior = findCoconutBonkInterior()
    if not interior then return nil end
    local gameFolder = interior:FindFirstChild("Game")
    if gameFolder then
        local bins = gameFolder:FindFirstChild("Bins")
        if bins then
