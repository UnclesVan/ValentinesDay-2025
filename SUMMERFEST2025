                            log("CRITICAL ERROR: CharacterAdded:Wait() failed! Error: " .. tostring(charWaitResult))
                            log("Attempting to use player.Character one last time before aborting.")
                            currentCharacter = player.Character -- Fallback just in case something changed immediately after wait
                        end
                    else
                        log("CRITICAL ERROR: player.CharacterAdded is NOT an RBXScriptSignal! Typeof: " .. typeof(charAddedEvent) .. ". Cannot use :Wait().")
                        -- currentCharacter remains nil
                    end
                end

                -- Check if character is still valid after potential yield or if it was initially nil
                if not currentCharacter or not currentCharacter:IsDescendantOf(workspace) then
                     log("❌ Character became invalid or missing during ON-toggle teleport sequence. Aborting teleport.")
                     return -- Exit the handler early if character is invalid
                end

                local currentHumanoidRootPart = currentCharacter:FindFirstChild("HumanoidRootPart")
                log("DEBUG: Found currentHumanoidRootPart: " .. tostring(currentHumanoidRootPart) .. ", IsA('Part'): " .. tostring(currentHumanoidRootPart and currentHumanoidRootPart:IsA("Part")))

                if currentHumanoidRootPart and currentHumanoidRootPart:IsA("Part") then -- Ensure it's a Part
                    local teleportRing = getTeleportRingInstance() -- This call should trigger its own logs
                    if teleportRing then
                        log("✅ Teleport Ring found! Teleporting to join zone...")

                        -- Final check for HumanoidRootPart validity immediately before CFrame assignment
                        if currentHumanoidRootPart.Parent == currentCharacter then -- Simple check if it's still parented
                            currentHumanoidRootPart.CFrame = teleportRing.CFrame + Vector3.new(0, 5, 0)
                            wait(0.5) -- Small wait after teleport
                        else
                            log("Warning: HumanoidRootPart became invalid (e.g., unparented or destroyed) before CFrame assignment. Skipping teleport.")
                        end
                    else
                        log("❌ Failed to find Teleport Ring for ON-toggle teleport (after searching).")
                    end
                else
                    log("❌ HumanoidRootPart was NOT FOUND or was invalid for teleport (after character found).")
                end
            end
        end) -- End of pcall function
        if not success then
            log("CRITICAL ERROR in Toggle Button Click Handler (outer pcall): " .. tostring(err))
        end
    end)
end


