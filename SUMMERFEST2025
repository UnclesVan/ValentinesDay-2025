            if teleportToDroppablesOccasionallyActive then
                droppableTeleportCounter = droppableTeleportCounter + 1
                if droppableTeleportCounter >= DROPPABLE_TELEPORT_CYCLE_FREQ then
                    handleTeleportToDroppables()
                    droppableTeleportCounter = 0 
                end
            end

            -- Teleport to raiders ONLY within the guard radius of the GoldPile (always active for protection)
            if teleportToRaidersActive then
                handleTeleportToModels()
                wait(0.05) 
            end
            
        else -- Minigame is NOT active
            -- Attempt to click the start button if available (runs regardless of scriptEnabled, but within overall loop)
            local treasureDefenseExplainerApp = playerGui:FindFirstChild("TreasureDefenseExplainerApp")
            if treasureDefenseExplainerApp and treasureDefenseExplainerApp.Enabled and not hasClickedStartButton then
                local startScreen = treasureDefenseExplainerApp:FindFirstChild("StartScreen")
                if startScreen and startScreen.Visible then
                    local depthButton = startScreen:FindFirstChild("DepthButton")
                    if depthButton and depthButton.Visible and depthButton.Active then
                        log("Clicking 'DepthButton' to start the game...")
                        clickButton(depthButton)
                        hasClickedStartButton = true 
                    end
                end
            end
            
            -- Reset the flag if the explainer app is no longer present or enabled,
            -- indicating a new game cycle might start later.
            if not treasureDefenseExplainerApp or not treasureDefenseExplainerApp.Enabled then
                if hasClickedStartButton then 
                    log("TreasureDefenseExplainerApp not active. Resetting 'hasClickedStartButton' flag.")
                end
                hasClickedStartButton = false
            end

            -- Reset score-related pause state if minigame is inactive
            if not scoreIncreasingActionsAllowed then
                scoreIncreasingActionsAllowed = true
                log("Minigame inactive. Resetting score-increasing actions to ALLOWED.")
            end
            wait(2)
        end
    else
        -- If script is disabled by toggle, just wait
        wait(1)
    end

    wait(0.01) 
end
