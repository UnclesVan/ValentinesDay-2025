        end
    else
        logFinding("hotbar_app", "Hotbar App", false)
    end
end

-- --- DYNAMIC CONTAINER FINDERS ---

local function findCoconutBonkInterior()
    if not workspace.Interiors then
        logFinding("bonk_interior_base", "workspace.Interiors", false)
        return nil
    end

    local bonkInterior = nil
    for _, interiorInstance in ipairs(workspace.Interiors:GetChildren()) do
        if interiorInstance.Name:find(COCONUT_BONK_INTERIOR_BASE_NAME, 1, true) then
            bonkInterior = interiorInstance
            break
        end
    end

    if bonkInterior then
        logFinding("bonk_interior", "CoconutBonkInterior", true)
        return bonkInterior
    else
        logFinding("bonk_interior", "CoconutBonkInterior", false)
        return nil
    end
end

local function findPetsContainer()
    local bonkInterior = findCoconutBonkInterior()
    if not bonkInterior then
        logFinding("pets_container", "Pets container (from bonkInterior)", false)
        return nil
    end

    local gameContainer = bonkInterior:FindFirstChild("Game")
    if gameContainer then
        local binsContainer = gameContainer:FindFirstChild("Bins")
        if binsContainer then
            local petsContainer = binsContainer:FindFirstChild("Pets")
            if petsContainer then
                logFinding("pets_container", "Pets container (Game.Bins.Pets)", true)
                return petsContainer
            end
        end
    end
    logFinding("pets_container", "Pets container (Game.Bins.Pets)", false)
    return nil
end

-- --- TELEPORTATION LOGIC ---

local function handleTeleportToModels()
    if not scriptEnabled then return end
    local petsContainer = findPetsContainer()
    local character = player.Character
    local bonkInterior = findCoconutBonkInterior()
    if not bonkInterior then return end
    local goldPileRoot = bonkInterior:FindFirstChild("Game"):FindFirstChild("GoldPile"):FindFirstChild("Root")

    if not character or not character:FindFirstChild("HumanoidRootPart") then
        log("Cannot teleport to raiders: Character or HumanoidRootPart not found.")
        return
    end
    if not petsContainer then
        log("Cannot teleport to raiders: Pets container not found.")
        return
    end
    if not goldPileRoot or not goldPileRoot:IsA("BasePart") then
        log("Cannot teleport to raiders: GoldPile Root not found or invalid.")
        return
    end

    local goldPilePosition = goldPileRoot.Position

    for _, modelInPets in ipairs(petsContainer:GetChildren()) do
        local modelNameLower = modelInPets.Name:lower()
        local shouldExclude = false

        for _, keyword in ipairs(EXCLUDED_MODEL_KEYWORDS) do
            if modelNameLower:find(keyword) then
                shouldExclude = true
                break
            end
        end

        if shouldExclude then
            log("Excluding model from raider check: " .. modelInPets.Name)
            continue
        end

        if modelInPets:IsA("Model") then
            local targetPart = modelInPets.PrimaryPart or modelInPets:FindFirstChild("HumanoidRootPart")
            if targetPart and targetPart:IsA("BasePart") then
                local distance = (targetPart.Position - goldPilePosition).magnitude

                if distance <= GOLD_PILE_GUARD_RADIUS then
                    log("Found threat: " .. modelInPets.Name .. " within guard radius (" .. math.floor(distance) .. " studs). Teleporting to engage and face them.")
                    local teleportPosition = targetPart.Position + Vector3.new(0, 5, 0)
                    local lookAtPosition = targetPart.Position
                    character.HumanoidRootPart.CFrame = CFrame.lookAt(teleportPosition, lookAtPosition)
                    wait(0.005)
                    return
                end
            end
        end
    end
end

local function handleTeleportAroundGoldPile()
    if not scriptEnabled then return end
    local bonkInterior = findCoconutBonkInterior()
    local character = player.Character
    if not bonkInterior or not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local goldPileRoot = bonkInterior:FindFirstChild("Game"):FindFirstChild("GoldPile"):FindFirstChild("Root")

    if goldPileRoot and goldPileRoot:IsA("BasePart") then
        local teleportTargets = {}
        for i = 1, NUM_RANDOM_GOLD_PILE_TELEPORTS do
            local randomX = math.random(-GOLD_PILE_TELEPORT_RADIUS, GOLD_PILE_TELEPORT_RADIUS)
            local randomZ = math.random(-GOLD_PILE_TELEPORT_RADIUS, GOLD_PILE_TELEPORT_RADIUS)
            local teleportPosition = goldPileRoot.Position + Vector3.new(0, 5, 0)
            local lookAtPosition = goldPileRoot.Position
            table.insert(teleportTargets, CFrame.lookAt(teleportPosition, lookAtPosition))
        end

        if #teleportTargets > 0 then
            log("Teleporting around Gold Pile and facing it.")
            for _, targetCFrame in ipairs(teleportTargets) do
                character.HumanoidRootPart.CFrame = targetCFrame
                wait(0.01)
            end
        end
    end
end

