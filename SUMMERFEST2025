-- Safely get UI elements with a timeout
local function getUIElement(base, path)
    local parts = string.split(path, ".")
    local current = base
    for i, p in ipairs(parts) do
        -- Wait up to 1 second for each part of the path
        current = current:WaitForChild(p, 1)
        if not current then
            log("Failed to find UI element part: '" .. p .. "' at path: '" .. table.concat(parts, ".", 1, i) .. "'")
            return nil
        end
    end
    return current
end

-- Simulate button clicks
local function clickButton(btn)
    if btn and btn.Parent then
        log("Attempting to click: " .. btn.Name)
        pcall(function()
            -- Fire MouseButton1Down, MouseButton1Click, and MouseButton1Up events
            for _, conn in pairs(getconnections(btn.MouseButton1Down)) do conn:Fire() end
            task.wait(0.05)
