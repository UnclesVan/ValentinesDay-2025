-- New variable for anti-ragdoll toggle state
local antiRagdollEnabled = false

-- Function to handle anti-ragdoll
local function handleAntiRagdoll()
    while true do
        local char = player.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if humanoid and hrp then
                if antiRagdollEnabled then
                    -- Set PlatformStand to true to prevent ragdolling
                    humanoid.PlatformStand = true
                    -- Set Jump to false to prevent hopping
                    humanoid.Jump = false
                    -- Explicitly set Humanoid.Sit to false
                    humanoid.Sit = false
                    -- Reset velocity to prevent sliding/falling due to physics
                    hrp.Velocity = Vector3.new(0,0,0)
                    hrp.RotVelocity = Vector3.new(0,0,0)
                    -- log("Anti-Ragdoll: Humanoid.PlatformStand set, Jump set to false, and velocity reset.") -- Too spammy
                else
                    -- Revert changes when anti-ragdoll is disabled
                    humanoid.PlatformStand = false
                    humanoid.Jump = true -- Allow jumping again
                    humanoid.Sit = false -- Ensure it's not stuck sitting if it was
                    -- No need to explicitly set velocity to 0 when disabling, let physics take over
                end
            end
        end
        task.wait(0.05) -- Check every 0.05 seconds for more aggressive control
    end
end

-- Spawn anti-ragdoll coroutine
task.spawn(handleAntiRagdoll)

