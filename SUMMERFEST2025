-- --- DYNAMIC CONTAINER FINDERS ---

-- Finds the CoconutBonkInterior instance which has a name like "CoconutBonkInterior::GUID"
local function findCoconutBonkInterior()
    if not workspace.Interiors then
        logFinding("bonk_interior_base", "workspace.Interiors", false) 
        return nil
    end

    local bonkInterior = nil
    for _, interiorInstance in ipairs(workspace.Interiors:GetChildren()) do
        if interiorInstance.Name:find(COCONUT_BONK_INTERIOR_BASE_NAME, 1, true) then 
            bonkInterior = interiorInstance
            break
        end
    end

    if bonkInterior then
        logFinding("bonk_interior", "CoconutBonkInterior", true)
        return bonkInterior
    else
        logFinding("bonk_interior", "CoconutBonkInterior", false)
        return nil
    end
end

local function findPetsContainer()
    local bonkInterior = findCoconutBonkInterior() 
    if not bonkInterior then
        logFinding("pets_container", "Pets container", false) 
        return nil
    end

    local petsContainer = bonkInterior:FindFirstChild("Game")
    if petsContainer then
        petsContainer = petsContainer:FindFirstChild("Bins")
        if petsContainer then
            petsContainer = petsContainer:FindFirstChild("Pets")
            if petsContainer then
                logFinding("pets_container", "Pets container", true)
                return petsContainer
            end
        end
    end
    logFinding("pets_container", "Pets container", false)
    return nil
end

-- --- TELEPORTATION LOGIC ---

local function handleTeleportToModels()
    if not scriptEnabled then return end 
    local petsContainer = findPetsContainer()
    local character = player.Character
    local bonkInterior = findCoconutBonkInterior()
    if not bonkInterior then return end
    -- Gold Pile Root is needed to determine the guard radius relative to it
    local goldPileRoot = bonkInterior:FindFirstChild("Game"):FindFirstChild("GoldPile"):FindFirstChild("Root")

    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end
    if not petsContainer then
        return
    end
    if not goldPileRoot or not goldPileRoot:IsA("BasePart") then
        return 
    end

    local goldPilePosition = goldPileRoot.Position

    for _, modelInPets in ipairs(petsContainer:GetChildren()) do
        local modelNameLower = modelInPets.Name:lower()
        local shouldExclude = false

        for _, keyword in ipairs(EXCLUDED_MODEL_KEYWORDS) do
            if modelNameLower:find(keyword) then
                shouldExclude = true
                break
            end
        end

        if shouldExclude then
            continue
        end

        if modelInPets:IsA("Model") and modelInPets:FindFirstChildOfClass("MeshPart") then
            local targetPart = modelInPets.PrimaryPart or modelInPets:FindFirstChild("HumanoidRootPart")
            if targetPart and targetPart:IsA("BasePart") then
                local distance = (targetPart.Position - goldPilePosition).magnitude
                
                if distance <= GOLD_PILE_GUARD_RADIUS then
                    log("Found threat: " .. modelInPets.Name .. " within guard radius. Teleporting to engage and face them.")
                    local teleportPosition = targetPart.Position + Vector3.new(0, 5, 0)
                    local lookAtPosition = targetPart.Position -- Look directly at the raider
                    character.HumanoidRootPart.CFrame = CFrame.lookAt(teleportPosition, lookAtPosition)
                    wait(0.01) 
                    return 
                end
            end
        end
    end
end

local function handleTeleportAroundGoldPile()
    if not scriptEnabled then return end 
    local bonkInterior = findCoconutBonkInterior()
    local character = player.Character
    if not bonkInterior or not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local goldPileRoot = bonkInterior:FindFirstChild("Game"):FindFirstChild("GoldPile"):FindFirstChild("Root")

    if goldPileRoot and goldPileRoot:IsA("BasePart") then
        local teleportTargets = {}
        for i = 1, NUM_RANDOM_GOLD_PILE_TELEPORTS do
            local randomX = math.random(-GOLD_PILE_TELEPORT_RADIUS, GOLD_PILE_TELEPORT_RADIUS)
            local randomZ = math.random(-GOLD_PILE_TELEPORT_RADIUS, GOLD_PILE_TELEPORT_RADIUS)
            local teleportPosition = goldPileRoot.Position + Vector3.new(randomX, 5, randomZ) 
            local lookAtPosition = goldPileRoot.Position -- Look at the gold pile
            table.insert(teleportTargets, CFrame.lookAt(teleportPosition, lookAtPosition))
        end

        if #teleportTargets > 0 then
            log("Teleporting around Gold Pile and facing it.")
            for _, targetCFrame in ipairs(teleportTargets) do
                character.HumanoidRootPart.CFrame = targetCFrame
                wait(0.01) 
            end
        end
    end
end

-- NEW FUNCTION: Teleports to the main "Block"
local function handleTeleportToMainBlock()
    if not scriptEnabled then return end
    local bonkInterior = findCoconutBonkInterior()
    local character = player.Character
    if not bonkInterior or not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local mainBlock = bonkInterior:FindFirstChild("Visual")
    if mainBlock then
        mainBlock = mainBlock:FindFirstChild("Steps")
        if mainBlock then
            mainBlock = mainBlock:FindFirstChild("Block")
        end
    end

    local goldPileRoot = bonkInterior:FindFirstChild("Game"):FindFirstChild("GoldPile"):FindFirstChild("Root")


    if mainBlock and mainBlock:IsA("BasePart") then
        logFinding("main_block", "Main Block (Visual.Steps.Block)", true)
        local teleportPosition = mainBlock.Position + Vector3.new(0, 5, 0)
        local lookAtPosition = goldPileRoot and goldPileRoot.Position or (mainBlock.Position + mainBlock.CFrame.LookVector * 100) -- Fallback if gold pile not found
        
        log("Teleporting to main block and facing action.")
        character.HumanoidRootPart.CFrame = CFrame.lookAt(teleportPosition, lookAtPosition)
        wait(0.01)
    else
        logFinding("main_block", "Main Block (Visual.Steps.Block)", false)
    end
end


local function handleTeleportToDroppables()
    if not scriptEnabled then return end 
    if not scoreIncreasingActionsAllowed then return end 

    local bonkInterior = findCoconutBonkInterior()
    local character = player.Character
    if not bonkInterior or not character or not character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local pile1Root = bonkInterior:FindFirstChild("Game"):FindFirstChild("Droppables"):FindFirstChild("Piles"):FindFirstChild("1"):FindFirstChild("Root")
    local pile2Root = bonkInterior:FindFirstChild("Game"):FindFirstChild("Droppables"):FindFirstChild("Piles"):FindFirstChild("2"):FindFirstChild("Root")

    local droppableTargets = {}
    if pile1Root and pile1Root:IsA("BasePart") then 
        local teleportPosition = pile1Root.Position + Vector3.new(0, 5, 0)
        table.insert(droppableTargets, CFrame.lookAt(teleportPosition, pile1Root.Position)) 
    end
    if pile2Root and pile2Root:IsA("BasePart") then 
        local teleportPosition = pile2Root.Position + Vector3.new(0, 5, 0)
        table.insert(droppableTargets, CFrame.lookAt(teleportPosition, pile2Root.Position)) 
    end

    if #droppableTargets > 0 then
        log("Teleporting to Droppable piles (occasional visit) and facing them.")
        for _, targetCFrame in ipairs(droppableTargets) do
            character.HumanoidRootPart.CFrame = targetCFrame
            wait(0.01) 
        end
        
        log("Returning after visiting droppables.")
        for i = 1, DROPPABLE_TELEPORT_RETURN_GOLD_TELEPORTS do
            if teleportToMainBlockActive then
                handleTeleportToMainBlock() -- Return to main block if enabled
            elseif teleportAroundGoldActive then
                handleTeleportAroundGoldPile() -- Otherwise return to gold pile orbit
            end
            wait(0.01) 
        end
    end
end

-- FUNCTION: Monitor score and adjust script actions
local function checkScoreAndAdjustActions()
    if not scriptEnabled then return end 

    local valueLabel
    local success, result = pcall(function()
        valueLabel = playerGui:WaitForChild("MinigameInGameApp", 5):WaitForChild("Body", 5):WaitForChild("Right", 5):WaitForChild("Container", 5):WaitForChild("ValueLabel", 5)
    end)

    if not success or not valueLabel or not valueLabel:IsA("TextLabel") then
        log("❌ ValueLabel not found or not TextLabel after waiting at path: " .. SCORE_LABEL_PATH)
        log("Score control currently inactive due to missing ValueLabel.")
        return
    end
    logFinding("score_label", "Score ValueLabel", true)

    local currentScore = tonumber(valueLabel.Text)
    if not currentScore then
        log("Could not parse score from ValueLabel: '" .. valueLabel.Text .. "'")
        return
    end

    local upperThreshold = TARGET_SCORE + SCORE_UPPER_TOLERANCE
    local lowerThreshold = TARGET_SCORE - SCORE_LOWER_TOLERANCE

    if currentScore > upperThreshold and scoreIncreasingActionsAllowed then
        scoreIncreasingActionsAllowed = false
        log(string.format("SCORE CONTROL: Current score %d > Upper Threshold %d. PAUSING score-increasing actions.", currentScore, upperThreshold))
    elseif currentScore < lowerThreshold and not scoreIncreasingActionsAllowed then
        scoreIncreasingActionsAllowed = true
        log(string.format("SCORE CONTROL: Current score %d < Lower Threshold %d. RESUMING score-increasing actions.", currentScore, lowerThreshold))
    end
    log(string.format("Current score: %d. Score increasing actions: %s", currentScore, (scoreIncreasingActionsAllowed and "ALLOWED" or "PAUSED")))
end

