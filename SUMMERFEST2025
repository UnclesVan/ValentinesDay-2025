local function handleHotbarAbilities()
    if not scoreIncreasingActionsAllowed then
        log("Hotbar abilities paused due to score control.")
        return
    end

    local hotbarApp = playerGui:FindFirstChild(FROSTCLAWS_HOTBAR_APP_NAME)
    if hotbarApp then
        local hotbarFrame = hotbarApp:FindFirstChild("Hotbar")

        if hotbarFrame then
            local dropButtonContainer = hotbarFrame:FindFirstChild(DROP_BUTTON_NAME)
            local dropButton = dropButtonContainer and dropButtonContainer:FindFirstChild("Button")

            local swordButtonContainer = hotbarFrame:FindFirstChild(SWORD_BUTTON_NAME)
            local swordButton = swordButtonContainer and swordButtonContainer:FindFirstChild("Button")

            if dropButton and dropButton.Visible and dropButton.Active then
                clickButton(dropButton)
                log("Clicked DropButton.")
            else
                logFinding("drop_button", "Drop Button (nested)", false)
            end

            wait(0.1)

            if swordButton and swordButton.Visible and swordButton.Active then
                clickButton(swordButton)
                log("Clicked SwordButton.")
            else
                logFinding("sword_button", "Sword Button (nested)", false)
            end
        else
