-- --- MAIN SCRIPT LOOP ---
while true do
    if scriptEnabled then
        if isMinigameActive() then
            -- Pcall for checkScoreAndAdjustActions, in case it fails silently
            local success, err = pcall(checkScoreAndAdjustActions)
            if not success then log("Error in checkScoreAndAdjustActions: " .. tostring(err)) end

            -- Ensure start button flag is reset once minigame is confirmed active
            if hasClickedStartButton then
                hasClickedStartButton = false
                log("Minigame started. Resetting 'hasClickedStartButton' flag.")
            end

            -- Hotbar abilities spam (controlled by hotbarSpamActive AND scoreIncreasingActionsAllowed)
            if hotbarSpamActive then
                local success, err = pcall(handleHotbarAbilities)
                if not success then log("Error in handleHotbarAbilities: " .. tostring(err)) end
                wait(0.1)
            end

            -- NEW: Teleport to the main "Block"
            if teleportToMainBlockActive then
                local success, err = pcall(handleTeleportToMainBlock)
                if not success then log("Error in handleTeleportToMainBlock: " .. tostring(err)) end
                wait(0.05)
            end

            -- NEW: Teleport to the 6th Diamond
            if teleportToDiamondsActive then
                local success, err = pcall(handleTeleportToDiamonds)
                if not success then log("Error in handleTeleportToDiamonds: " .. tostring(err)) end
                wait(0.05)
            end

            -- Teleport around GoldPile (now optional, default false)
            if teleportAroundGoldActive then
                local success, err = pcall(handleTeleportAroundGoldPile)
                if not success then log("Error in handleTeleportAroundGoldPile: " .. tostring(err)) end
                wait(0.05)
            end

            -- Occasional teleport to Droppable piles (controlled by scoreIncreasingActionsAllowed)
            if teleportToDroppablesOccasionallyActive then
                droppableTeleportCounter = droppableTeleportCounter + 1
                if droppableTeleportCounter >= DROPPABLE_TELEPORT_CYCLE_FREQ then
                    local success, err = pcall(handleTeleportToDroppables)
                    if not success then log("Error in handleTeleportToDroppables: " .. tostring(err)) end
                    droppableTeleportCounter = 0
                end
            end

            -- Teleport to raiders ONLY within the guard radius of the GoldPile (always active for protection)
            if teleportToRaidersActive then
                local success, err = pcall(handleTeleportToModels)
                if not success then log("Error in handleTeleportToModels: " .. tostring(err)) end
                wait(0.005) -- Very short wait to continuously check for raiders
            end

        else -- Minigame is NOT active
            -- Attempt to click the start button if available (runs regardless of scriptEnabled, but within overall loop)
            local treasureDefenseExplainerApp = playerGui:FindFirstChild("TreasureDefenseExplainerApp")
            if treasureDefenseExplainerApp and treasureDefenseExplainerApp.Enabled and not hasClickedStartButton then
                local startScreen = treasureDefenseExplainerApp:FindFirstChild("StartScreen")
                if startScreen and startScreen.Visible then
                    local depthButton = startScreen:FindFirstChild("DepthButton")
                    if depthButton and depthButton.Visible and depthButton.Active then
                        log("Clicking 'DepthButton' to start the game...")
                        local success, err = pcall(clickButton, depthButton) -- Added pcall
                        if not success then log("Error clicking DepthButton: " .. tostring(err)) end
                        hasClickedStartButton = true
                    end
                end
            end

            -- Reset the flag if the explainer app is no longer present or enabled,
            -- indicating a new game cycle might start later.
            if not treasureDefenseExplainerApp or not treasureDefenseExplainerApp.Enabled then
                if hasClickedStartButton then
                    log("TreasureDefenseExplainerApp not active. Resetting 'hasClickedStartButton' flag.")
                end
                hasClickedStartButton = false
            end

            -- Reset score-related pause state if minigame is inactive
            if not scoreIncreasingActionsAllowed then
                scoreIncreasingActionsAllowed = true
                log("Minigame inactive. Resetting score-increasing actions to ALLOWED.")
            end
            wait(2)
        end
    else
        -- If script is disabled by toggle, just wait
        wait(1)
    end

    wait(0.01)
end
