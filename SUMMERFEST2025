        local success, err = pcall(function()
            local prevState = scriptEnabled
            scriptEnabled = not scriptEnabled
            updateToggleButtonUI()
            log("Script Toggled: " .. (scriptEnabled and "ON" or "OFF"))

            if scriptEnabled and not prevState then
                log("Script just turned ON. Attempting to teleport to minigame join zone.")

                local currentCharacter = player.Character
                -- Ensure Character is ready
                if not currentCharacter then
                    log("DEBUG: player.Character is nil. Attempting CharacterAdded:Wait().")
                    local charAddedEvent = player.CharacterAdded
                    -- ADDED: Check if charAddedEvent is actually an RBXScriptSignal
                    if typeof(charAddedEvent) == "RBXScriptSignal" then
                        local charWaitSuccess, charWaitResult = pcall(function()
                            return charAddedEvent:Wait()
                        end)
                        if charWaitSuccess then
                            currentCharacter = charWaitResult
                            log("DEBUG: currentCharacter set from CharacterAdded:Wait().")
                        else
                            log("CRITICAL ERROR: CharacterAdded:Wait() failed! Error: " .. tostring(charWaitResult) .. ". Aborting teleport.")
                            return -- Exit if character doesn't load
                        end
                    else
                        log("CRITICAL ERROR: player.CharacterAdded is NOT an RBXScriptSignal! Typeof: " .. typeof(charAddedEvent) .. ". Cannot use :Wait(). Aborting teleport.")
                        return -- Exit if event is not valid
                    end
                end

                -- Re-check character after potential wait
                if not currentCharacter or not currentCharacter:IsDescendantOf(workspace) then
                     log("❌ Character became invalid or missing during ON-toggle teleport sequence. Aborting teleport.")
                     return
                end

                local currentHumanoidRootPart = currentCharacter:FindFirstChild("HumanoidRootPart")
                if currentHumanoidRootPart and currentHumanoidRootPart:IsA("BasePart") then -- Check IsA("BasePart") for safety
                    local teleportRing = getTeleportRingInstance()
                    if teleportRing then
                        log("✅ Teleport Ring found! Teleporting to join zone...")
                        -- Final check for HumanoidRootPart validity immediately before CFrame assignment
                        if currentHumanoidRootPart.Parent == currentCharacter then
                            currentHumanoidRootPart.CFrame = teleportRing.CFrame + Vector3.new(0, 5, 0)
                            wait(0.5)
                        else
                            log("Warning: HumanoidRootPart became invalid (e.g., unparented or destroyed) before CFrame assignment. Skipping teleport.")
                        end
                    else
                        log("❌ Failed to find Teleport Ring for ON-toggle teleport (after searching).")
                    end
                else
                    log("❌ HumanoidRootPart was NOT FOUND or was invalid for teleport (after character found).")
                end
            end
        end)
        if not success then
            log("CRITICAL ERROR in Toggle Button Click Handler (outer pcall): " .. tostring(err))
        end
    end)
end

