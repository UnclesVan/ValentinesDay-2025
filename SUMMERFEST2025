-- --- GET TELEPORT RING ---
local function getTeleportRingInstance()
    local ring
    local attempts = 0
    local MAX_RING_ATTEMPTS = 60
    print("Starting search for Teleport Ring...")
    repeat
        local interiors = workspace:FindFirstChild("Interiors")
        local summerfest = interiors and interiors:FindFirstChild("MainMap!Summerfest")
        local joinZone = summerfest and summerfest:FindFirstChild("CoconutBonkJoinZone")
        if joinZone then
            log("DEBUG: joinZone found. Typeof(joinZone): " .. typeof(joinZone))
            if typeof(joinZone) ~= "Instance" then
                log("CRITICAL DEBUG: joinZone is not an Instance! Typeof: " .. typeof(joinZone))
                joinZone = nil
            else
                log("DEBUG: Type of joinZone.FindFirstChild: " .. type(joinZone.FindFirstChild))
                if type(joinZone.FindFirstChild) ~= "function" then
                    log("CRITICAL DEBUG: joinZone.FindFirstChild is NOT a function! Forcing nil.")
                    joinZone = nil
                end
            end
        else
            log("DEBUG: joinZone is nil.")
        end
        local success, result = pcall(function() return joinZone and joinZone:FindFirstChild("Ring") end)
        if success then
            ring = result
            if ring then
                print("Found ring at attempt: " .. attempts)
                break
            end
        else
            print("Error during getTeleportRingInstance: " .. tostring(result))
        end
        wait(0.5)
        attempts = attempts + 1
    until ring or attempts >= MAX_RING_ATTEMPTS
    if not ring then
        warn("Failed to find Teleport Ring after maximum attempts.")
    end
    return ring
end

-- --- INITIAL TELEPORT ON LOAD ---
local function initialTeleport()
    local character, hrp = getCharacterAndHRP()
    local ring = getTeleportRingInstance()
    if ring and hrp and hrp.Parent == character then
        local success, err = pcall(function()
            hrp.CFrame = ring.CFrame + Vector3.new(0, 5, 0)
        end)
        if not success then
            warn("Initial teleport failed: " .. tostring(err))
        else
            wait(0.5)
        end
    else
        warn("No valid ring or HRP for initial teleport.")
    end
end

initialTeleport()

-- --- MAIN LOOP ---
while true do
    if scriptEnabled then
        if isMinigameActive() then
            local ok, err = pcall(checkScoreAndAdjustActions)
            if not ok then warn("Error in checkScoreAndAdjustActions: " .. tostring(err)) end

            -- handle start button
            local tda = playerGui:FindFirstChild("TreasureDefenseExplainerApp")
            if tda and tda.Enabled then
                local startScreen = tda:FindFirstChild("StartScreen")
                if startScreen and startScreen.Visible then
                    local depthBtn = startScreen:FindFirstChild("DepthButton")
                    if depthBtn and depthBtn.Visible and depthBtn.Active then
                        local success, err = pcall(clickButton, depthBtn)
                        if not success then warn("Error clicking DepthButton: " .. tostring(err)) end
                        hasClickedStartButton = true
                    end
                end
            end
            if not (playerGui:FindFirstChild("TreasureDefenseExplainerApp") and playerGui.TreasureDefenseExplainerApp.Enabled) then
                hasClickedStartButton = false
            end

            if hotbarSpamActive then
                local ok, err = pcall(handleHotbarAbilities)
                if not ok then warn("Error in handleHotbarAbilities: " .. tostring(err)) end
                wait(0.1)
            end

            if teleportToMainBlockActive then
                local ok, err = pcall(handleTeleportToMainBlock)
                if not ok then warn("Error in handleTeleportToMainBlock: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportToDiamondsActive then
                local ok, err = pcall(handleTeleportToDiamonds)
                if not ok then warn("Error in handleTeleportToDiamonds: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportAroundGoldActive then
                local ok, err = pcall(handleTeleportAroundGoldPile)
                if not ok then warn("Error in handleTeleportAroundGoldPile: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportToDroppablesOccasionallyActive then
                droppableTeleportCounter = droppableTeleportCounter + 1
                if droppableTeleportCounter >= DROPPABLE_TELEPORT_CYCLE_FREQ then
                    local ok, err = pcall(handleTeleportToDroppables)
                    if not ok then warn("Error in handleTeleportToDroppables: " .. tostring(err)) end
                    droppableTeleportCounter = 0
                end
            end

            if teleportToRaidersActive then
                local ok, err = pcall(handleTeleportToModels)
                if not ok then warn("Error in handleTeleportToModels: " .. tostring(err)) end
                wait(0.005)
            end
        else
            -- Not in minigame: handle start button again if needed
            local tda = playerGui:FindFirstChild("TreasureDefenseExplainerApp")
            if tda and tda.Enabled then
                local startScreen = tda:FindFirstChild("StartScreen")
                if startScreen and startScreen.Visible then
                    local depthBtn = startScreen:FindFirstChild("DepthButton")
                    if depthBtn and depthBtn.Visible and depthBtn.Active then
                        local success, err = pcall(clickButton, depthBtn)
                        if not success then warn("Error clicking DepthButton: " .. tostring(err)) end
                        hasClickedStartButton = true
                    end
                end
            end
            if not (playerGui:FindFirstChild("TreasureDefenseExplainerApp") and playerGui.TreasureDefenseExplainerApp.Enabled) then
                hasClickedStartButton = false
            end
            if not scoreIncreasingActionsAllowed then
                scoreIncreasingActionsAllowed = true
                log("Minigame inactive, resetting score actions.")
            end
            wait(2)
        end

        -- --- Anti-AFK noticeable rotation and movement ---
        local currentCharacter, hrp = getCharacterAndHRP()
        if hrp then
            local success, err = pcall(function()
                -- Generate a random axis
                local axisX = math.random(-1, 1)
                local axisY = math.random(-1, 1)
                local axisZ = math.random(-1, 1)
                -- Random angle between 5 and 20 degrees (~0.087 to 0.349 radians)
                local angleDeg = math.random(5, 20)
                local angleRad = math.rad(angleDeg)
                -- Normalize axis
                local axisLen = math.sqrt(axisX^2 + axisY^2 + axisZ^2)
                if axisLen > 0 then
                    axisX, axisY, axisZ = axisX/axisLen, axisY/axisLen, axisZ/axisLen
                else
                    axisX, axisY, axisZ = 0, 1, 0 -- fallback axis
                end
                local rotationCFrame = CFrame.fromAxisAngle(Vector3.new(axisX, axisY, axisZ), angleRad)
                -- Random small positional shift
                local shiftX = math.random(-0.2, 0.2)
                local shiftY = math.random(-0.2, 0.2)
                local shiftZ = math.random(-0.2, 0.2)
                local shiftVec = Vector3.new(shiftX, shiftY, shiftZ)
                -- Randomly choose to rotate, shift, or both
                local actionType = math.random(1,3)
                if actionType == 1 then
                    hrp.CFrame = hrp.CFrame * rotationCFrame
                elseif actionType == 2 then
                    hrp.CFrame = hrp.CFrame * CFrame.new(shiftVec)
                else
                    hrp.CFrame = hrp.CFrame * rotationCFrame * CFrame.new(shiftVec)
                end
            end)
            if not success then
                warn("Enhanced movement error: " .. tostring(err))
            end
        end
    else
        wait(1)
    end
    wait(0.01)
end
