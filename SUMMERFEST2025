            if pets then
                logFinding("pets_container", "Pets (Game.Bins.Pets)", true)
                return pets
            end
        end
    end
    logFinding("pets_container", "Pets (Game.Bins.Pets)", false)
    return nil
end

-- New function to find the specific Block part for teleportation
local function findTargetBlock(interior)
    log("DEBUG: Attempting to find target Block part.")
    local visualFolder = interior:FindFirstChild("Visual")
    if not visualFolder or not visualFolder:IsA("Folder") then
        log("DEBUG: Could not find 'Visual' Folder inside interior for Block target (Type: " .. (visualFolder and visualFolder.ClassName or "nil") .. "). Expected 'Folder'.")
        return nil
    end
    log("DEBUG: Found 'Visual' Folder (Type: " .. visualFolder.ClassName .. "). Expected 'Folder'.")

    local stepsModel = visualFolder:FindFirstChild("Steps")
    if not stepsModel or not stepsModel:IsA("Model") then
        log("DEBUG: Could not find 'Steps' Model inside Visual for Block target (Type: " .. (stepsModel and stepsModel.ClassName or "nil") .. "). Expected 'Model'.")
        return nil
    end
    log("DEBUG: Found 'Steps' Model (Type: " .. stepsModel.ClassName .. "). Expected 'Model'.")

    local child2_steps = findChildByIndex(stepsModel, 2, "Steps Child [2]")
    if not child2_steps or not child2_steps:IsA("Model") then -- Still expecting a Model here
        log("DEBUG: Steps Child [2] not found or not a Model for Block target (Type: " .. (child2_steps and child2_steps.ClassName or "nil") .. "). Expected 'Model'.")
        return nil
    end
    log("DEBUG: Found Steps Child [2] (Model): " .. child2_steps.Name .. " (Type: " .. child2_steps.ClassName .. "). Expected 'Model'.")

    -- NEW: Additional GetChildren()[2] step
    local nestedChild2_steps = findChildByIndex(child2_steps, 2, "Steps Child [2] - Nested Child [2]")
    if not nestedChild2_steps or not nestedChild2_steps:IsA("Model") then -- Still expecting a Model here
        log("DEBUG: Steps Child [2] - Nested Child [2] not found or not a Model for Block target (Type: " .. (nestedChild2_steps and nestedChild2_steps.ClassName or "nil") .. "). Expected 'Model'.")
        return nil
    end
    log("DEBUG: Found Steps Child [2] - Nested Child [2] (Model): " .. nestedChild2_steps.Name .. " (Type: " .. nestedChild2_steps.ClassName .. "). Expected 'Model'.")

    local modelInsideNestedChild2 = nestedChild2_steps:FindFirstChild("Model")
    if not modelInsideNestedChild2 or not modelInsideNestedChild2:IsA("Model") then
        log("DEBUG: Could not find 'Model' inside Steps Child [2] - Nested Child [2] for Block target (Type: " .. (modelInsideNestedChild2 and modelInsideNestedChild2.ClassName or "nil") .. "). Expected 'Model'.")
        return nil
    end
    log("DEBUG: Found 'Model' inside Steps Child [2] - Nested Child [2] (Type: " .. modelInsideNestedChild2.ClassName .. "). Expected 'Model'.")

    -- NEW: Changed index to 3 for the final part
    local finalPart = findChildByIndex(modelInsideNestedChild2, 3, "Model Child [3]")
    if not finalPart or not finalPart:IsA("BasePart") then
        log("DEBUG: Final part at Model Child [3] not found or not a BasePart for Block target (Type: " .. (finalPart and finalPart.ClassName or "nil") .. "). Expected 'BasePart'.")
        return nil
    end
    log("DEBUG: Found final part (Type: " .. finalPart.ClassName .. "). Expected 'BasePart'.")
    return finalPart
end


-- Handles teleportation to "raider" models (excluding specific keywords)
local function handleTeleportToModels()
    if not scriptEnabled or not _G.teleportToRaidersActive then return end -- Ensure this feature is enabled
    log("Running handleTeleportToModels cycle...")

    local petsContainer = findPetsContainer()
    local currentCharacter, hrp = getCharacterAndHRP()
    local bonkInterior = findCoconutBonkInterior()

    if not bonkInterior or not hrp or not hrp.Parent == currentCharacter then
        log("Teleport conditions not met (bonkInterior or HRP missing/invalid).")
        return
    end

    local teleportedToTarget = false

    -- --- Attempt to teleport to Raiders first ---
    if petsContainer then
        local gameFolder = bonkInterior:FindFirstChild("Game")
        local goldPile = gameFolder and gameFolder:FindFirstChild("GoldPile")
        local goldPos = nil

        if goldPile then
            local goldPileRoot = goldPile:FindFirstChild("Root")
            if goldPileRoot and goldPileRoot:IsA("BasePart") then
                goldPos = goldPileRoot.Position
                log("GoldPile Root found at: " .. tostring(goldPos))
            elseif goldPile:IsA("Model") and goldPile.PrimaryPart and goldPile.PrimaryPart:IsA("BasePart") then
                goldPos = goldPile.PrimaryPart.Position
                log("GoldPile (Model PrimaryPart) found at: " .. tostring(goldPos))
            elseif goldPile:IsA("BasePart") then
                goldPos = goldPile.Position
                log("GoldPile (BasePart) found at: " .. tostring(goldPos))
            else
                log("GoldPile found, but no valid position (no Root, PrimaryPart, or not a BasePart).")
            end
        else
            log("'GoldPile' not found inside 'Game' folder within the interior for raider detection.")
        end

        if goldPos then
            for _, model in ipairs(petsContainer:GetChildren()) do
                if model:IsA("Model") then
                    local nameLower = model.Name:lower()
                    local shouldExclude = false
                    for _, keyword in ipairs(EXCLUDED_MODEL_KEYWORDS) do
                        if nameLower:find(keyword) then
                            shouldExclude = true
                            log("Excluding model '" .. model.Name .. "' due to keyword: '" .. keyword .. "'")
                            break
                        end
                    end
                    if not shouldExclude then
                        local targetPart = model:FindFirstChild("RootPart") or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
                        if targetPart and targetPart:IsA("BasePart") then
                            local dist = (targetPart.Position - goldPos).magnitude
                            log("Checking raider: '" .. model.Name .. "' (Distance to Gold: " .. string.format("%.2f", dist) .. " studs)")

                            if dist <= GOLD_PILE_GUARD_RADIUS then
                                log("CONDITION MET: Threat: " .. model.Name .. " within guard radius (" .. math.floor(dist) .. " studs). Attempting teleport.")
                                local teleportPos = targetPart.Position + Vector3.new(0, 5, 0) -- Teleport slightly above
                                local lookAtPos = targetPart.Position

                                log("Player HRP CFrame BEFORE teleport: " .. tostring(hrp.CFrame))
                                log("Teleporting to Pos: " .. tostring(teleportPos) .. ", Looking at: " .. tostring(lookAtPos))

                                pcall(function()
                                    hrp.CFrame = CFrame.lookAt(teleportPos, lookAtPos)
                                    log("Successfully teleported player to raider " .. model.Name .. ".")
                                    log("Player HRP CFrame AFTER teleport: " .. tostring(hrp.CFrame))
                                end)
                                teleportedToTarget = true
                                return -- Teleported to a raider, exit function
                            else
                                log("CONDITION NOT MET: Raider " .. model.Name .. " is " .. string.format("%.2f", dist) .. " studs from Gold, which is > " .. tostring(GOLD_PILE_GUARD_RADIUS) .. " studs.")
                            end
                        else
                            log("Raider model '" .. model.Name .. "' has no valid RootPart, PrimaryPart, or HumanoidRootPart for teleportation.")
                        end
                    end
                end
            end
        else
            log("No valid GoldPile position found for raider detection. Cannot teleport to raiders.")
        end
    else
        log("Pets container not found for raider detection.")
    end

    -- --- If no raiders were teleported to, attempt to teleport to the new specific Block part ---
    if not teleportedToTarget and not hasTeleportedToBlock then -- Only attempt if no raiders and not already teleported to block
        log("No raiders found within guard radius. Checking for specific Block target...")
        local targetBlockPart = findTargetBlock(bonkInterior)
        if targetBlockPart and targetBlockPart:IsA("BasePart") then
            log("CONDITION MET: Found specific Block target: " .. targetBlockPart.Name .. ". Attempting teleport.")
            local teleportPos = targetBlockPart.Position + Vector3.new(0, 5, 0) -- Teleport slightly above
            local lookAtPos = targetBlockPart.Position

            log("Player HRP CFrame BEFORE teleport: " .. tostring(hrp.CFrame))
            log("Teleporting to Block Pos: " .. tostring(teleportPos) .. ", Looking at: " .. tostring(lookAtPos))

            pcall(function()
                hrp.CFrame = CFrame.lookAt(teleportPos, lookAtPos)
                task.wait(0.005)
                log("Successfully teleported player to Block target " .. targetBlockPart.Name .. ".")
            end)
            teleportedToTarget = true
            hasTeleportedToBlock = true -- Set the flag to true after successful teleport
            return -- Teleported to Block, exit function
        else
            log("Specific Block target not found or not a BasePart.")
        end
    end

    if not teleportedToTarget then
        log("No raiders or specific Block target found for teleportation.")
    end
end

