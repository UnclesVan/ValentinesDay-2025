        else
            btn.Text = "Script: OFF"
            btn.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
        end
    end

    updateUI()

    local function toggleScript()
        local prevState = scriptEnabled
        scriptEnabled = not scriptEnabled
        updateUI()
        log("Script: " .. (scriptEnabled and "ON" or "OFF"))
        if scriptEnabled and not prevState then
            -- Teleport immediately on toggle ON
            local character, hrp = getCharacterAndHRP()
            local ring = getTeleportRingInstance()
            if ring and hrp and hrp.Parent == character then
                local success, err = pcall(function()
                    hrp.CFrame = ring.CFrame + Vector3.new(0, 5, 0)
                end)
                if not success then
                    warn("Teleport on toggle failed: " .. tostring(err))
                else
                    wait(0.5)
                end
            else
                warn("Could not teleport: ring or HRP missing")
            end
        end
    end

    btn.MouseButton1Click:Connect(function()
        toggleScript()
    end)
end

