-- Function to log messages to the in-game console
local function log(msg)
    consoleText.Text = consoleText.Text .. "[" .. os.date("%H:%M:%S") .. "] " .. tostring(msg) .. "\n"
    -- Keep the console text from growing indefinitely, limit to last 100 lines
    local lines = string.split(consoleText.Text, "\n")
    if #lines > 100 then
        table.remove(lines, 1) -- Remove the oldest line
        consoleText.Text = table.concat(lines, "\n")
    end
end

