-- Helper to find a child by index, with logging
local function findChildByIndex(parent, index, nameForLog)
    if not parent then
        log("DEBUG: findChildByIndex: Parent for " .. nameForLog .. " is nil.")
        return nil
    end
    local children = parent:GetChildren()
    if #children >= index and children[index] then
        log("DEBUG: findChildByIndex: Found " .. nameForLog .. " at index " .. index .. ": " .. children[index].Name .. " (Type: " .. children[index].ClassName .. ")")
        return children[index]
    else
        log("DEBUG: findChildByIndex: Could not find " .. nameForLog .. " at index " .. index .. ". Parent: " .. parent.Name .. ", Children Count: " .. #children)
        return nil
    end
end

