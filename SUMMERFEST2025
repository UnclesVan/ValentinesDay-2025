-- Create platform inside the minigame interior periodically
local function createLargePlatformAtInterior()
    local interior = findCoconutBonkInterior() -- Use the new find function
    if not interior then
        log("No minigame interior found for internal platform creation.")
        return
    end

    -- Navigate to the SnowMound part within the interior
    local visual = interior:FindFirstChild("Visual")
    if not visual then
        log("Could not find 'Visual' folder inside interior for platform placement.")
        return
    end
    local tower = visual:FindFirstChild("Tower")
    if not tower then
        log("Could not find 'Tower' folder inside Visual for platform placement.")
        return
    end
    local model = tower:FindFirstChild("Model")
    if not model then
        log("Could not find 'Model' folder inside Tower for platform placement.")
        return
    end
    local snowMound = model:FindFirstChild("SnowMound")

    if not snowMound or not snowMound:IsA("BasePart") then
        log("Could not find 'SnowMound' part inside Model (or it's not a BasePart) for platform placement.")
        return
    end

    log("Found SnowMound: " .. snowMound.Name)
    log("SnowMound Position: " .. tostring(snowMound.Position))
    log("SnowMound Size.Y: " .. tostring(snowMound.Size.Y))

    local existing = interior:FindFirstChild("LargePlatform")
    -- Check if the existing platform is in the desired state (size, color, material)
    if existing and existing.Parent == interior and existing.Anchored and
       existing.BrickColor == BrickColor.new("White") and
       existing.Material == Enum.Material.Plastic and
       existing.Size == Vector3.new(512, 1, 512) then
        log("Platform already exists and is in desired state. Skipping recreation.")
        return -- Do not recreate if it's already there and correct
    end

    if existing then
        existing:Destroy() -- Destroy existing platform if it's not in the desired state
        log("Destroyed existing LargePlatform (not in desired state).")
    end

    -- Calculate position for the platform to be just above the SnowMound's top surface.
    -- Platform height is 1 stud. We want its bottom to be above SnowMound's top.
    local platformHeight = 1
    local newPlatformY = snowMound.Position.Y + (snowMound.Size.Y / 2) + (platformHeight / 2) + PLATFORM_CLEARANCE_ABOVE_SNOWMOUND

    local newPlatformPosition = Vector3.new(
        snowMound.Position.X,
        newPlatformY,
        snowMound.Position.Z
    )

    log("Calculated new platform position (above SnowMound): " .. tostring(newPlatformPosition) .. " (Y: " .. string.format("%.2f", newPlatformPosition.Y) .. ")")

    -- Create the platform relative to this calculated position, parented to the interior
    createLargePlatform(newPlatformPosition, interior)
    log("Platform creation requested at: " .. tostring(newPlatformPosition) .. " inside " .. interior.Name)
end

-- Run internal platform creation every 10 seconds
spawn(function()
    while true do
        createLargePlatformAtInterior() -- This function now handles one-time creation
        task.wait(10)
    end
end)

