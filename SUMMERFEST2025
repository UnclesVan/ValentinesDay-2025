local function getTeleportRingInstance()
    local ring
    local attempts = 0
    local MAX_RING_ATTEMPTS = 60
    log("Starting search for Teleport Ring (using MainMap!Summerfest path)...")
    repeat
        local interiors = workspace:FindFirstChild("Interiors")
        local summerfest = interiors and interiors:FindFirstChild("MainMap!Summerfest")
        local joinZone = summerfest and summerfest:FindFirstChild("CoconutBonkJoinZone")

        if joinZone then
            log("DEBUG: joinZone found. Typeof(joinZone): " .. typeof(joinZone))
            if typeof(joinZone) ~= "Instance" then
                 log("CRITICAL DEBUG: joinZone is not an Instance! Typeof: " .. typeof(joinZone) .. ". This is highly suspicious. Forcing joinZone to nil.")
                 joinZone = nil
            else
                log("DEBUG: Type of joinZone.FindFirstChild: " .. type(joinZone.FindFirstChild))
                if type(joinZone.FindFirstChild) ~= "function" then
                    log("CRITICAL DEBUG: joinZone.FindFirstChild is NOT a function! Type: " .. type(joinZone.FindFirstChild) .. ". This indicates environment tampering. Forcing joinZone to nil.")
                    joinZone = nil
                end
            end
        else
            log("DEBUG: joinZone is nil. Skipping direct FindFirstChild access.")
        end

        local success, result = pcall(function()
            return joinZone and joinZone:FindFirstChild("Ring")
        end)

        if not success then
            log("CRITICAL ERROR caught in getTeleportRingInstance for FindFirstChild('Ring'): " .. tostring(result) ..
                ". Debug Info: joinZone was: " .. tostring(joinZone) ..
                ", typeof(joinZone): " .. typeof(joinZone) ..
                ", type(joinZone.FindFirstChild): " .. (joinZone and type(joinZone.FindFirstChild) or "N/A (joinZone nil)"))
            ring = nil
        else
            ring = result
        end

        if not ring then
            log(string.format("Finding Teleport Ring (Attempt %d/%d). Path status: Interiors: %s, Summerfest: %s, JoinZone: %s, Ring: %s",
                attempts + 1, MAX_RING_ATTEMPTS,
                tostring(interiors ~= nil), tostring(summerfest ~= nil), tostring(joinZone ~= nil), tostring(ring ~= nil)))
            wait(0.5)
            attempts = attempts + 1
        end
    until ring or attempts > MAX_RING_ATTEMPTS
    return ring
end

log("--- Initial Setup Phase Started (runs once on script load) ---")

-- No longer clicking the Quest button initially.
-- The initial teleport is now handled directly by finding the Teleport Ring.

local currentCharacter = player.Character
local currentHumanoidRootPart = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

local teleportRingInitial = getTeleportRingInstance()

if teleportRingInitial and currentHumanoidRootPart then
    log("✅ Teleport Ring found for initial setup! Teleporting to join zone...")
    currentHumanoidRootPart.CFrame = teleportRingInitial.CFrame + Vector3.new(0, 5, 0)
    wait(0.5)
else
    log("❌ Failed to find Teleport Ring or HumanoidRootPart during initial setup. Manual teleport or toggle needed.")
end

log("--- Initial Setup Phase Complete ---")

-- --- MAIN SCRIPT LOOP ---
while true do
    if scriptEnabled then
        if isMinigameActive() then
            local success, err = pcall(checkScoreAndAdjustActions)
            if not success then log("Error in checkScoreAndAdjustActions: " .. tostring(err)) end

            if hasClickedStartButton then
                hasClickedStartButton = false
                log("Minigame started. Resetting 'hasClickedStartButton' flag.")
            end

            if hotbarSpamActive then
                local success, err = pcall(handleHotbarAbilities)
                if not success then log("Error in handleHotbarAbilities: " .. tostring(err)) end
                wait(0.1)
            end

            if teleportToMainBlockActive then
                local success, err = pcall(handleTeleportToMainBlock)
                if not success then log("Error in handleTeleportToMainBlock: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportToDiamondsActive then
                local success, err = pcall(handleTeleportToDiamonds)
                if not success then log("Error in handleTeleportToDiamonds: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportAroundGoldActive then
                local success, err = pcall(handleTeleportAroundGoldPile)
                if not success then log("Error in handleTeleportAroundGoldPile: " .. tostring(err)) end
                wait(0.05)
            end

            if teleportToDroppablesOccasionallyActive then
                droppableTeleportCounter = droppableTeleportCounter + 1
                if droppableTeleportCounter >= DROPPABLE_TELEPORT_CYCLE_FREQ then
                    local success, err = pcall(handleTeleportToDroppables)
                    if not success then log("Error in handleTeleportToDroppables: " .. tostring(err)) end
                    droppableTeleportCounter = 0
                end
            end

            if teleportToRaidersActive then
                local success, err = pcall(handleTeleportToModels)
                if not success then log("Error in handleTeleportToModels: " .. tostring(err)) end
                wait(0.005)
            end

        else
            local treasureDefenseExplainerApp = playerGui:FindFirstChild("TreasureDefenseExplainerApp")
            if treasureDefenseExplainerApp and treasureDefenseExplainerApp.Enabled and not hasClickedStartButton then
                local startScreen = treasureDefenseExplainerApp:FindFirstChild("StartScreen")
                if startScreen and startScreen.Visible then
                    local depthButton = startScreen:FindFirstChild("DepthButton")
                    if depthButton and depthButton.Visible and depthButton.Active then
                        log("Clicking 'DepthButton' to start the game...")
                        local success, err = pcall(clickButton, depthButton)
                        if not success then log("Error clicking DepthButton: " .. tostring(err)) end
                        hasClickedStartButton = true
                    end
                end
            end

            if not treasureDefenseExplainerApp or not treasureDefenseExplainerApp.Enabled then
                if hasClickedStartButton then
                    log("TreasureDefenseExplainerApp not active. Resetting 'hasClickedStartButton' flag.")
                end
                hasClickedStartButton = false
            end

            if not scoreIncreasingActionsAllowed then
                scoreIncreasingActionsAllowed = true
                log("Minigame inactive. Resetting score-increasing actions to ALLOWED.")
            end
            wait(2)
        end
    else
        wait(1)
    end

    wait(0.01)
end
