-- --- CONSOLE LOGGING FUNCTION ---
local function log(message)
    if consoleTextLabel then
        local timestamp = os.date("%H:%M:%S", os.time())
        local formattedMessage = "[" .. timestamp .. "] " .. tostring(message)

        local currentText = consoleTextLabel.Text
        local lines = {}
        for line in currentText:gmatch("([^\n]*)\n?") do
            if line ~= "" then
                table.insert(lines, line)
            end
        end

        table.insert(lines, formattedMessage)

        if #lines > MAX_CONSOLE_LINES then
            local startIndex = #lines - MAX_CONSOLE_LINES + 1
            local newLines = {}
            for i = startIndex, #lines do
                table.insert(newLines, lines[i])
            end
            lines = newLines
        end

        consoleTextLabel.Text = table.concat(lines, "\n")

    else
        print(message)
    end
end

-- Helper for debounced "Finding..." logs
local function logFinding(key, messageName, isFound)
    local currentTime = tick()
    if isFound then
        if lastLogTime[key] ~= "found" then
            log(messageName .. " found!")
            lastLogTime[key] = "found"
        end
    else
        if lastLogTime[key] == "found" then
            log(messageName .. " not found. Searching...")
            lastLogTime[key] = currentTime
        elseif not lastLogTime[key] or (currentTime - lastLogTime[key]) >= LOG_FINDING_COOLDOWN then
            log("Finding " .. messageName .. "...")
            lastLogTime[key] = currentTime
        end
    end
end

-- --- CORE CLICKING FUNCTION ---
local function clickButton(button)
    if button and button.Visible and button.Active then
        log("Clicking: " .. button.Name .. " using client-side events.")

        local function fireConnections(connections, eventName)
            if connections then
                for _, connection in pairs(connections) do
                    if typeof(connection) == "RBXScriptConnection" and type(connection.Fire) == "function" then
                        log("DEBUG: Attempting to fire " .. eventName .. " connection. Connection type: " .. typeof(connection) .. ", Fire method type: " .. type(connection.Fire))
                        local success, err = pcall(connection.Fire, connection)
                        if not success then
                            log("CRITICAL ERROR: Failed to fire " .. eventName .. " connection. Error: " .. tostring(err) .. " (Connection details: Typeof=" .. typeof(connection) .. ", FireType=" .. type(connection and connection.Fire) .. ")")
                        end
                    else
                        log("Warning: Invalid " .. eventName .. " connection found. Type: " .. typeof(connection) .. ", Expected RBXScriptConnection. (Fire type: " .. type(connection and connection.Fire) .. ")")
                    end
                end
            end
        end

        local connectionsDown = nil
        local successDown, resultDown = pcall(getconnections, button.MouseButton1Down)
        if successDown and type(resultDown) == "table" then
            connectionsDown = resultDown
        else
            log("Error or unexpected return from getconnections for MouseButton1Down on " .. button.Name .. ": " .. tostring(resultDown) .. " (Type: " .. type(resultDown) .. ")")
        end
        fireConnections(connectionsDown, "MouseButton1Down")
        wait(0.05)

        local connectionsClick = nil
        local successClick, resultClick = pcall(getconnections, button.MouseButton1Click)
        if successClick and type(resultClick) == "table" then
            connectionsClick = resultClick
        else
            log("Error or unexpected return from getconnections for MouseButton1Click on " .. button.Name .. ": " .. tostring(resultClick) .. " (Type: " .. type(resultClick) .. ")")
        end
        fireConnections(connectionsClick, "MouseButton1Click")
        wait(0.05)

        local connectionsUp = nil
        local successUp, resultUp = pcall(getconnections, button.MouseButton1Up)
        if successUp and type(resultUp) == "table" then
            connectionsUp = resultUp
        else
            log("Error or unexpected return from getconnections for MouseButton1Up on " .. button.Name .. ": " .. tostring(resultUp) .. " (Type: " .. type(resultUp) .. ")")
        end
        fireConnections(connectionsUp, "MouseButton1Up")
    else
        log("Cannot click button: " .. (button and button.Name or "nil") .. " (Visible: " .. tostring(button and button.Visible) .. ", Active: " .. tostring(button and button.Active) .. ")")
    end
end

